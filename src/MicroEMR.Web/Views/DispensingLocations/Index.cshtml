@model MicroEMR.Web.Controllers.DispensingLocationIndex
@{ViewData["Title"]="Dispensing locations";ViewData["Subtitle"]="Tenant-local directory maintenance";Layout="_AppLayout";}
<div class="content-panel">
 <h1 class="h3">Dispensing locations</h1>
 <p>Locally curated records. Identity is immutable and remains reserved after deactivation. Deactivate an incorrect identity and create the correct one; historical references remain unchanged. No external authority validation is implied.</p>
 @if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
 <a asp-action="Add" class="btn btn-primary mb-3">Add location</a>
 <form method="get" class="row g-2 mb-3"><div class="col-12 col-md-7"><label class="form-label w-100">Name, identifier or address<input name="query" value="@Model.Query" maxlength="200" class="form-control" /></label></div><div class="col-12 col-md-3"><label class="form-check-label"><input name="includeInactive" type="checkbox" value="true" checked="@Model.IncludeInactive" class="form-check-input" /> Include inactive</label></div><div class="col-12 col-md-2"><button class="btn btn-outline-primary">Search</button></div></form>
 <div class="table-responsive"><table class="table"><thead><tr><th>Identity</th><th>Facility details</th><th>Status</th><th>Maintenance</th></tr></thead><tbody>
 @foreach(var x in Model.Results.Items){<tr><td class="text-break">@x.System<br />@x.Identifier</td><td class="text-break">@x.FacilityName<div style="white-space:pre-wrap">@x.FacilityAddress</div>@x.Phone</td><td>@(x.IsActive?"Active":"Inactive")</td><td><a asp-action="Edit" asp-route-uid="@x.LocationUid">View / edit details</a><form asp-action="@(x.IsActive?"Deactivate":"Reactivate")" method="post"><input type="hidden" name="uid" value="@x.LocationUid" /><input type="hidden" name="rowVersion" value="@x.RowVersion" /><button class="btn btn-sm btn-outline-secondary">@(x.IsActive?"Deactivate":"Reactivate")</button></form></td></tr>}
 </tbody></table></div>
 @if(Model.Results.Items.Count==0){<p>No matching locations.</p>}
 @if(Model.Results.Page>1){<a asp-route-page="@(Model.Results.Page-1)" asp-route-query="@Model.Query" asp-route-includeInactive="@Model.IncludeInactive" class="btn btn-outline-secondary">Previous</a>}
 @if(Model.Results.HasMore){<a asp-route-page="@(Model.Results.Page+1)" asp-route-query="@Model.Query" asp-route-includeInactive="@Model.IncludeInactive" class="btn btn-outline-secondary">Next</a>}
</div>
