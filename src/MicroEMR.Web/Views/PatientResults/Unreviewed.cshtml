@model IReadOnlyList<MicroEMR.Web.Models.PatientResults.UnreviewedPatientResultViewModel>
@{
    ViewData["Title"] = "Unreviewed Results";
    ViewData["Subtitle"] = "Clinic-wide results awaiting acknowledgement";
    Layout = "_AppLayout";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div><h2 class="mb-1">Unreviewed Results</h2><p class="text-body-secondary mb-0">Current tenant · clinic-wide · oldest results first</p></div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-success" role="status">There are no unreviewed results for active patients.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Patient</th><th>Result</th><th>Date</th><th>Value / summary</th><th>Status</th><th><span class="visually-hidden">Action</span></th></tr></thead>
                <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td><div class="fw-semibold">@result.PatientDisplayName</div><div class="small text-body-secondary">Chart @result.ChartNumber</div></td>
                        <td><div class="fw-semibold">@result.ResultName</div><div class="small text-body-secondary">@result.ResultType</div></td>
                        <td>@result.ResultDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@if (!string.IsNullOrWhiteSpace(result.ResultValue)) { <span>@result.ResultValue @result.ResultUnit</span> } else { <span>@result.ResultSummary</span> }</td>
                        <td><span class="badge text-bg-info">Not reviewed</span></td>
                        <td class="text-end"><a asp-controller="Patients" asp-action="Details" asp-route-patientUid="@result.PatientUid" asp-route-tab="results" class="btn btn-sm btn-outline-primary">Open result</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
