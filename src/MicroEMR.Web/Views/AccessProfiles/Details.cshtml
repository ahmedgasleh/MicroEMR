@model MicroEMR.Web.Controllers.AccessProfileDetailsViewModel
@{ViewData["Title"]=Model.Profile.Name;ViewData["Subtitle"]="Access profile permissions.";Layout="_AppLayout";}
<div class="content-panel"><a asp-action="Index" class="small text-decoration-none">&larr; Access Profiles</a><div class="d-flex justify-content-between mt-2"><div><h1 class="h3">@Model.Profile.Name</h1><p class="text-muted">@Model.Profile.Description</p></div><span class="badge @(Model.Profile.IsActive?"text-bg-success":"text-bg-secondary") align-self-start">@(Model.Profile.IsActive?"Active":"Inactive")</span></div>
@if(TempData["SuccessMessage"] is string s){<div class="alert alert-success">@s</div>}@if(TempData["ErrorMessage"] is string e){<div class="alert alert-danger">@e</div>}
<form asp-action="UpdatePermissions" method="post"><input type="hidden" name="uid" value="@Model.Profile.AccessProfileUid"/><input type="hidden" name="rowVersion" value="@Model.Profile.RowVersion"/>
@foreach(var group in Model.Catalog.GroupBy(x=>x.Group)){<fieldset class="border rounded p-3 mb-3"><legend class="float-none w-auto px-2 fs-5">@group.Key</legend>@foreach(var permission in group){<div class="form-check mb-2">@if(Model.Profile.PermissionKeys.Contains(permission.Key)){<input class="form-check-input" type="checkbox" name="permissionKeys" value="@permission.Key" id="p-@permission.Key.Replace('.','-')" checked/>}else{<input class="form-check-input" type="checkbox" name="permissionKeys" value="@permission.Key" id="p-@permission.Key.Replace('.','-')"/>}<label class="form-check-label" for="p-@permission.Key.Replace('.','-')"><span class="fw-semibold">@permission.DisplayName</span><span class="d-block small text-muted">@permission.Description</span></label></div>}</fieldset>}
<button class="btn btn-primary" type="submit">Save permissions</button></form></div>
