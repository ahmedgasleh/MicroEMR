@model IReadOnlyList<MicroEMR.Application.AccessProfiles.AccessProfileSummary>
@{ViewData["Title"]="Access Profiles";ViewData["Subtitle"]="Tenant-specific permission profiles.";Layout="_AppLayout";}
<div class="content-panel"><div class="content-panel-header"><div><a asp-controller="TenantUserAdministration" asp-action="Index" class="small text-decoration-none">&larr; User Administration</a><h1 class="h3 mt-2">Access Profiles</h1></div></div>
<div class="table-responsive mt-3"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Description</th><th>Status</th><th>Permissions</th><th>Assigned users</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td class="fw-semibold">@p.Name</td><td>@p.Description</td><td><span class="badge @(p.IsActive?"text-bg-success":"text-bg-secondary")">@(p.IsActive?"Active":"Inactive")</span></td><td>@p.PermissionCount</td><td>@p.AssignedUserCount</td><td class="text-end"><a asp-action="Details" asp-route-uid="@p.AccessProfileUid" class="btn btn-sm btn-outline-primary">View permissions</a></td></tr>}</tbody></table></div></div>
