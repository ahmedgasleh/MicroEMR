@model MicroEMR.Web.Models.TenantUserAdministration.TenantUserAdministrationViewModel

@{
    ViewData["Title"] = "User Administration";
    ViewData["Subtitle"] = "View users assigned to the active clinic.";
    Layout = "_AppLayout";
    var activeAdministrators = Model.Users.Where(x => x.MembershipStatus == "Active" &&
        x.TenantRoles.Contains("ClinicAdministrator", StringComparer.Ordinal)).ToArray();
    var lastActiveAdministratorId = activeAdministrators.Length == 1 ? activeAdministrators[0].AuthUserId : null;
}

<div class="content-panel">
    <form id="membershipAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>
    <div id="membershipActionMessage" class="alert d-none mt-3" role="status" aria-live="polite"></div>
    <div class="content-panel-header">
        <div>
            <h1 class="h3 mb-1">User Administration</h1>
            <p class="text-muted mb-0">Tenant membership, roles, and clinical-user provisioning status.</p>
        </div>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="alert alert-info mt-4" role="status">No users are assigned to this clinic.</div>
    }
    else
    {
        <div class="table-responsive mt-4">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Users assigned to the active clinic</caption>
                <thead>
                    <tr>
                        <th scope="col">Name / Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Membership</th>
                        <th scope="col">Tenant Roles</th>
                        <th scope="col">Clinical User</th>
                        <th scope="col">Clinical User ID</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td data-tenant-roles>
                                <div class="fw-semibold">@user.DisplayName</div>
                                <div class="small text-muted">@user.UserName</div>
                                @if (!user.AuthUserActive)
                                {
                                    <span class="badge text-bg-warning mt-1">Auth account inactive</span>
                                }
                            </td>
                            <td>@(user.Email ?? "—")</td>
                            <td><span class="badge text-bg-light border" data-membership-status>@user.MembershipStatus</span></td>
                            <td>
                                @if (user.TenantRoles.Count == 0)
                                {
                                    <span class="text-muted">No roles</span>
                                }
                                else
                                {
                                    @foreach (var role in user.TenantRoles)
                                    {
                                        <span class="badge text-bg-secondary me-1">@role</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (user.ClinicalUserProvisioned)
                                {
                                    <span class="badge text-bg-success">Provisioned</span>
                                    @if (user.ClinicalUserActive == false)
                                    {
                                        <span class="badge text-bg-warning ms-1">Inactive</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">Not provisioned</span>
                                }
                            </td>
                            <td>@(user.ClinicalUserId?.ToString() ?? "—")</td>
                            <td class="text-end">
                                @if (user.MembershipStatus == "Active")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                            data-edit-roles data-auth-user-id="@user.AuthUserId"
                                            data-display-name="@user.DisplayName" data-membership-status="@user.MembershipStatus"
                                            data-roles="@string.Join("|", user.TenantRoles)" data-row-version="@user.RowVersion"
                                            data-current-user="@user.IsCurrentUser.ToString().ToLowerInvariant()"
                                            data-last-active-admin="@(user.AuthUserId == lastActiveAdministratorId ? "true" : "false")">Edit Roles</button>
                                }
                                @if (user.IsCurrentUser)
                                {
                                    <span class="small text-muted">Current user</span>
                                }
                                else if (user.MembershipStatus == "Active")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-membership-action="deactivate" data-auth-user-id="@user.AuthUserId"
                                            data-row-version="@user.RowVersion">Deactivate</button>
                                }
                                else if (user.MembershipStatus == "Inactive")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-membership-action="activate" data-auth-user-id="@user.AuthUserId"
                                            data-row-version="@user.RowVersion">Activate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="roleEditorModal" tabindex="-1" aria-labelledby="roleEditorModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="roleEditorModalLabel">Edit Tenant Roles</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div id="roleEditorMessage" class="alert alert-danger d-none" role="alert"></div>
            <div class="mb-3"><div class="fw-semibold" id="roleEditorUser"></div>
                <div class="small text-muted">Membership: <span id="roleEditorStatus"></span></div></div>
            <input type="hidden" id="roleEditorAuthUserId" /><input type="hidden" id="roleEditorRowVersion" />
            @foreach (var role in Model.CanonicalRoles)
            {
                <div class="form-check"><input class="form-check-input" type="checkbox" name="tenantRole" value="@role" id="role-@role" />
                    <label class="form-check-label" for="role-@role">@role</label></div>
            }
            <p id="selfRoleSafety" class="small text-muted mt-3 d-none">You cannot remove your own clinic administrator role.</p>
            <p id="lastAdminRoleSafety" class="small text-muted mt-3 d-none">The last active clinic administrator cannot lose that role.</p>
            <p class="small text-muted mt-3 mb-0">Updated permissions apply on the user's next API request.</p>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="saveTenantRoles">Save</button></div>
    </div></div>
</div>

@section Scripts {
    <script type="module" src="~/dist/user-administration/membership-status.js" asp-append-version="true"></script>
}
