@model MicroEMR.Web.Models.TenantUserAdministration.TenantUserAdministrationViewModel

@using MicroEMR.Application.AccessProfiles
@using MicroEMR.Web.Authorization
@inject IWebPermissionService Permissions
@{
    ViewData["Title"] = "User Administration";
    ViewData["Subtitle"] = "View users assigned to the active clinic.";
    Layout = "_AppLayout";
    var activeAdministrators = Model.Users.Where(x => x.MembershipStatus == "Active" &&
        x.TenantRoles.Contains(MicroEMR.Application.PlatformAdministration.TenantRoleCatalog.ClinicAdministrator,
            StringComparer.Ordinal)).ToArray();
    var lastActiveAdministratorId = activeAdministrators.Length == 1 ? activeAdministrators[0].AuthUserId : null;
    var effectivePermissions = await Permissions.GetAsync(Context.RequestAborted);
    var canManageUsers = effectivePermissions.Contains(PermissionKeys.UsersManage);
    var canManageAccess = effectivePermissions.Contains(PermissionKeys.UsersManageAccess);
}

<div class="content-panel">
    <form id="membershipAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>
    <div id="membershipActionMessage" class="alert d-none mt-3" role="status" aria-live="polite"></div>
    <div class="content-panel-header">
        <div>
            <h1 class="h3 mb-1">User Administration</h1>
            <p class="text-muted mb-0">Tenant membership, roles, and clinical-user provisioning status.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal"
                disabled="@(!canManageUsers)" aria-disabled="@(!canManageUsers)"
                title="@(canManageUsers ? null : "Read-only access")">Add User</button>
    </div>
    @if (canManageAccess) { <div class="mt-3"><a asp-controller="AccessProfiles" asp-action="Index" class="btn btn-outline-primary">Access Profiles</a></div> }

    @if (Model.Users.Count == 0)
    {
        <div class="alert alert-info mt-4" role="status">No users are assigned to this clinic.</div>
    }
    else
    {
        <div class="table-responsive mt-4">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Users assigned to the active clinic</caption>
                <thead>
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Email</th>
                        <th scope="col">Status</th>
                        <th scope="col">Roles</th>
                        <th scope="col">Clinical User</th>
                        <th scope="col">Clinical User ID</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr data-user-row data-auth-user-id="@user.AuthUserId">
                            <td>
                                <div class="fw-semibold">@user.DisplayName</div>
                                <div class="small text-muted">@user.UserName</div>
                                @if (!user.AuthUserActive)
                                {
                                    <span class="badge text-bg-warning mt-1">Auth account inactive</span>
                                }
                            </td>
                            <td>@(user.Email ?? "—")</td>
                            <td><span class="badge text-bg-light border" data-membership-status>@user.MembershipStatus</span></td>
                            <td data-tenant-roles>
                                @if (user.TenantRoles.Count == 0)
                                {
                                    <span class="text-muted">No role assigned</span>
                                }
                                else
                                {
                                    @foreach (var role in user.TenantRoles)
                                    {
                                        <span class="badge text-bg-secondary me-1">@role</span>
                                    }
                                }
                            </td>
                            <td data-clinical-user-status>
                                @if (user.ClinicalUserProvisioned)
                                {
                                    <span class="badge text-bg-success">Provisioned</span>
                                    @if (user.ClinicalUserActive == false)
                                    {
                                        <span class="badge text-bg-warning ms-1">Inactive</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">Not provisioned</span>
                                }
                            </td>
                            <td data-clinical-user-id>@(user.ClinicalUserId?.ToString() ?? "—")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary me-1" asp-action="Details"
                                   asp-route-authUserId="@user.AuthUserId">View details</a>
                                @if (!user.ClinicalUserProvisioned && user.MembershipStatus == "Active")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success me-1"
                                            data-provision-clinical-user data-auth-user-id="@user.AuthUserId"
                                            disabled="@(!canManageUsers)" aria-disabled="@(!canManageUsers)"
                                            title="@(canManageUsers ? null : "Read-only access")">
                                        Provision Clinical User
                                    </button>
                                }
                                else if (!user.ClinicalUserProvisioned)
                                {
                                    <span class="small text-muted me-2">Activate the membership before provisioning.</span>
                                }
                                @if (canManageAccess && user.MembershipStatus == "Active")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                            data-edit-roles data-auth-user-id="@user.AuthUserId"
                                            data-display-name="@user.DisplayName" data-membership-status="@user.MembershipStatus"
                                            data-roles="@string.Join("|", user.TenantRoles)" data-row-version="@user.RowVersion"
                                            data-current-user="@user.IsCurrentUser.ToString().ToLowerInvariant()"
                                            data-last-active-admin="@(user.AuthUserId == lastActiveAdministratorId ? "true" : "false")">Edit Roles</button>
                                }
                                @if (user.IsCurrentUser)
                                {
                                    <span class="small text-muted">Current user</span>
                                }
                                else if (user.MembershipStatus == "Active" && user.AuthUserId == lastActiveAdministratorId)
                                {
                                    <span class="small text-muted">Last active administrator</span>
                                }
                                else if (user.MembershipStatus == "Active")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-membership-action="deactivate" data-auth-user-id="@user.AuthUserId"
                                            data-row-version="@user.RowVersion" disabled="@(!canManageUsers)"
                                            aria-disabled="@(!canManageUsers)" title="@(canManageUsers ? null : "Read-only access")">Deactivate</button>
                                }
                                else if (user.MembershipStatus == "Inactive")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-membership-action="activate" data-auth-user-id="@user.AuthUserId"
                                            data-row-version="@user.RowVersion" disabled="@(!canManageUsers)"
                                            aria-disabled="@(!canManageUsers)" title="@(canManageUsers ? null : "Read-only access")">Activate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <form asp-action="AddFromModal" method="post" id="addTenantUserForm" data-modal-submit="true">
            <div class="modal-header">
                <div><h2 class="modal-title fs-5" id="addUserModalLabel">Add User</h2>
                    <div class="small text-muted">Add an identity to the active clinic.</div></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="addTenantUserMessage" class="alert alert-danger d-none" role="alert" aria-live="polite"></div>
                <p class="small text-muted">Existing MicroEMR identities are reused automatically. Access to other clinics is not displayed or changed.</p>
                <div class="row g-3">
                    <div class="col-md-6"><label for="addFirstName" class="form-label">First Name</label><input id="addFirstName" name="FirstName" class="form-control" maxlength="100" autocomplete="given-name" required /></div>
                    <div class="col-md-6"><label for="addLastName" class="form-label">Last Name</label><input id="addLastName" name="LastName" class="form-control" maxlength="100" autocomplete="family-name" required /></div>
                    <div class="col-12"><label for="addEmail" class="form-label">Email</label><input id="addEmail" name="Email" type="email" class="form-control" maxlength="256" autocomplete="email" required /></div>
                    <div class="col-md-6"><label for="addTemporaryPassword" class="form-label">Temporary Password</label><input id="addTemporaryPassword" name="TemporaryPassword" type="password" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" /></div>
                    <div class="col-md-6"><label for="addConfirmTemporaryPassword" class="form-label">Confirm Temporary Password</label><input id="addConfirmTemporaryPassword" name="ConfirmTemporaryPassword" type="password" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" /></div>
                    <div class="col-12 form-text">Required for a new identity. Share it securely; the user should change it immediately after signing in.</div>
                    <div class="col-md-6"><label for="addInitialRole" class="form-label">Initial Role</label><select id="addInitialRole" name="InitialRole" class="form-select" required>
                        @foreach (var role in Model.CanonicalRoles)
                        {
                            if (role == "Physician") { <option value="@role" selected>@role</option> }
                            else { <option value="@role">@role</option> }
                        }
                    </select></div>
                    <div class="col-12"><div class="form-check"><input id="addProvisionClinical" name="ProvisionClinicalUser" value="true" type="checkbox" class="form-check-input" checked />
                        <label for="addProvisionClinical" class="form-check-label">Provision clinical user</label></div>
                        <div class="form-text">Recommended for clinical and audit write operations.</div></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="addTenantUserButton">Add User</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="roleEditorModal" tabindex="-1" aria-labelledby="roleEditorModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="roleEditorModalLabel">Edit Tenant Roles</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <div id="roleEditorMessage" class="alert alert-danger d-none" role="alert"></div>
            <div class="mb-3"><div class="fw-semibold" id="roleEditorUser"></div>
                <div class="small text-muted">Membership: <span id="roleEditorStatus"></span></div></div>
            <input type="hidden" id="roleEditorAuthUserId" /><input type="hidden" id="roleEditorRowVersion" />
            @foreach (var role in Model.CanonicalRoles)
            {
                <div class="form-check"><input class="form-check-input" type="checkbox" name="tenantRole" value="@role" id="role-@role" />
                    <label class="form-check-label" for="role-@role">@role</label></div>
            }
            <p id="selfRoleSafety" class="small text-muted mt-3 d-none">You cannot remove your own clinic administrator role.</p>
            <p id="lastAdminRoleSafety" class="small text-muted mt-3 d-none">The last active clinic administrator cannot lose that role.</p>
            <p class="small text-muted mt-3 mb-0">Updated permissions apply on the user's next API request.</p>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="saveTenantRoles">Save</button></div>
    </div></div>
</div>

@section Scripts {
    <script type="module" src="~/dist/user-administration/membership-status.js" asp-append-version="true"></script>
    <script type="module" src="~/dist/user-administration/add-user.js" asp-append-version="true"></script>
}
