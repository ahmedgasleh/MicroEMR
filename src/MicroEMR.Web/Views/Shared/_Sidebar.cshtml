@using MicroEMR.Web.Authorization
@using MicroEMR.Application.AccessProfiles
@inject IWebPermissionService PermissionService
@inject IWebPlatformEntitlementAccessor PlatformEntitlements
@{
    var effectivePermissions = User.Identity?.IsAuthenticated == true
        ? await PermissionService.GetAsync(Context.RequestAborted)
        : new HashSet<string>(StringComparer.Ordinal);
    bool Can(string key) => effectivePermissions.Contains(key);
    var canReviewSecurityAudit = User.Identity?.IsAuthenticated == true &&
        await PlatformEntitlements.HasAsync(
            MicroEMR.Application.PlatformEntitlements.PlatformEntitlementKeys.SecurityAuditView,
            Context.RequestAborted);
}

<aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-brand">
        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-brand-link">

            <span class="sidebar-logo">
                <i class="bi bi-heart-pulse-fill"></i>
            </span>

            <span class="sidebar-brand-text">Micro EMR</span>
        </a>
    </div>

    <nav class="sidebar-navigation"
         aria-label="Application navigation">

        <ul class="sidebar-menu">

            <!-- Dashboard: every authenticated user -->
            <li class="sidebar-menu-item">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-link"
                   data-bs-toggle="tooltip"
                   data-bs-placement="right"
                   data-bs-title="Dashboard">

                    <span class="sidebar-icon">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </span>

                    <span class="sidebar-text">Dashboard</span>
                </a>
            </li>

            @if (Can(PermissionKeys.SchedulingView))
            {
                <li class="sidebar-menu-item">
                    <a asp-controller="Scheduling"
                       asp-action="Index"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="Scheduling">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar3"></i>
                        </span>

                        <span class="sidebar-text">Scheduling</span>
                    </a>
                </li>
            }

            @if (Can(PermissionKeys.PatientsView))
            {
                <li class="sidebar-menu-item">
                    <a asp-controller="PatientChart" asp-action="Index" class="sidebar-link"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Chart">
                        <span class="sidebar-icon"><i class="bi bi-folder2-open"></i></span>
                        <span class="sidebar-text">Chart</span>
                    </a>
                </li>
            }

            @if (Can(PermissionKeys.PatientsView))
            {
                <li class="sidebar-menu-item">
                    <a asp-controller="Patients"
                       asp-action="Index"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="Patients">

                        <span class="sidebar-icon">
                            <i class="bi bi-people-fill"></i>
                        </span>

                        <span class="sidebar-text">Patients</span>
                    </a>
                </li>
            }

            @if (Can(PermissionKeys.TemplatesManage))
            {
                <li class="sidebar-menu-item">
                    <a asp-controller="TemplateAdministration"
                       asp-action="Index"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="Templates">
                        <span class="sidebar-icon"><i class="bi bi-ui-checks-grid"></i></span>
                        <span class="sidebar-text">Templates</span>
                    </a>
                </li>
            }

            @if (User.IsInRole(AppRoles.Administrator))
            {
                <li class="sidebar-section">
                    <span class="sidebar-section-text">Administration</span>
                </li>

                <li class="sidebar-menu-item">
                    <a asp-controller="Administration"
                       asp-action="Users"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="User Management">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-gear"></i>
                        </span>

                        <span class="sidebar-text">User Management</span>
                    </a>
                </li>

                <li class="sidebar-menu-item">
                    <a asp-controller="Administration"
                       asp-action="Resources"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="Clinic Resources">

                        <span class="sidebar-icon">
                            <i class="bi bi-building-gear"></i>
                        </span>

                        <span class="sidebar-text">Clinic Resources</span>
                    </a>
                </li>

                <li class="sidebar-menu-item">
                    <a asp-controller="Administration"
                       asp-action="Settings"
                       class="sidebar-link"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       data-bs-title="Settings">

                        <span class="sidebar-icon">
                            <i class="bi bi-gear-fill"></i>
                        </span>

                        <span class="sidebar-text">Settings</span>
                    </a>
                </li>
            }

            @if (Can(PermissionKeys.UsersView) || Can(PermissionKeys.ClinicSettingsManage) || Can(PermissionKeys.ReportsView))
            {
                <li class="sidebar-section">
                    <span class="sidebar-section-text">Clinic Administration</span>
                </li>
                @if (Can(PermissionKeys.UsersView))
                {
                <li class="sidebar-menu-item">
                    <a asp-controller="TenantUserAdministration" asp-action="Index" class="sidebar-link"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="User Administration">
                        <span class="sidebar-icon"><i class="bi bi-person-lines-fill"></i></span>
                        <span class="sidebar-text">User Administration</span>
                    </a>
                </li>
                }
                @if (Can(PermissionKeys.ClinicSettingsManage))
                {
                <li class="sidebar-menu-item">
                    <a asp-controller="ClinicConfiguration" asp-action="Index" class="sidebar-link"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Clinic Settings">
                        <span class="sidebar-icon"><i class="bi bi-sliders"></i></span>
                        <span class="sidebar-text">Clinic Settings</span>
                    </a>
                </li>
                }
                @if (Can(PermissionKeys.ReportsView))
                {
                <li class="sidebar-menu-item">
                    <a asp-controller="Reports" asp-action="AppointmentStatus" class="sidebar-link"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Reports">
                        <span class="sidebar-icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
                        <span class="sidebar-text">Reports</span>
                    </a>
                </li>
                }
            }

            @if (canReviewSecurityAudit)
            {
                <li class="sidebar-section">
                    <span class="sidebar-section-text">Platform Administration</span>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="PlatformSecurityAudit" asp-action="Index" class="sidebar-link"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Security Audit">
                        <span class="sidebar-icon"><i class="bi bi-shield-lock"></i></span>
                        <span class="sidebar-text">Security Audit</span>
                    </a>
                </li>
            }

        </ul>
    </nav>

    <div class="sidebar-footer">
        <button type="button"
                class="sidebar-collapse-button"
                id="sidebarCollapseButton"
                title="Collapse sidebar"
                aria-label="Collapse sidebar">

            <i class="bi bi-chevron-left"
               id="sidebarCollapseIcon"></i>

            <span class="sidebar-text">Collapse</span>
        </button>
    </div>
</aside>
