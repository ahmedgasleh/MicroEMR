@model MicroEMR.Web.Models.PatientEncounters.EncounterHistoryPrintViewModel
@{
    ViewData["Title"] = "Encounter History";
    Layout = "_AppLayout";
}

<div class="container-fluid py-3">
    <div class="d-print-none d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1" aria-hidden="true"></i>Print</button>
    </div>
    <header class="border-bottom pb-3 mb-3">
        <h1 class="h3 mb-2">Encounter History</h1>
        <div class="row g-2">
            <div class="col-sm-6"><strong>Patient:</strong> @Model.Patient.FullName</div>
            <div class="col-sm-6"><strong>Chart number:</strong> @Model.Patient.ChartNumber</div>
            <div class="col-sm-6"><strong>Date of birth:</strong> @Model.Patient.DateOfBirth.ToString("yyyy-MM-dd")</div>
            <div class="col-sm-6"><strong>Date range:</strong> @Model.StartDate.ToString("yyyy-MM-dd") to @Model.EndDate.ToString("yyyy-MM-dd")</div>
        </div>
    </header>

    @if (Model.Encounters.Count == 0)
    {
        <p>No encounters were recorded in the selected date range.</p>
    }
    else
    {
        <table class="table table-sm table-bordered align-middle">
            <thead><tr><th>Date/time</th><th>Type</th><th>Reason</th><th>Provider</th><th>Location</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var encounter in Model.Encounters)
            {
                <tr>
                    <td>@encounter.EncounterDateUtc.ToLocalTime().ToString("yyyy-MM-dd h:mm tt")</td>
                    <td>@encounter.EncounterType</td>
                    <td>@(encounter.ReasonForVisit ?? "—")</td>
                    <td>@(encounter.ProviderName ?? "—")</td>
                    <td>@(encounter.LocationName ?? "—")</td>
                    <td>@encounter.Status</td>
                </tr>
            }
            </tbody>
        </table>
    }
    <footer class="small text-muted border-top pt-2 mt-4">Generated @Model.GeneratedAtUtc.ToLocalTime().ToString("yyyy-MM-dd h:mm tt")</footer>
</div>

<style>
@@media print {
    .app-sidebar, .app-topbar, .app-footer, .d-print-none { display: none !important; }
    .app-wrapper { height: auto !important; margin-left: 0 !important; overflow: visible !important; }
    .app-main { padding: 0 !important; overflow: visible !important; }
    body { background: #fff; font-size: 10pt; }
    .container-fluid { max-width: none; padding: 0 !important; }
    tr { break-inside: avoid; }
}
</style>
