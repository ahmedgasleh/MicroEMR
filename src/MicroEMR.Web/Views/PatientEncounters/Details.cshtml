@model MicroEMR.Web.Models.PatientEncounters.PatientEncounterDetailsResponse

@{
    ViewData["Title"] = "Encounter";
    ViewData["Subtitle"] = Model.EncounterType;
    Layout = "_AppLayout";
}

<div class="content-panel">
    <div class="content-panel-header">
        <div>
            <h3>Encounter</h3>

            <p>
                @Model.EncounterType
            </p>
        </div>

        <a asp-controller="Patients"
           asp-action="Details"
           asp-route-patientUid="@Model.PatientUid"
           asp-route-tab="encounters"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Patient Chart
        </a>
    </div>

    <div class="row g-4 mt-1">
        @if (Model.AppointmentUid.HasValue)
        {
            <div class="col-12">
                <div class="border rounded-3 p-3 bg-body-tertiary">
                    <h5 class="mb-3">Appointment</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Date/time</dt>
                        <dd class="col-sm-9">
                            @Model.AppointmentStartDateTime?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            @if (Model.AppointmentEndDateTime.HasValue)
                            {
                                <text> - @Model.AppointmentEndDateTime.Value.ToLocalTime().ToString("h:mm tt")</text>
                            }
                        </dd>
                        <dt class="col-sm-3">Provider/resource</dt>
                        <dd class="col-sm-9">@(Model.AppointmentProviderDisplayName ?? "Not assigned")</dd>
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.AppointmentStatus</span></dd>
                        @if (!string.IsNullOrWhiteSpace(Model.AppointmentReason))
                        {
                            <dt class="col-sm-3">Reason</dt>
                            <dd class="col-sm-9">@Model.AppointmentReason</dd>
                        }
                    </dl>
                </div>
            </div>
        }
        <div class="col-12 col-lg-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-3">Encounter</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-5">Date/time</dt>
                    <dd class="col-sm-7">
                        @Model.EncounterDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    </dd>

                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@Model.EncounterType</dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        @if (string.Equals(
                            Model.Status,
                            "Open",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-primary">
                                Draft
                            </span>
                        }
                        else if (string.Equals(
                            Model.Status,
                            "Closed",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-secondary">
                                Closed
                            </span>
                        }
                        else if (string.Equals(
                            Model.Status,
                            "Cancelled",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-danger">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                @Model.Status
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-5">Provider</dt>
                    <dd class="col-sm-7">
                        @(Model.ProviderName ?? "—")
                    </dd>

                    <dt class="col-sm-5">Location</dt>
                    <dd class="col-sm-7">
                        @(Model.LocationName ?? "—")
                    </dd>
                </dl>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-3">Audit</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-5">Created by</dt>
                    <dd class="col-sm-7">
                        @(Model.CreatedByDisplayName ?? "Unknown")
                    </dd>

                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">
                        @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    </dd>

                    <dt class="col-sm-5">Last updated</dt>
                    <dd class="col-sm-7">@(Model.UpdatedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "—")</dd>

                    @if (Model.SignedAt.HasValue)
                    {
                        <dt class="col-sm-5">Signed by</dt>
                        <dd class="col-sm-7">@(Model.SignedByDisplayName ?? "Unknown")</dd>
                        <dt class="col-sm-5">Signed</dt>
                        <dd class="col-sm-7">@Model.SignedAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>
                    }

                    @if (Model.HasAmendments)
                    {
                        <dt class="col-sm-5">Amendments</dt>
                        <dd class="col-sm-7"><span class="badge text-bg-warning">Amended</span></dd>
                    }
                </dl>
            </div>
        </div>
        <div class="col-12">
            <div class="border rounded-3 p-3">
                <h5 class="mb-3">Clinical Note</h5>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="text-break" style="white-space: pre-wrap">@Model.Notes</p>
                }
                <dl class="row mb-0">
                    <dt class="col-sm-3">Subjective</dt><dd class="col-sm-9 text-break">@(Model.SubjectiveNote ?? "—")</dd>
                    <dt class="col-sm-3">Objective</dt><dd class="col-sm-9 text-break">@(Model.ObjectiveNote ?? "—")</dd>
                    <dt class="col-sm-3">Assessment</dt><dd class="col-sm-9 text-break">@(Model.AssessmentNote ?? "—")</dd>
                    <dt class="col-sm-3">Plan</dt><dd class="col-sm-9 text-break">@(Model.PlanNote ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="col-12">
            <div class="border rounded-3 p-3">
                <h5 class="mb-3">Reason for Visit</h5>

                <p class="mb-0">
                    @(Model.ReasonForVisit ?? "—")
                </p>
            </div>
        </div>
    </div>
</div>
