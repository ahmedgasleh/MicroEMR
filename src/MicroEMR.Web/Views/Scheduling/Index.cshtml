@model MicroEMR.Web.Models.Scheduling.SchedulingIndexViewModel
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Scheduling";
    ViewData["Subtitle"] = "Resource schedule";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    jsonOptions.Converters.Add(new JsonStringEnumConverter());

    var resourcesJson =
        JsonSerializer.Serialize(Model.Resources, jsonOptions);

    var initialDateJson =
        JsonSerializer.Serialize(Model.InitialDate, jsonOptions);

    var openAddAppointmentJson =
        JsonSerializer.Serialize(Model.OpenAddAppointment, jsonOptions);
}

@section Styles {
    <style>
        .scheduling-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            flex-wrap: wrap;
            margin-bottom: .75rem;
        }

        .scheduling-view-bar h2 {
            margin: 0;
        }

        .scheduling-view-bar .small {
            margin: 0;
        }



        .scheduling-view-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            flex-wrap: wrap;
            margin-bottom: .5rem;
        }

        .scheduling-toolbar-actions {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex-wrap: wrap;
        }

        .scheduling-date-label {
            min-width: 12rem;
            font-weight: 600;
            text-align: center;
        }

        .scheduling-filter {
            display: flex;
            align-items: center;
            gap: .5rem;
            width: auto;
        }

        .scheduling-filter .form-label {
            margin: 0;
            white-space: nowrap;
        }

        .scheduling-calendar-shell {
            height: 840px;
            max-height: calc(100vh - var(--topbar-height) - 52px - 52px - 180px);

            border: 1px solid var(--bs-border-color);
            background: var(--bs-body-bg);
            overflow: hidden;
        }

        .scheduling-filter .form-select {
            width: 18rem;
        }

        .scheduling-filter-panel {
            display: flex;
            align-items: end;
            justify-content: flex-end;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .scheduling-filter-field { min-width: 10rem; }
        .scheduling-filter-field .form-select { width: auto; min-width: 10rem; }
        .scheduling-filter-summary {
            color: var(--bs-secondary-color);
            font-size: .875rem;
            padding-bottom: .4rem;
        }

        .resource-picker-list { max-height: 14rem; overflow-y: auto; }
        .resource-picker-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

        .patient-search-container { position: relative; }

        .patient-search-dropdown {
            position: absolute;
            top: calc(100% - 1.25rem);
            left: 0;
            right: 0;
            z-index: 1090;
            max-height: 220px;
            overflow-y: auto;
            margin-top: .25rem;
            border: 1px solid var(--bs-border-color);
            border-radius: .375rem;
            background-color: var(--bs-body-bg);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
        }

        .patient-search-item {
            display: block;
            width: 100%;
            padding: .5rem .75rem;
            border: 0;
            border-bottom: 1px solid var(--bs-border-color);
            background-color: var(--bs-body-bg);
            color: var(--bs-body-color);
            text-align: left;
        }

        .patient-search-item:last-child { border-bottom: 0; }
        .patient-search-item:hover,
        .patient-search-item:focus { background-color: var(--bs-tertiary-bg); }

        .patient-search-empty {
            padding: .5rem .75rem;
            color: var(--bs-secondary-color);
            background-color: var(--bs-body-bg);
        }

        #schedulingCalendar {
            height: 100%;
        }

        .scheduling-day-layout {
            display: flex;
            align-items: stretch;
            gap: 0;
        }

        .scheduling-day-panel {
            flex: 0 0 14rem;
            width: 14rem;
            min-width: 14rem;
        }

        .scheduling-day-panel .card + .card {
            margin-top: .75rem;
        }

        .scheduling-quick-view-empty {
            color: var(--bs-secondary-color);
            font-size: .8rem;
            line-height: 1.4;
        }

        .scheduling-quick-view-patient {
            font-size: .9rem;
            font-weight: 600;
        }

        .scheduling-quick-view-label {
            color: var(--bs-secondary-color);
            font-size: .65rem;
            font-weight: 600;
            letter-spacing: .02em;
            text-transform: uppercase;
        }

        .scheduling-quick-view-value {
            font-size: .78rem;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .scheduling-event-quick-view {
            border-left: 1px solid rgba(255, 255, 255, .35);
            opacity: .8;
        }

        .scheduling-event-quick-view:hover {
            background: rgba(255, 255, 255, .18);
            opacity: 1;
        }

        .scheduling-mini-calendar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .25rem;
            margin-bottom: .5rem;
        }

        .scheduling-mini-calendar-title {
            font-size: .875rem;
            font-weight: 600;
            text-align: center;
        }

        .scheduling-mini-calendar-nav {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: var(--bs-secondary-color);
            font-size: .75rem;
        }

        .scheduling-mini-calendar-nav:hover {
            background: var(--bs-tertiary-bg);
            color: var(--bs-body-color);
        }

        .scheduling-mini-calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 2px;
        }

        .scheduling-mini-calendar-weekday {
            color: var(--bs-secondary-color);
            font-size: .65rem;
            font-weight: 600;
            line-height: 1.5rem;
            text-align: center;
        }

        .scheduling-mini-calendar-day {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1;
            min-width: 0;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: var(--bs-body-color);
            font-size: .75rem;
        }

        .scheduling-mini-calendar-day:hover {
            background: var(--bs-tertiary-bg);
        }

        .scheduling-mini-calendar-day.is-today {
            box-shadow: inset 0 0 0 1px var(--bs-primary);
        }

        .scheduling-mini-calendar-day.is-selected {
            background: var(--bs-primary);
            color: var(--bs-white);
            box-shadow: none;
        }

        .scheduling-mini-calendar-blank {
            aspect-ratio: 1;
        }

        .scheduling-day-divider {
            position: relative;
            flex: 0 0 1px;
            width: 1px;
            min-width: 1px;
            background: var(--bs-border-color);
        }

        .scheduling-day-panel-toggle {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 30px;
            border: 0;
            border-radius: 999px;
            background: var(--bs-body-bg);
            color: var(--bs-secondary-color);
            font-size: .75rem;
            transform: translate(-50%, -50%);
            padding: 0;
        }

        .scheduling-day-panel-toggle:hover {
            background: var(--bs-tertiary-bg);
            color: var(--bs-body-color);
        }

        .scheduling-day-panel-toggle:focus-visible {
            outline: 2px solid var(--bs-primary);
            outline-offset: 1px;
        }

        .scheduling-day-calendar {
            flex: 1 1 auto;
            min-width: 0;
        }

        .scheduling-day-layout.is-panel-collapsed .scheduling-day-panel {
            flex: 0 0 0;
            width: 0;
            min-width: 0;
            max-width: 0;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .scheduling-day-layout.is-panel-collapsed .scheduling-day-panel-content {
            display: none;
        }

        .scheduling-empty-state {
            padding: 2rem;
            border: 1px dashed var(--bs-border-color);
            background: var(--bs-tertiary-bg);
            color: var(--bs-secondary-color);
        }

        .scheduling-month-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            flex-wrap: wrap;
            margin-bottom: .75rem;
        }

        .scheduling-month-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: .5rem;
        }

        .scheduling-month-header {
            font-size: .8rem;
            font-weight: 600;
            color: var(--bs-secondary-color);
            text-align: center;
        }

        .scheduling-month-day {
            min-height: 6.5rem;
            padding: .5rem;
            border: 1px solid var(--bs-border-color);
            border-radius: .5rem;
            background: var(--bs-body-bg);
            cursor: pointer;
            text-align: left;
        }

        .scheduling-month-day:hover { background: var(--bs-tertiary-bg); }
        .scheduling-month-day.is-today { border-color: var(--bs-primary); }
        .scheduling-month-day.is-selected { box-shadow: 0 0 0 .15rem rgba(13, 110, 253, .15); }
        .scheduling-month-day-number { font-weight: 600; }
        .scheduling-month-day-summary { margin-top: .5rem; font-size: .85rem; }
        .scheduling-month-blank { min-height: 6.5rem; }

        @@media (max-width: 767.98px) {
            .scheduling-toolbar,
            .scheduling-view-bar,
            .scheduling-month-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .scheduling-toolbar-actions,
            .scheduling-filter,
            .scheduling-filter-panel {
                width: 100%;
            }

            .scheduling-date-label {
                min-width: 0;
                text-align: left;
            }

            .scheduling-filter,
            .scheduling-filter-panel {
                align-items: stretch;
                flex-direction: column;
            }

            .scheduling-filter .form-select,
            .scheduling-filter-field,
            .scheduling-filter-field .form-select {
                width: 100%;
                min-width: 0;
            }

            .scheduling-calendar-shell {
                max-width: 100%;
                min-height: 560px;
                overflow: auto;
            }

            #schedulingCalendar {
                min-width: 720px;
            }

            .scheduling-month-grid {
                min-width: 680px;
            }

            #schedulingMonthView {
                max-width: 100%;
                overflow-x: auto;
            }
        }

        @@media (max-width: 991.98px) {
            .scheduling-day-layout {
                flex-direction: column;
            }

            .scheduling-day-panel {
                flex-basis: auto;
                width: 100%;
            }

            .scheduling-day-layout.is-panel-collapsed {
                flex-direction: row;
            }

            .scheduling-day-layout.is-panel-collapsed .scheduling-day-panel {
                flex: 0 0 36px;
                width: 36px;
                min-width: 36px;
            }
        }
    </style>
}

