        const normalizeUid = value => String(value || "").trim().toLowerCase();

        const toJavaScriptDate = value => {
            if (!value) return null;
            if (value instanceof Date) return value;
            if (typeof value.toDateLocal === "function") return value.toDateLocal();
            if (typeof value.toDate === "function") return value.toDate();
            return new Date(value);
        };

        const getDayPilotMoveResourceUid = (args, useNewResource) => {
            const candidate = useNewResource
                ? (args.newResource || args.resource)
                : (args.resource || args.newResource);
            const value = candidate?.id
                || candidate
                || args.e?.data?.resourceUid
                || args.e?.data?.ResourceUid
                || args.e?.data?.resource
                || (typeof args.e?.resource === "function" ? args.e.resource() : null);
            return normalizeUid(value);
        };

        const parseUtcDate = value => {
            if (!value) return null;
            if (value instanceof Date) return value;
            if (typeof value.toDateLocal === "function") return value.toDateLocal();
            const text = String(value);
            const hasTimeZone = /(?:Z|[+-]\d{2}:?\d{2})$/i.test(text);
            return new Date(hasTimeZone ? text : `${text}Z`);
        };

        const toDayPilotLocalDateTime = value => {
            const date = parseUtcDate(value);
            if (!date || !Number.isFinite(date.getTime())) return value;
            const pad = number => String(number).padStart(2, "0");
            const milliseconds = String(date.getMilliseconds()).padStart(3, "0");
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`
                + `T${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}.${milliseconds}`;
        };

        const rangesOverlap = (startA, endA, startB, endB) =>
            startA < endB && endA > startB;

        const hasBlockedTimeConflict = (resourceUid, start, end, ignoredBlockedTimeUid = null) => {
            if (!resourceUid || !start || !end) return false;
            const normalizedResourceUid = normalizeUid(resourceUid);
            const startDate = toJavaScriptDate(start);
            const endDate = toJavaScriptDate(end);
            if (!startDate || !endDate) return false;
            if (!Number.isFinite(startDate.getTime()) || !Number.isFinite(endDate.getTime())) return false;

            return blockedTimes.some(block => {
                const blockResourceUid = block.resourceUid || block.ResourceUid
                    || block.extendedProps?.resourceUid || block.extendedProps?.ResourceUid;
                const blockUid = block.blockedTimeUid || block.BlockedTimeUid;
                if (ignoredBlockedTimeUid && normalizeUid(blockUid) ===
                    normalizeUid(ignoredBlockedTimeUid)) return false;
                if (normalizeUid(blockResourceUid) !== normalizedResourceUid) return false;
                const blockStart = parseUtcDate(
                    block.startDateTimeUtc || block.StartDateTimeUtc || block.start);
                const blockEnd = parseUtcDate(
                    block.endDateTimeUtc || block.EndDateTimeUtc || block.end);
                if (!blockStart || !blockEnd) return false;
                if (!Number.isFinite(blockStart.getTime()) || !Number.isFinite(blockEnd.getTime())) return false;
                return rangesOverlap(startDate, endDate, blockStart, blockEnd);
            });
        };

        const hasBlockedTimeConflictFromCalendar = (resourceUid, start, end) => {
            const normalizedResourceUid = normalizeUid(resourceUid);
            const appointmentStart = toJavaScriptDate(start);
            const appointmentEnd = toJavaScriptDate(end);
            if (!normalizedResourceUid || !appointmentStart || !appointmentEnd) return false;

            return (calendar.events.list || []).some(event => {
                if (event.eventKind !== "blockedTime") return false;
                const eventResourceUid = normalizeUid(
                    event.resource || event.resourceUid || event.ResourceUid);
                if (eventResourceUid !== normalizedResourceUid) return false;
                // DayPilot event values are local wall-clock times, unlike the UTC API values.
                const eventStart = toJavaScriptDate(event.start);
                const eventEnd = toJavaScriptDate(event.end);
                return eventStart && eventEnd
                    && rangesOverlap(appointmentStart, appointmentEnd, eventStart, eventEnd);
            });
        };

        const hasServerBlockedTimeConflict = async (resourceUid, start, end) => {
            const normalizedResourceUid = String(resourceUid || "").trim().toLowerCase();
            if (!normalizedResourceUid) return true;
            const startDate = new Date(start);
            const endDate = new Date(end);
            if (!Number.isFinite(startDate.getTime()) || !Number.isFinite(endDate.getTime())) return true;

            const url = new URL("/Scheduling/BlockedTimes", window.location.origin);
            url.searchParams.set("startDateTimeUtc", startDate.toISOString());
            url.searchParams.set("endDateTimeUtc", endDate.toISOString());
            const response = await fetch(url, { headers: { "Accept": "application/json" } });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) {
                throw new Error(result.message || "Blocked time could not be validated.");
            }
            const matchingBlocks = result.blockedTimes || [];
            return matchingBlocks.some(block =>
                String(block.resourceUid || block.ResourceUid || "").trim().toLowerCase() ===
                normalizedResourceUid);
        };

