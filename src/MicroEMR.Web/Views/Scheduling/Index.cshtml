@section Scripts {
    <script src="~/lib/daypilot/daypilot-javascript.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
        if (!window.DayPilot) {
            console.error("DayPilot Lite could not be loaded.");
            return;
        }

        const resources = @Html.Raw(resourcesJson);
        const initialDate = @Html.Raw(initialDateJson);
        const shouldOpenAddAppointment = @Html.Raw(openAddAppointmentJson);

        if (!resources.length) {
            return;
        }

        let selectedDate = initialDate
            ? new DayPilot.Date(initialDate)
            : DayPilot.Date.today();
        let currentView = "day";
        let selectedMonthDate = new Date();
        selectedMonthDate.setHours(0, 0, 0, 0);
        let miniCalendarMonthDate = selectedDate.toDateLocal();
        miniCalendarMonthDate.setDate(1);
        let miniCalendarSelectedKey = null;
        let selectedAppointment = null;
        let selectedResourceType = "";
        let selectedResourceUids = new Set(
            resources.slice(0, Math.min(5, resources.length)).map(resource => resource.resourceUid));
        let pendingResourceUids = new Set();
        let blockedTimes = [];
        const resourceTypeFilter = document.getElementById("schedulingResourceTypeFilter");
        const resourceFilterSummary = document.getElementById("resourceFilterSummary");
        const resourceFilterMessage = document.getElementById("resourceFilterMessage");

        const dateLabel =
            document.getElementById("schedulingDateLabel");
        const dayView = document.getElementById("schedulingDayView");
        const monthView = document.getElementById("schedulingMonthView");
        const dayViewButton = document.getElementById("schedulingDayViewButton");
        const monthViewButton = document.getElementById("schedulingMonthViewButton");
        const viewTitle = document.getElementById("schedulingViewTitle");
        const monthGrid = document.getElementById("schedulingMonthGrid");
        const monthLabel = document.getElementById("schedulingMonthLabel");
        const monthMessage = document.getElementById("schedulingMonthMessage");
        const miniCalendarTitle = document.getElementById("schedulingMiniCalendarTitle");
        const miniCalendarGrid = document.getElementById("schedulingMiniCalendarGrid");
        const miniCalendarPrevious = document.getElementById("schedulingMiniCalendarPrevious");
        const miniCalendarNext = document.getElementById("schedulingMiniCalendarNext");
        const dayLayout = document.getElementById("schedulingDayLayout");
        const dayPanelToggle = document.getElementById("schedulingDayPanelToggle");
        const dayPanelToggleIcon = document.getElementById("schedulingDayPanelToggleIcon");
        const quickViewEmpty = document.getElementById("schedulingQuickViewEmpty");
        const quickViewContent = document.getElementById("schedulingQuickViewContent");
        const quickViewReasonGroup = document.getElementById("schedulingQuickViewReasonGroup");

        const getMatchingResources = () => resources.filter(resource =>
            (!selectedResourceType || resource.resourceType === selectedResourceType) &&
            selectedResourceUids.has(resource.resourceUid));

        const getFilteredResources = () => getMatchingResources();

        const toColumns = () => getFilteredResources()
            .map(resource => ({
                id: resource.resourceUid,
                name: resource.displayName
            }));

        const updateResourceFilterSummary = () => {
            const matchingCount = getMatchingResources().length;
            const selectedCount = selectedResourceUids.size;
            resourceFilterSummary.textContent =
                `${selectedCount} ${selectedCount === 1 ? "resource" : "resources"} selected`;
            resourceFilterMessage.classList.toggle("d-none", matchingCount > 0);
            resourceFilterMessage.textContent = selectedCount === 0
                ? "Select at least one resource to display scheduling columns."
                : "No selected resources match the selected resource type.";
        };

        const quickViewDate = value => {
            if (!value) return null;
            const date = typeof value.toDateLocal === "function"
                ? value.toDateLocal()
                : new Date(value);
            return Number.isFinite(date.getTime()) ? date : null;
        };

        const setQuickViewText = (id, value, fallback = "Not specified") => {
            document.getElementById(id).textContent = value || fallback;
        };

        const renderAppointmentQuickView = appointment => {
            if (!appointment) return;
            selectedAppointment = appointment;

            const start = quickViewDate(appointment.startDateTimeLocal || appointment.start);
            const end = quickViewDate(appointment.endDateTimeLocal || appointment.end);
            const resourceName = appointment.primaryResourceName
                || resources.find(resource =>
                    String(resource.resourceUid).toLowerCase()
                        === String(appointment.primaryResourceUid || appointment.resource).toLowerCase())?.displayName;

            setQuickViewText("schedulingQuickViewPatient", appointment.patientDisplayName, "Patient");
            setQuickViewText(
                "schedulingQuickViewDateTime",
                start && end
                    ? `${start.toLocaleDateString()} · ${start.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}`
                        + `–${end.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}`
                    : null);
            setQuickViewText("schedulingQuickViewResource", resourceName);
            setQuickViewText("schedulingQuickViewType", appointment.appointmentType);
            setQuickViewText("schedulingQuickViewStatus", appointment.status);

            const reason = appointment.reason?.trim();
            quickViewReasonGroup.classList.toggle("d-none", !reason);
            setQuickViewText("schedulingQuickViewReason", reason);
            quickViewEmpty.classList.add("d-none");
            quickViewContent.classList.remove("d-none");
        };

        const setDayPanelCollapsed = isCollapsed => {
            dayLayout.classList.toggle("is-panel-collapsed", isCollapsed);
            dayPanelToggle.setAttribute("aria-expanded", String(!isCollapsed));
            const toggleLabel = isCollapsed ? "Expand panel" : "Collapse panel";
            dayPanelToggle.setAttribute("aria-label", toggleLabel);
            dayPanelToggle.setAttribute("title", toggleLabel);
            dayPanelToggleIcon.classList.toggle("bi-chevron-left", !isCollapsed);
            dayPanelToggleIcon.classList.toggle("bi-chevron-right", isCollapsed);
            window.requestAnimationFrame(() => calendar.update());
        };

        const calendar = new DayPilot.Calendar(
            "schedulingCalendar",
            {
                viewType: "Resources",
                columns: toColumns(),
                startDate: selectedDate,
                cellDuration: 15,
                businessBeginsHour: 8,
                businessEndsHour: 18,
                eventMoveHandling: "Update",
                eventResizeHandling: "Disabled",
                eventDeleteHandling: "Disabled",
                timeRangeSelectedHandling: "Enabled",
                onBeforeEventRender: args => {
                    if (args.data.eventKind !== "appointment") return;
                    args.data.areas = [
                        ...(args.data.areas || []),
                        {
                            right: 0,
                            top: 0,
                            bottom: 0,
                            width: 22,
                            action: "None",
                            cssClass: "scheduling-event-quick-view",
                            html: '<i class="bi bi-chevron-right" aria-hidden="true"></i>',
                            horizontalAlignment: "center",
                            verticalAlignment: "center",
                            cursor: "pointer",
                            toolTip: "Show appointment quick view",
                            onClick: areaArgs => {
                                areaArgs.preventDefault();
                                areaArgs.originalEvent?.preventDefault();
                                areaArgs.originalEvent?.stopPropagation();
                                renderAppointmentQuickView(areaArgs.source.data);
                                if (dayLayout.classList.contains("is-panel-collapsed")) {
                                    setDayPanelCollapsed(false);
                                }
                            }
                        }
                    ];
                },
                onEventMoving: args => {
                    const eventKind = args.e?.data?.eventKind || args.e?.data?.EventKind;
                    if (eventKind === "blockedTime") {
                        args.allowed = false;
                        return;
                    }

                    const resourceUid = getDayPilotMoveResourceUid(args, false);
                    const start = toJavaScriptDate(args.start);
                    const end = toJavaScriptDate(args.end);
                    if (!resourceUid || !start || !end) {
                        args.allowed = false;
                        return;
                    }

                    const conflict =
                        hasBlockedTimeConflict(resourceUid, start, end)
                        || hasBlockedTimeConflictFromCalendar(resourceUid, start, end);
                    args.allowed = !conflict;
                    if (conflict && args.right) {
                        args.right.enabled = true;
                        args.right.html = "Blocked";
                    }
                },
                onEventMove: async args => {
                    args.preventDefault();
                    if (args.e.data.eventKind === "blockedTime") {
                        await refreshCalendar();
                        return;
                    }
                    const appointmentUid = args.e.data.appointmentUid || args.e.id();
                    const destinationResourceUid = getDayPilotMoveResourceUid(args, true);
                    const destination = resources.find(resource =>
                        String(resource.resourceUid).toLowerCase() === destinationResourceUid.toLowerCase());
                    if (destination?.resourceType !== "Provider") {
                        await refreshCalendar();
                        window.alert("Appointments can only be moved between provider columns.");
                        return;
                    }
                    const proposedStart = toJavaScriptDate(args.newStart || args.start);
                    const originalStart = args.e.start()?.toDateLocal();
                    const originalEnd = args.e.end()?.toDateLocal();
                    const originalDuration =
                        originalStart && originalEnd
                            ? originalEnd.getTime() - originalStart.getTime()
                            : 0;
                    const proposedEnd = toJavaScriptDate(args.newEnd || args.end)
                        || (proposedStart && originalDuration > 0
                            ? new Date(proposedStart.getTime() + originalDuration)
                            : null);
                    if (!appointmentUid || !proposedStart || !proposedEnd) {
                        await refreshCalendar();
                        showSchedulingActionMessage("The appointment could not be moved. Please try again.", "warning");
                        return;
                    }
                    let blockedConflict;
                    try {
                        blockedConflict =
                            hasBlockedTimeConflict(destinationResourceUid, proposedStart, proposedEnd) ||
                            await hasServerBlockedTimeConflict(destinationResourceUid, proposedStart, proposedEnd);
                    } catch (error) {
                        console.error(error);
                        await refreshCalendar();
                        showSchedulingActionMessage(
                            "Blocked time could not be validated. Appointment was not moved.",
                            "warning");
                        return;
                    }
                    if (blockedConflict) {
                        await refreshCalendar();
                        showSchedulingActionMessage(
                            "This resource is blocked during the selected time.",
                            "warning");
                        return;
                    }
                    try {
                        const detailsUrl = new URL("/Scheduling/AppointmentDetails", window.location.origin);
                        detailsUrl.searchParams.set("appointmentUid", appointmentUid);
                        const detailsResponse = await fetch(detailsUrl);
                        if (!detailsResponse.ok) throw new Error(`Appointment details request failed: ${detailsResponse.status}`);
                        const details = await detailsResponse.json();
                        pendingMove = {
                            appointmentUid,
                            primaryResourceUid: destinationResourceUid,
                            roomResourceUid: details.roomResourceUid || null,
                            startDateTimeLocal: proposedStart,
                            endDateTimeLocal: proposedEnd
                        };

                        const start = pendingMove.startDateTimeLocal;
                        const end = pendingMove.endDateTimeLocal;
                        const finalConflictBeforeModal =
                            hasBlockedTimeConflict(pendingMove.primaryResourceUid, start, end)
                            || hasBlockedTimeConflictFromCalendar(
                                pendingMove.primaryResourceUid, start, end);
                        if (finalConflictBeforeModal) {
                            pendingMove = null;
                            await refreshCalendar();
                            showSchedulingActionMessage(
                                "This resource is blocked during the selected time.",
                                "warning");
                            return;
                        }
                        moveAppointmentSummary.textContent =
                            `Move to ${destination?.displayName || "the selected resource"} on ${start.toLocaleDateString()} ` +
                            `from ${start.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })} ` +
                            `to ${end.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}?`;
                        moveAppointmentMessage.classList.add("d-none");
                        moveAppointmentMessage.textContent = "";
                        moveAppointmentModal.show();
                    } catch (error) {
                        console.error(error);
                        pendingMove = null;
                        await refreshCalendar();
                        window.alert("The appointment could not be prepared for rescheduling. Please try again.");
                    }
                },
                onTimeRangeSelected: args => {
                    openAppointmentModal(args.start, args.resource);
                    calendar.clearSelection();
                },
                onEventClick: args => {
                    if (args.e.data.eventKind === "blockedTime") {
                        openBlockedTimeDetails(args.e.data);
                        return;
                    }
                    renderAppointmentQuickView(args.e.data);
                    openAppointmentDetails(args.e.id());
                }
            });

        calendar.init();

        dayPanelToggle?.addEventListener("click", () => {
            setDayPanelCollapsed(!dayLayout.classList.contains("is-panel-collapsed"));
        });

        const appointmentModal = new bootstrap.Modal(document.getElementById("addAppointmentModal"));
        const resourcePickerModal = new bootstrap.Modal(document.getElementById("resourcePickerModal"));
        const resourcePickerSearch = document.getElementById("resourcePickerSearch");
        const resourcePickerList = document.getElementById("resourcePickerList");
