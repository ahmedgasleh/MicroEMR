@using MicroEMR.Application.PatientCpp
<section id="cppDisplayPreferences" class="mb-3"
         data-load-url="@Url.Action("Get", "CppDisplayPreferences")"
         data-save-url="@Url.Action("Save", "CppDisplayPreferences")">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h3 class="h6 mb-0">Cumulative Patient Profile</h3>
            <small class="text-body-secondary" id="cppHiddenSummary" aria-live="polite"></small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse"
                data-bs-target="#cppPreferenceEditor" aria-controls="cppPreferenceEditor" aria-expanded="false">Customize CPP</button>
    </div>
    <p id="cppPreferenceMessage" class="small text-body-secondary mt-2 mb-0" role="status">Loading display preferences...</p>
    <div class="collapse mt-2" id="cppPreferenceEditor">
        <form id="cppPreferenceForm" class="card card-body">
            @Html.AntiForgeryToken()
            <p class="small text-body-secondary">Choose categories and information to show in your CPP. These choices apply to your account across patient charts and sign-ins. Full records remain available in the chart tabs.</p>
            <fieldset id="cppPreferenceControls" disabled>
                <div class="row g-3">
                    @foreach (var category in CppDisplayCatalog.Categories)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" checked id="cpp-category-@category.Key" data-preference-category="@category.Key" />
                                <label class="form-check-label fw-semibold" for="cpp-category-@category.Key">@category.Label</label>
                            </div>
                            <div class="ms-3">
                                @foreach (var field in category.Fields)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked id="cpp-field-@field.Key" data-preference-field="@field.Key" />
                                        <label class="form-check-label" for="cpp-field-@field.Key">@field.Label</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">Save display preferences</button>
                    <button type="button" id="cppRestoreDefaults" class="btn btn-outline-secondary btn-sm">Restore Defaults</button>
                </div>
            </fieldset>
        </form>
    </div>
</section>
