<script>
document.addEventListener("DOMContentLoaded", () => {
 const activatePatientDetailsTab = (target, afterActivation) => {
  const tabButton = document.querySelector(`[data-bs-target="#${target}"]`);
  if (!tabButton) return false;
  const finish = () => {
   const url = new URL(window.location.href); url.searchParams.set("tab", target); window.history.replaceState({}, "", url);
   window.requestAnimationFrame(afterActivation);
  };
  if (tabButton.classList.contains("active")) finish();
  else {
   tabButton.addEventListener("shown.bs.tab", finish, { once: true });
   bootstrap.Tab.getOrCreateInstance(tabButton).show();
  }
  return true;
 };

 document.querySelectorAll(".summary-tab-link, .timeline-tab-link").forEach(link => link.addEventListener("click", () => {
  const target = link.dataset.tabTarget;
  activatePatientDetailsTab(target, () => {});
 }));

 const quickActionMessage = document.getElementById("summaryQuickActionMessage");
 document.querySelectorAll(".summary-direct-action").forEach(button => button.addEventListener("click", () => {
  quickActionMessage?.classList.add("d-none");
  const actionButton = document.getElementById(button.dataset.actionTarget);
  if (actionButton) { actionButton.dataset.returnTab = "summary"; actionButton.click(); }
  else if (quickActionMessage) {
   quickActionMessage.textContent = "The requested action could not be opened. Please try again from the tab directly.";
   quickActionMessage.classList.remove("d-none");
  }
 }));

 document.querySelectorAll("#summaryAllergyForm, #summaryMedicationForm, #summaryDocumentForm").forEach(form => {
  const modal = form.closest(".modal");
  const saveButton = form.querySelector(".summary-modal-save");
  if (saveButton) saveButton.dataset.defaultText = saveButton.textContent;
  modal?.addEventListener("show.bs.modal", event => {
   form.reset();
   if (form.id === "summaryDocumentForm") {
    document.getElementById("summaryDocumentStructuredMessage")?.classList.add("d-none");
    document.getElementById("summaryDocumentContentGroup")?.classList.remove("d-none");
    const documentContent = document.getElementById("summaryDocumentContent");
    if (documentContent) documentContent.disabled = false;
   }
   const trigger = event.relatedTarget;
   const returnTab = form.querySelector('input[name="ReturnTab"]');
   if (returnTab) returnTab.value = trigger?.dataset.returnTab === "summary" ? "summary" : trigger?.dataset.returnTab ?? "summary";
   if (saveButton) { saveButton.disabled = false; saveButton.textContent = saveButton.dataset.defaultText; }
  });
  form.addEventListener("submit", event => {
   if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; }
   if (saveButton) { saveButton.disabled = true; saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...'; }
  });
 });

 const documentTemplate = document.getElementById("summaryDocumentTemplate");
 documentTemplate?.addEventListener("change", async () => {
 const error = document.getElementById("summaryDocumentTemplateError");
  const structuredMessage = document.getElementById("summaryDocumentStructuredMessage");
  const contentGroup = document.getElementById("summaryDocumentContentGroup");
  const content = document.getElementById("summaryDocumentContent");
  error?.classList.add("d-none");
  structuredMessage?.classList.add("d-none");
  contentGroup?.classList.remove("d-none");
  if (content) content.disabled = false;
  if (!documentTemplate.value) return;
  documentTemplate.disabled = true;
  try {
   const url = new URL('@Url.Action("GetTemplate", "PatientDocuments")', window.location.origin);
   url.searchParams.set("templateUid", documentTemplate.value);
   const response = await fetch(url, { headers: { Accept: "application/json" } });
   if (!response.ok) throw new Error();
   const template = await response.json();
   document.getElementById("summaryDocumentType").value = template.category ?? template.documentType ?? "";
   content.value = template.templateContent ?? "";
   contentGroup?.classList.toggle("d-none", Boolean(template.isStructured));
   structuredMessage?.classList.toggle("d-none", !template.isStructured);
   content.disabled = Boolean(template.isStructured);
   const title = document.getElementById("summaryDocumentTitle");
   if (!title.value.trim()) title.value = template.templateName ?? "";
  } catch { error?.classList.remove("d-none"); }
  finally { documentTemplate.disabled = false; }
 });

 const timelineButton = document.querySelector('[data-bs-target="#timeline"]');
 timelineButton?.addEventListener("shown.bs.tab", () => {
  const url = new URL(window.location.href); url.searchParams.set("tab", "timeline"); window.history.replaceState({}, "", url);
 });

 const filter = document.getElementById("timelineFilter");
 const emptyState = document.getElementById("timelineEmptyState");
 const limitNote = document.getElementById("timelineLimitNote");
 const emptyMessages = {
  All: "No timeline activity recorded.", Encounter: "No encounter activity recorded.",
  Document: "No document activity recorded.", Vitals: "No vitals activity recorded.",
  Problem: "No problem activity recorded.", Allergy: "No allergy activity recorded.",
  Medication: "No medication activity recorded."
 };
 const applyTimelineFilter = () => {
  if (!filter || !emptyState) return;
  let visibleCount = 0;
  document.querySelectorAll(".timeline-item").forEach(item => {
   const visible = filter.value === "All" || item.dataset.eventType === filter.value;
   item.classList.toggle("d-none", !visible);
   if (visible) visibleCount++;
  });
  emptyState.textContent = emptyMessages[filter.value] || emptyMessages.All;
  emptyState.classList.toggle("d-none", visibleCount !== 0);
  limitNote?.classList.toggle("d-none", filter.value !== "All");
 };
 filter?.addEventListener("change", applyTimelineFilter);
 applyTimelineFilter();
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
 const element=document.getElementById("vitalEditorModal"); if(!element)return; const modal=new bootstrap.Modal(element);
 const ids=["RecordedAt","Systolic","Diastolic","HeartRate","RespiratoryRate","Temperature","Oxygen","Height","Weight","Notes"];
 const fields=Object.fromEntries(ids.map(x=>[x,document.getElementById(`vital${x}`)])); const uid=document.getElementById("vitalUid"), title=document.getElementById("vitalEditorModalLabel"), message=document.getElementById("vitalEditorMessage"), save=document.getElementById("saveVitalButton");
 const nowLocal=()=>{const d=new Date(Date.now()-new Date().getTimezoneOffset()*60000);return d.toISOString().slice(0,16);};
 document.getElementById("addVitalButton")?.addEventListener("click",()=>{element.dataset.returnTab=document.getElementById("addVitalButton").dataset.returnTab||"vitals";delete document.getElementById("addVitalButton").dataset.returnTab;uid.value="";ids.forEach(x=>fields[x].value="");fields.RecordedAt.value=nowLocal();title.textContent="Add Vitals";message.classList.add("d-none");modal.show();});
 document.querySelectorAll(".edit-vital-button").forEach(button=>button.addEventListener("click",()=>{const d=button.closest("tr").dataset;uid.value=d.vitalUid;document.getElementById("vitalRowVersion").value=d.rowVersion;fields.RecordedAt.value=d.recordedAt;fields.Systolic.value=d.systolic;fields.Diastolic.value=d.diastolic;fields.HeartRate.value=d.heartRate;fields.RespiratoryRate.value=d.respiratoryRate;fields.Temperature.value=d.temperature;fields.Oxygen.value=d.oxygen;fields.Height.value=d.height;fields.Weight.value=d.weight;fields.Notes.value=d.notes;title.textContent="Edit Vitals";message.classList.add("d-none");modal.show();}));
 save.addEventListener("click",async()=>{if(!fields.RecordedAt.value){message.textContent="Recorded date and time are required.";message.classList.remove("d-none");return;} save.disabled=true;message.classList.add("d-none");const data=new FormData();data.append("PatientUid","@patient.PatientUid");if(uid.value){data.append("PatientVitalUid",uid.value);data.append("RowVersion",document.getElementById("vitalRowVersion").value);}data.append("RecordedAt",fields.RecordedAt.value);const names={Systolic:"BloodPressureSystolic",Diastolic:"BloodPressureDiastolic",HeartRate:"HeartRate",RespiratoryRate:"RespiratoryRate",Temperature:"TemperatureCelsius",Oxygen:"OxygenSaturation",Height:"HeightCm",Weight:"WeightKg",Notes:"Notes"};Object.entries(names).forEach(([key,name])=>{if(fields[key].value)data.append(name,fields[key].value);});try{const token=document.querySelector('#vitalAntiforgeryForm input[name="__RequestVerificationToken"]').value;const url=uid.value?'@Url.Action("UpdateVital", "PatientVitals")':'@Url.Action("CreateVital", "PatientVitals")';const response=await fetch(url,{method:"POST",headers:{"RequestVerificationToken":token},body:data});const result=await response.json().catch(()=>({}));if(!response.ok||!result.success)throw new Error(result.message||"Vitals could not be saved.");window.location.href=element.dataset.returnTab==="summary"?'@Url.Action("Details", "Patients", new { patientUid = patient.PatientUid, tab = "summary" })':'@Url.Action("Details", "Patients", new { patientUid = patient.PatientUid, tab = "vitals" })';}catch(error){message.textContent=error instanceof Error?error.message:"Vitals could not be saved.";message.classList.remove("d-none");}finally{save.disabled=false;}});
});
</script>
