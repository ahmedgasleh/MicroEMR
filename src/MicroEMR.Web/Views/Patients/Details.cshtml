  <div class="row g-3 mb-3"><div class="col-md-6"><label for="patientFileDocumentDate" class="form-label">Document date <span class="text-body-secondary">(optional)</span></label><input id="patientFileDocumentDate" name="DocumentDate" type="date" class="form-control"/></div><div class="col-md-6"><label for="patientFileReceivedDate" class="form-label">Received date <span class="text-body-secondary">(optional)</span></label><input id="patientFileReceivedDate" name="ReceivedDate" type="date" class="form-control"/></div></div>
  <div class="row g-3 mb-3"><div class="col-md-6"><label for="patientFileSourceOrganization" class="form-label">Source organization <span class="text-body-secondary">(optional)</span></label><input id="patientFileSourceOrganization" name="SourceOrganization" class="form-control" maxlength="200"/></div><div class="col-md-6"><label for="patientFileAuthorName" class="form-label">Author / provider <span class="text-body-secondary">(optional)</span></label><input id="patientFileAuthorName" name="AuthorName" class="form-control" maxlength="200"/></div></div>
  <div class="mb-3"><label for="patientFileDescription" class="form-label">Description <span class="text-body-secondary">(optional)</span></label><textarea id="patientFileDescription" name="Description" class="form-control" maxlength="1000" rows="3"></textarea></div>
  <div id="patientFileUploadMessage" class="alert alert-danger d-none mb-0" role="alert"></div>
 </form></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" form="patientFileUploadForm" id="submitPatientFile" class="btn btn-primary">Upload File</button></div></div></div>
</div>
<div class="modal fade" id="patientFileDetailsModal" tabindex="-1" aria-labelledby="patientFileDetailsTitle" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="patientFileDetailsTitle">File details</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body" id="patientFileDetailsBody" aria-live="polite"></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>

