@model MicroEMR.Web.Models.Patients.PatientChartViewModel

@using MicroEMR.Application.AccessProfiles
@using MicroEMR.Web.Authorization
@inject IWebPermissionService Permissions
@{
    var patient = Model.Patient;
    var summary = Model.Summary;
    var cpp = Model.Cpp;
    var effectivePermissions = await Permissions.GetAsync(Context.RequestAborted);
    var canEditPatients = effectivePermissions.Contains(PermissionKeys.PatientsEdit);
    var canEditEncounters = effectivePermissions.Contains(PermissionKeys.EncountersEdit);
    var canSignEncounters = effectivePermissions.Contains(PermissionKeys.EncountersSign);
    var canManageDocuments = effectivePermissions.Contains(PermissionKeys.DocumentsManage);
    var canManageClinicalData = effectivePermissions.Contains(PermissionKeys.ClinicalDataManage);

    ViewData ["Title"] = "Patient Chart";
    ViewData ["Subtitle"] = patient.ChartNumber;
    Layout = "_AppLayout";

    var summaryActive = Model.ActiveTab == "summary";

    var demographicsActive =
        Model.ActiveTab == "demographics";
    var timelineActive = Model.ActiveTab == "timeline";
    var alertsActive = Model.ActiveTab == "alerts";
    var tasksActive = Model.ActiveTab == "tasks";
    var referralsActive = Model.ActiveTab == "referrals";
    var resultsActive = Model.ActiveTab == "results";

    

    var documentsActive =
        Model.ActiveTab == "documents";
    var filesActive = Model.ActiveTab == "files";

    var encountersActive =
        Model.ActiveTab == "encounters";

    var allergiesActive =
        Model.ActiveTab == "allergies";

    var problemsActive =
        Model.ActiveTab == "problems";
    var historyActive = Model.ActiveTab == "history";
    var immunizationsActive = Model.ActiveTab == "immunizations";

    var medicationsActive =
        Model.ActiveTab == "medications";

    var vitalsActive = Model.ActiveTab == "vitals";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        <i class="bi bi-check-circle me-2"></i>
        @successMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (TempData["WarningMessage"] is string warningMessage)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>
        @warningMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

<section id="patientChartBanner"
         class="patient-chart-banner"
         data-patient-uid="@patient.PatientUid"
         data-patient-name="@summary.PatientDisplayName"
         data-chart-number="@summary.ChartNumber"
         data-date-of-birth="@summary.DateOfBirth.ToString("yyyy-MM-dd")"
         aria-labelledby="patientChartBannerName">
    <div class="patient-chart-banner__identity">
        <div>
            <h2 id="patientChartBannerName" class="patient-chart-banner__name">
                @summary.PatientDisplayName
            </h2>
            @if (!string.IsNullOrWhiteSpace(summary.PreferredName))
            {
                <div class="patient-chart-banner__preferred">
                    Preferred: @summary.PreferredName
                </div>
            }
        </div>
        <div class="patient-chart-banner__meta">
            <span><strong>Chart:</strong> @summary.ChartNumber</span>
            <span><strong>DOB:</strong> @summary.DateOfBirth.ToString("MMM d, yyyy") (@summary.AgeDisplay)</span>
            @if (!string.IsNullOrWhiteSpace(summary.HealthCardNumber))
            {
                <span><strong>HCN:</strong> @summary.HealthCardNumber</span>
            }
            @if (!string.IsNullOrWhiteSpace(summary.PhoneNumber))
            {
                <span><strong>Phone:</strong> @summary.PhoneNumber</span>
            }
        </div>
    </div>
    <nav class="patient-chart-banner__badges" aria-label="Patient clinical summary links">
        <button type="button" class="patient-chart-banner__badge" title="Change patient"
                aria-label="Change patient" data-bs-toggle="modal" data-bs-target="#patientSearchModal">
            <i class="bi bi-search" aria-hidden="true"></i> Change patient
        </button>
        <button type="button" id="patientAlertBadge" class="patient-chart-banner__badge d-none" data-chart-tab-link="alerts">Alerts <span class="badge text-bg-warning" id="patientAlertCount">0</span></button>
        <button type="button" class="patient-chart-banner__badge" data-chart-tab-link="problems">
            Problems <span class="badge text-bg-secondary">@summary.ActiveProblemsTotalCount</span>
        </button>
        <button type="button" class="patient-chart-banner__badge" data-chart-tab-link="allergies">
            Allergies <span class="badge text-bg-secondary">@summary.ActiveAllergiesTotalCount</span>
        </button>
        <button type="button" class="patient-chart-banner__badge" data-chart-tab-link="medications">
            Medications <span class="badge text-bg-secondary">@summary.ActiveMedicationsTotalCount</span>
        </button>
        <button type="button" class="patient-chart-banner__badge" data-chart-tab-link="vitals">
            Latest vitals
            <span class="patient-chart-banner__badge-value">
                @(summary.LatestVitals is null
                    ? "None recorded"
                    : summary.LatestVitals.RecordedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))
            </span>
        </button>
    </nav>
</section>

<section id="patientCdsRoot" class="card mb-3"
         data-patient-uid="@patient.PatientUid"
         data-evaluate-url="@Url.Action("Evaluate", "PatientCds", new { patientUid = patient.PatientUid })"
         data-can-respond="@canManageClinicalData.ToString().ToLowerInvariant()"
         aria-labelledby="patientCdsHeading">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h2 id="patientCdsHeading" class="h6 mb-0">Clinical Decision Support</h2>
            <small class="text-body-secondary">Transparent, deterministic findings only. Clinical judgment remains authoritative.</small>
        </div>
        <span class="badge text-bg-secondary" id="patientCdsCount">0</span>
    </div>
    <div class="card-body">
        <div id="patientCdsMessage" class="alert d-none" role="alert"></div>
        <div id="patientCdsList" aria-live="polite">
            <span class="text-body-secondary">Loading clinical decision support...</span>
        </div>
    </div>
</section>
<form id="patientCdsAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>

<section id="patientCdmRoot" class="card mb-3" data-summary-url="@Url.Action("Summary","PatientCdm",new{patientUid=patient.PatientUid})" data-can-manage="@canManageClinicalData.ToString().ToLowerInvariant()" aria-labelledby="patientCdmHeading">
    <div class="card-header"><h2 id="patientCdmHeading" class="h6 mb-0">Chronic Disease</h2><small class="text-body-secondary">Explicit program enrollment only; clinical Problems remain the diagnosis source of truth.</small></div>
    <div class="card-body">
        <div id="patientCdmContent"><span class="text-body-secondary">Loading chronic disease enrollment...</span></div>
        <div id="patientCdmEnrollmentForm" class="row g-2 mt-2 d-none">
            <div class="col-md-5"><label class="form-label" for="patientCdmProgram">Approved program</label><select id="patientCdmProgram" class="form-select"></select></div>
            <div class="col-md-5"><label class="form-label" for="patientCdmProblem">Clinical Problem</label><select id="patientCdmProblem" class="form-select">@foreach(var problem in Model.Problems.Where(x=>x.ProblemStatus=="Active")){<option value="@problem.PatientProblemUid">@problem.ProblemName</option>}</select></div>
            <div class="col-md-2 d-flex align-items-end"><button id="patientCdmEnroll" type="button" class="btn btn-primary w-100">Enroll</button></div>
        </div>
    </div>
</section>
<form id="patientCdmAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="patientSearchModal" tabindex="-1" aria-labelledby="patientSearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title fs-5" id="patientSearchModalLabel">Change patient</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body p-0"><iframe title="Find patient" class="w-100 border-0" style="min-height:65vh" src="@Url.Action("Search", "Patients", new { selectionMode = "chart" })"></iframe></div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3 patient-chart-tabs" aria-label="Patient chart sections">
    <li class="nav-item"><button class="nav-link @(summaryActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#summary" type="button">Summary</button></li>
    <li class="nav-item">
        <button class="nav-link @(demographicsActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#demographics"
                type="button">
            Demographics
        </button>
    </li>
    <li class="nav-item"><button class="nav-link @(timelineActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#timeline" type="button">Timeline</button></li>
    <li class="nav-item"><button class="nav-link @(alertsActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#alerts" type="button">Alerts</button></li>
    <li class="nav-item"><button class="nav-link @(tasksActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#tasks" type="button">Tasks</button></li>
    <li class="nav-item"><button class="nav-link @(referralsActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#referrals" type="button">Referrals</button></li>
    

    <li class="nav-item">
        <button class="nav-link @(documentsActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#documents"
                type="button">
            Documents
        </button>
    </li>
    <li class="nav-item"><button class="nav-link @(filesActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#files" type="button">Files</button></li>

    <li class="nav-item">
        <button class="nav-link @(encountersActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#encounters"
                type="button">
            Encounters
        </button>
    </li>

    <li class="nav-item">
        <button class="nav-link @(problemsActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#problems"
                type="button">
            Problems
        </button>
    </li>
    <li class="nav-item"><button class="nav-link @(historyActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#history" type="button">Medical / Surgical History</button></li>
    <li class="nav-item"><button class="nav-link @(immunizationsActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#immunizations" type="button">Immunizations</button></li>

    <li class="nav-item">
        <button class="nav-link @(allergiesActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#allergies"
                type="button">
            Allergies
        </button>
    </li>

    <li class="nav-item">
        <button class="nav-link @(medicationsActive ? "active" : null)"
                data-bs-toggle="tab"
                data-bs-target="#medications"
                type="button">
            Medications
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(vitalsActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#vitals" type="button">Vitals</button>
    </li>
    <li class="nav-item"><button class="nav-link @(resultsActive ? "active" : null)" data-bs-toggle="tab" data-bs-target="#results" type="button">Results</button></li>
</ul>

<div class="tab-content patient-chart-content">
    <div class="tab-pane fade patient-chart-summary @(summaryActive ? "show active" : null)" id="summary" role="tabpanel">
        <div class="card mb-3">
            <div class="card-body py-3">
                <h4 class="h6 mb-3">Quick Actions</h4>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm" type="button" id="summaryNewEncounterButton" data-bs-toggle="modal" data-bs-target="#createEncounterModal" data-return-tab="summary" disabled="@(!canEditEncounters)" aria-disabled="@(!canEditEncounters)" title="@(canEditEncounters ? null : "Read-only access")"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>New Encounter</button>
                    <button class="btn btn-outline-primary btn-sm summary-direct-action" type="button" data-action-target="addVitalButton"><i class="bi bi-heart-pulse me-1" aria-hidden="true"></i>Add Vitals</button>
                    <button class="btn btn-outline-primary btn-sm summary-direct-action" type="button" data-action-target="addProblemButton"><i class="bi bi-clipboard2-plus me-1" aria-hidden="true"></i>Add Problem</button>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#summaryAllergyModal" data-return-tab="summary" disabled="@(!canManageClinicalData)" aria-disabled="@(!canManageClinicalData)" title="@(canManageClinicalData ? null : "Read-only access")"><i class="bi bi-exclamation-diamond me-1" aria-hidden="true"></i>Add Allergy</button>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#summaryMedicationModal" data-return-tab="summary"><i class="bi bi-capsule me-1" aria-hidden="true"></i>Add Medication</button>
                    <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#summaryDocumentModal" data-return-tab="summary" disabled="@(!canManageDocuments)" aria-disabled="@(!canManageDocuments)" title="@(canManageDocuments ? null : "Read-only access")"><i class="bi bi-file-earmark-plus me-1" aria-hidden="true"></i>New Document</button>
                </div>
                <div id="summaryQuickActionMessage" class="alert alert-warning d-none mt-3 mb-0" role="alert"></div>
            </div>
        </div>
        <div class="row g-3" id="cppSummaryCards">
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Active Problems</h4>@if(cpp.Problems.State=="Unavailable"){<p class="text-muted mb-0">Problem information is temporarily unavailable.</p>}else if(cpp.Problems.Items.Count==0){<p class="text-muted mb-0">No active problem records documented.</p>}else{@foreach(var item in cpp.Problems.Items){<div class="border-top py-2"><div class="fw-semibold">@item.DisplayName</div>@if(item.OnsetDate.HasValue){<small class="text-muted">Onset @item.OnsetDate.Value.ToString("MMM d, yyyy")</small>}</div>}@if(cpp.Problems.TotalCount>cpp.Problems.Items.Count){<small class="text-muted">+ @(cpp.Problems.TotalCount-cpp.Problems.Items.Count) more</small>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="problems">View all problems</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Active Allergies</h4>@if(cpp.Allergies.State=="Unavailable"){<p class="text-muted mb-0">Allergy information is temporarily unavailable.</p>}else if(cpp.Allergies.State=="ExplicitlyNone"){<p class="mb-0"><strong>No Known Allergies</strong></p>}else if(cpp.Allergies.Items.Count==0){<p class="text-muted mb-0">Allergy status not documented.</p>}else{@foreach(var item in cpp.Allergies.Items){<div class="border-top py-2"><div class="fw-semibold">@item.DisplayName</div><small>@string.Join(" · ",new[]{item.Reaction,item.Severity}.Where(x=>!string.IsNullOrWhiteSpace(x)))</small></div>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="allergies">View all allergies</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Active Medications</h4>@if(cpp.Medications.State=="Unavailable"){<p class="text-muted mb-0">Medication information is temporarily unavailable.</p>}else if(cpp.Medications.Items.Count==0){<p class="text-muted mb-0">Medication status not documented.</p>}else{@foreach(var item in cpp.Medications.Items){<div class="border-top py-2"><div class="fw-semibold">@item.DisplayName @item.Strength</div><small>@string.Join(" · ",new[]{item.Frequency,item.Route}.Where(x=>!string.IsNullOrWhiteSpace(x)))</small></div>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="medications">View medication list</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Current Prescriptions</h4><p class="small text-muted">Finalized prescribing records; not a reconciled medication list.</p>@if(cpp.Prescriptions.State=="Unavailable"){<p class="text-muted mb-0">Prescription information is temporarily unavailable.</p>}else if(cpp.Prescriptions.Items.Count==0){<p class="text-muted mb-0">No current finalized prescription records.</p>}else{@foreach(var item in cpp.Prescriptions.Items){<div class="border-top py-2"><div class="fw-semibold">@item.DisplayName</div><small>@item.PrescribedDate.ToString("MMM d, yyyy") · @item.Directions</small></div>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="medications">View prescriptions</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Recent Results</h4>@if(cpp.Results.State=="NotAuthorized"){<p class="text-muted mb-0">Restricted.</p>}else if(cpp.Results.State=="Unavailable"){<p class="text-muted mb-0">Result information is temporarily unavailable.</p>}else if(cpp.Results.Items.Count==0){<p class="text-muted mb-0">No current result records documented.</p>}else{@foreach(var item in cpp.Results.Items){<div class="border-top py-2"><div class="d-flex justify-content-between"><span class="fw-semibold">@item.Name</span><span class="badge text-bg-secondary">@item.Abnormality</span></div><small>@item.ResultDate.ToLocalTime().ToString("MMM d, yyyy") · @item.ReviewStatus · @item.Provenance</small></div>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="results">View all results</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Latest Vitals</h4>@if(cpp.Vitals.State=="Unavailable"){<p class="text-muted mb-0">Vitals are temporarily unavailable.</p>}else if(cpp.Vitals.Items.Count==0){<p class="text-muted mb-0">Vitals not documented.</p>}else{var v=cpp.Vitals.Items[0];<small class="text-muted">@v.RecordedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small><dl class="row mb-0 mt-2"><dt class="col-7">Blood pressure</dt><dd class="col-5">@(v.Systolic.HasValue&&v.Diastolic.HasValue?$"{v.Systolic}/{v.Diastolic}":"—")</dd><dt class="col-7">Heart rate</dt><dd class="col-5">@(v.HeartRate.HasValue?$"{v.HeartRate} bpm":"—")</dd><dt class="col-7">Weight / BMI</dt><dd class="col-5">@(v.WeightKg.HasValue?$"{v.WeightKg:0.##} kg":"—") / @(v.Bmi?.ToString("0.00")??"—")</dd><dt class="col-7">SpO2</dt><dd class="col-5">@(v.OxygenSaturation.HasValue?$"{v.OxygenSaturation}%":"—")</dd></dl>}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="vitals">View all vitals</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Recent Immunizations</h4>@if(cpp.Immunizations.State=="Unavailable"){<p class="text-muted mb-0">Immunization information is temporarily unavailable.</p>}else if(cpp.Immunizations.Items.Count==0){<p class="text-muted mb-0">No completed immunization records documented.</p>}else{@foreach(var item in cpp.Immunizations.Items){<div class="border-top py-2"><div class="fw-semibold">@item.VaccineName</div><small>@item.AdministrationDate.ToString("MMM d, yyyy") · @item.SourceType</small></div>}}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="immunizations">View immunization history</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Latest Signed Encounter</h4>@if(cpp.Encounters.State=="NotAuthorized"){<p class="text-muted mb-0">Restricted.</p>}else if(cpp.Encounters.State=="Unavailable"){<p class="text-muted mb-0">Encounter information is temporarily unavailable.</p>}else if(cpp.Encounters.Items.Count==0){<p class="text-muted mb-0">No signed encounter records documented.</p>}else{var e=cpp.Encounters.Items[0];<div class="fw-semibold">@e.Type</div><small>@e.EncounterDateUtc.ToLocalTime().ToString("MMM d, yyyy") · @(e.ProviderName??e.ReasonForVisit)</small>}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="encounters">View encounters</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Referrals</h4>@if(cpp.Referrals.State=="NotAuthorized"){<p class="text-muted mb-0">Restricted.</p>}else if(cpp.Referrals.State=="Unavailable"){<p class="text-muted mb-0">Referral information is temporarily unavailable.</p>}else if(cpp.Referrals.Items.Count==0){<p class="text-muted mb-0">No open referral records documented.</p>}else{var r=cpp.Referrals.Items[0];<div class="fw-semibold">@r.RecipientName</div><small>@r.Status · @cpp.Referrals.TotalCount open</small>}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="referrals">View referrals</button></div></div></div>
            <div class="col-12 col-lg-4"><div class="card h-100"><div class="card-body"><h4 class="h6">Recent Documents</h4>@if(cpp.Documents.State=="NotAuthorized"){<p class="text-muted mb-0">Restricted.</p>}else if(cpp.Documents.State=="Unavailable"){<p class="text-muted mb-0">Document information is temporarily unavailable.</p>}else if(cpp.Documents.Items.Count==0){<p class="text-muted mb-0">No document records available.</p>}else{var d=cpp.Documents.Items[0];<div class="fw-semibold">@d.Title</div><small>@d.DocumentType · @d.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small>}</div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="documents">View documents</button></div></div></div>
            <div class="col-12"><div class="card"><div class="card-body"><h4 class="h6">Past Medical and Surgical History</h4><div id="clinicalHistorySummary" class="text-muted">Loading history...</div></div><div class="card-footer bg-transparent"><button class="btn btn-sm btn-link px-0 summary-tab-link" data-tab-target="history">View Medical / Surgical History</button></div></div></div>
        </div>
    </div>
    <div class="tab-pane fade @(historyActive ? "show active" : null)" id="history" role="tabpanel">
        <div id="patientClinicalHistoryRoot" data-patient-uid="@patient.PatientUid" data-list-url="@Url.Action("List", "PatientClinicalHistory", new { patientUid = patient.PatientUid })" data-mutation-url="@Url.Action("List", "PatientClinicalHistory", new { patientUid = patient.PatientUid })" data-can-manage="@canManageClinicalData.ToString().ToLowerInvariant()">
            <div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Past Medical and Surgical History</h5><p class="text-body-secondary mb-0">Structured longitudinal history distinct from active problems.</p></div>@if(canManageClinicalData){<button id="addClinicalHistoryButton" class="btn btn-primary" type="button">Add History</button>}</div>
            <div id="clinicalHistoryMessage" class="alert d-none" role="alert"></div>
            <div class="d-flex justify-content-end mb-3"><select id="clinicalHistoryStatus" class="form-select form-select-sm w-auto"><option value="Active">Active</option><option value="Archived">Archived</option><option value="All">All</option></select></div>
            <div id="clinicalHistoryList" aria-live="polite">Loading history...</div>
        </div>
    </div>
    <div class="tab-pane fade @(immunizationsActive ? "show active" : null)" id="immunizations" role="tabpanel">
        <div id="patientImmunizationRoot" data-patient-uid="@patient.PatientUid" data-list-url="@Url.Action("List", "PatientImmunizations", new { patientUid = patient.PatientUid })" data-mutation-url="@Url.Action("List", "PatientImmunizations", new { patientUid = patient.PatientUid })" data-can-manage="@canManageClinicalData.ToString().ToLowerInvariant()">
            <div class="d-flex justify-content-between align-items-center mb-3"><div><h5 class="mb-1">Immunizations</h5><p class="text-body-secondary mb-0">Clinic-administered and historical immunization history.</p></div><button id="addImmunizationButton" class="btn btn-primary" type="button" disabled="@(!canManageClinicalData)" aria-disabled="@(!canManageClinicalData)">Add Immunization</button></div>
            <div id="immunizationMessage" class="alert alert-danger d-none" role="alert"></div>
            <div class="d-flex justify-content-end mb-3"><select id="immunizationStatusFilter" class="form-select form-select-sm w-auto"><option value="All">All</option><option value="Completed">Completed</option><option value="EnteredInError">Entered in error</option></select></div>
            <div id="immunizationList" aria-live="polite"><div class="microemr-loading-state" role="status"><span class="microemr-loading-spinner" aria-hidden="true"></span><span>Loading immunizations...</span></div></div>
        </div>
    </div>
    <div class="tab-pane fade @(timelineActive ? "show active" : null)" id="timeline" role="tabpanel">
        <partial name="_Timeline" model="Model.Timeline" />
    </div>
    <div class="tab-pane fade @(alertsActive ? "show active" : null)" id="alerts" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Chart Alerts</h5>
             <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="d-flex justify-content-end mb-1"><select id="chartAlertFilter" class="form-select w-auto"><option>Active</option><option>Resolved</option><option>All</option></select></div>
   
                <button id="addChartAlert" class="btn btn-primary">Add Alert</button></div>
             </div>
            
           <div id="chartAlertMessage" class="alert d-none"></div><div id="chartAlertList" aria-live="polite"><div class="microemr-loading-state" role="status"><span class="microemr-loading-spinner" aria-hidden="true"></span><span>Loading alerts...</span></div></div>
    </div>
    <div class="tab-pane fade @(tasksActive ? "show active" : null)" id="tasks" role="tabpanel">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <h5 class="mb-0">Tasks</h5>
             <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="d-flex justify-content-end mb-1">
                    <label class="visually-hidden" for="patientTaskFilter">Task status</label><select id="patientTaskFilter" class="form-select w-auto"><option>Open</option><option>Completed</option><option>All</option></select></div>
    
                <button id="addPatientTask" class="btn btn-primary" type="button">Add Task</button>
             </div>
            
        </div>
            <div id="patientTaskMessage" class="alert d-none" role="alert"></div><div id="patientTaskList" aria-live="polite"><div class="microemr-loading-state" role="status"><span class="microemr-loading-spinner" aria-hidden="true"></span><span>Loading tasks...</span></div></div>
    </div>
    <div class="tab-pane fade @(referralsActive ? "show active" : null)" id="referrals" role="tabpanel">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h5 class="mb-1">Referrals</h5>
                <p class="text-body-secondary mb-0">Outgoing referrals recorded for this patient.</p>
            </div>
            <button id="addPatientReferral" class="btn btn-primary" type="button" disabled="@(!Model.CanManageReferrals)">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Add Referral
            </button>
        </div>
        <div id="patientReferralMessage" class="alert d-none" role="alert"></div>
        <div id="patientReferralList" aria-live="polite">
            <div class="microemr-loading-state" role="status">
                <span class="microemr-loading-spinner" aria-hidden="true"></span>
                <span>Loading referrals...</span>
            </div>
        </div>
    </div>
    <div class="tab-pane fade @(demographicsActive ? "show active" : null)"
         id="demographics"
         role="tabpanel">

        <div class="content-panel">

            <div class="content-panel-header">
                <div>
                    <h3>@patient.FullName</h3>

                    <p>
                        Chart number:
                        <strong>@patient.ChartNumber</strong>
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Search" class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back
                    </a>

                    @if (canEditPatients)
                    {
                        <a asp-controller="Patients" asp-action="Edit" asp-route-patientUid="@patient.PatientUid"
                           class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary" disabled aria-disabled="true"
                                title="Read-only access"><i class="bi bi-pencil me-1"></i>Edit</button>
                    }
                </div>
            </div>

            <div class="row g-4 mt-1">

                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h5 class="mb-3">Demographics</h5>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Legal name</dt>
                            <dd class="col-sm-7">@patient.FullName</dd>

                            <dt class="col-sm-5">Preferred name</dt>
                            <dd class="col-sm-7">
                                @(patient.PreferredName ?? "—")
                            </dd>

                            <dt class="col-sm-5">Date of birth</dt>
                            <dd class="col-sm-7">
                                @patient.DateOfBirth.ToString("MMMM d, yyyy")
                            </dd>

                            <dt class="col-sm-5">Sex at birth</dt>
                            <dd class="col-sm-7">
                                @(patient.SexAtBirth ?? "—")
                            </dd>

                            <dt class="col-sm-5">Gender identity</dt>
                            <dd class="col-sm-7">
                                @(patient.GenderIdentity ?? "—")
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h5 class="mb-3">Health card</h5>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Number</dt>
                            <dd class="col-sm-7">
                                @(patient.HealthCardNumber ?? "—")
                            </dd>

                            <dt class="col-sm-5">Version</dt>
                            <dd class="col-sm-7">
                                @(patient.HealthCardVersion ?? "—")
                            </dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7">
                                @if (patient.IsActive)
                                {
                                    <span class="badge text-bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h5 class="mb-3">Contact</h5>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Phone</dt>
                            <dd class="col-sm-7">
                                @(patient.PhoneNumber ?? "—")
                            </dd>

                            <dt class="col-sm-5">Alternate phone</dt>
                            <dd class="col-sm-7">
                                @(patient.AlternatePhoneNumber ?? "—")
                            </dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7">
                                @(patient.Email ?? "—")
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h5 class="mb-3">Address</h5>

                        <address class="mb-0">
                            @if (!string.IsNullOrWhiteSpace(patient.AddressLine1))
                            {
                                <div>@patient.AddressLine1</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(patient.AddressLine2))
                            {
                                <div>@patient.AddressLine2</div>
                            }

                            <div>
                                @string.Join(
                                    ", ",
                                    new[]
                                    {
                                patient.City,
                                patient.Province
                                    }
                                    .Where(x =>
                                        !string.IsNullOrWhiteSpace(x)))
                            </div>

                            <div>@patient.PostalCode</div>
                            <div>@patient.CountryCode</div>
                        </address>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="tab-pane fade @(documentsActive ? "show active" : null)"
         id="documents"
         role="tabpanel">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Patient Documents</h5>

            <button type="button" id="newDocumentButton" class="btn btn-primary" disabled="@(!canManageDocuments)" aria-disabled="@(!canManageDocuments)" title="@(canManageDocuments ? null : "Read-only access")"
                    data-bs-toggle="modal" data-bs-target="#summaryDocumentModal" data-return-tab="documents">
                <i class="bi bi-file-earmark-plus me-1"></i>
                New Document
            </button>
        </div>

        @if (Model.Documents.Count == 0)
        {
            <div class="microemr-empty-state">
                <div class="microemr-empty-state__icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="microemr-empty-state__title">No documents recorded</div>
                <div class="microemr-empty-state__text">Clinical documents created for this patient will appear here.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Created by</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var document in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <strong>@document.Title</strong>
                                </td>

                                <td>@document.DocumentType</td>

                                <td>
                                    @if (string.Equals(
                                        document.Status,
                                        "Draft",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-warning">
                                            Draft
                                        </span>
                                    }
                                    else if (string.Equals(
                                        document.Status,
                                        "Signed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-success">
                                            Signed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @document.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @document.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                </td>

                                <td>
                                    @(document.CreatedByDisplayName
                                        ?? "Unknown")
                                </td>

                                <td class="text-end">
                                    <a asp-controller="PatientDocuments"
                                           asp-action="Details"
                                           asp-route-documentUid="@document.DocumentUid"
                                           class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="tab-pane fade @(filesActive ? "show active" : null)" id="files" role="tabpanel">
        <div id="patientFilesRoot"
             data-patient-uid="@patient.PatientUid"
             data-list-url="@Url.Action("List", "PatientFiles", new { patientUid = patient.PatientUid })"
             data-details-url-root="@Url.Action("List", "PatientFiles", new { patientUid = patient.PatientUid })"
             data-upload-url="@Url.Action("Upload", "PatientFiles", new { patientUid = patient.PatientUid })"
             data-content-url-root="@Url.Action("List", "PatientFiles", new { patientUid = patient.PatientUid })"
             data-can-manage="@canManageDocuments.ToString().ToLowerInvariant()">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <div><h5 class="mb-1">Patient Files</h5><p class="text-body-secondary mb-0">Files uploaded to this patient chart.</p></div>
                @if (canManageDocuments)
                {
                    <button id="uploadPatientFileButton" class="btn btn-primary" type="button"><i class="bi bi-upload me-1" aria-hidden="true"></i>Upload File</button>
                }
            </div>
            <div id="patientFileMessage" class="alert d-none" role="alert"></div>
            <div id="patientFileList" aria-live="polite"><div class="microemr-loading-state" role="status"><span class="microemr-loading-spinner" aria-hidden="true"></span><span>Loading files...</span></div></div>
        </div>
    </div>

    <div class="tab-pane fade @(encountersActive ? "show active" : null)"
         id="encounters"
         role="tabpanel">

        <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
            <h5 class="mb-0">Patient Encounters</h5>
            <div class="d-flex gap-2 flex-wrap">
            <form asp-controller="PatientEncounters" asp-action="PrintHistory" method="get" target="_blank" class="d-flex gap-2 align-items-end flex-wrap">
                <input type="hidden" name="patientUid" value="@patient.PatientUid" />
                <div><label for="encounterPrintStartDate" class="form-label small mb-1">From</label><input id="encounterPrintStartDate" name="startDate" type="date" class="form-control form-control-sm" required /></div>
                <div><label for="encounterPrintEndDate" class="form-label small mb-1">To</label><input id="encounterPrintEndDate" name="endDate" type="date" class="form-control form-control-sm" required /></div>
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer me-1" aria-hidden="true"></i>Print History</button>
            </form>
            <button type="button" id="newEncounterButton" class="btn btn-primary align-self-end" disabled="@(!canEditEncounters)" aria-disabled="@(!canEditEncounters)" title="@(canEditEncounters ? null : "Read-only access")"
                    data-bs-toggle="modal" data-bs-target="#createEncounterModal" data-return-tab="encounters">
                <i class="bi bi-plus-circle me-1"></i>
                New Encounter
            </button>
            </div>
        </div>

        @if (Model.Encounters.Count == 0)
        {
            <div class="microemr-empty-state">
                <div class="microemr-empty-state__icon"><i class="bi bi-journal-medical"></i></div>
                <div class="microemr-empty-state__title">No encounters recorded</div>
                <div class="microemr-empty-state__text">Encounter notes created for this patient will appear here.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Reason</th>
                            <th>Provider</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var encounter in Model.Encounters)
                        {
                            <tr>
                                <td>
                                    @encounter.EncounterDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                </td>

                                <td>@encounter.EncounterType</td>

                                <td>
                                    @(encounter.ReasonForVisit ?? "—")
                                </td>

                                <td>
                                    @(encounter.ProviderName ?? "—")
                                </td>

                                <td>
                                    @(encounter.LocationName ?? "—")
                                </td>

                                <td>
                                    @if (string.Equals(
                                        encounter.Status,
                                        "Open",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-primary">
                                            Open
                                        </span>
                                    }
                                    else if (string.Equals(
                                        encounter.Status,
                                        "Closed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-secondary">
                                            Closed
                                        </span>
                                    }
                                    else if (string.Equals(
                                        encounter.Status,
                                        "Cancelled",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @encounter.Status
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary open-encounter-button"
                                            data-patient-uid="@encounter.PatientUid"
                                            data-encounter-uid="@encounter.EncounterUid">
                                        View
                                    </button>
                                    <a asp-controller="PatientEncounters"
                                       asp-action="Details"
                                       asp-route-encounterUid="@encounter.EncounterUid"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="tab-pane fade @(problemsActive ? "show active" : null)" id="problems" role="tabpanel">
        <div id="patient-problems-root"
             data-patient-uid="@patient.PatientUid"
             data-create-url="@Url.Action("CreateProblem", "PatientProblems")"
             data-update-url="@Url.Action("UpdateProblem", "PatientProblems")"
             data-resolve-url="@Url.Action("ResolveProblem", "PatientProblems")"
             data-refresh-url="@Url.Action("Details", "Patients", new { patientUid = patient.PatientUid, tab = "problems" })"
             data-summary-refresh-url="@Url.Action("Details", "Patients", new { patientUid = patient.PatientUid, tab = "summary" })"></div>
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h5 class="mb-0">Problems</h5>
            <div class="d-flex align-items-center gap-2">
                <label for="problemStatusFilter" class="form-label mb-0">Show</label>
                <select id="problemStatusFilter" class="form-select form-select-sm" aria-label="Filter problems by status">
                    <option value="Active" selected>Active</option>
                    <option value="Resolved">Resolved</option>
                    <option value="All">All</option>
                </select>
                <button type="button" id="addProblemButton" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i>Add Problem
                </button>
            </div>
        </div>

        <div id="problemPageMessage" class="alert d-none" role="alert"></div>
        <div id="problemEmptyState" class="microemr-empty-state d-none">
            <div class="microemr-empty-state__icon"><i class="bi bi-clipboard2-pulse"></i></div>
            <span class="microemr-empty-state__title">No active problems recorded</span>
            <div class="microemr-empty-state__text">Problems added to this chart will appear here.</div>
        </div>
        <div id="problemTableContainer" class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Problem</th><th>Description</th><th>Onset Date</th><th>Status</th><th>Resolved info</th><th class="text-end">Actions</th></tr></thead>
                <tbody id="problemTableBody">
                @foreach (var problem in Model.Problems)
                {
                    <tr data-problem-status="@problem.ProblemStatus"
                        data-problem-uid="@problem.PatientProblemUid"
                        data-problem-name="@problem.ProblemName"
                        data-problem-description="@problem.ProblemDescription"
                        data-problem-onset="@(problem.OnsetDate?.ToString("yyyy-MM-dd") ?? "")">
                        <td><strong>@problem.ProblemName</strong></td>
                        <td>@(problem.ProblemDescription ?? "—")</td>
                        <td>@(problem.OnsetDate?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td><span class="badge @(problem.ProblemStatus == "Active" ? "text-bg-success" : "text-bg-secondary")">@problem.ProblemStatus</span></td>
                        <td>
                            @if (problem.ResolvedAt.HasValue)
                            {
                                <div>@problem.ResolvedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</div>
                                <div class="small text-muted">@(problem.ResolvedByDisplayName ?? "Unknown user")</div>
                                @if (!string.IsNullOrWhiteSpace(problem.ResolutionReason)) { <div class="small">@problem.ResolutionReason</div> }
                            }
                            else { <span>—</span> }
                        </td>
                        <td class="text-end">
                            @if (string.Equals(problem.ProblemStatus, "Active", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary edit-problem-button">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger resolve-problem-button">Resolve</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade @(allergiesActive ? "show active" : null)"
         id="allergies"
         role="tabpanel">

        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h5 class="mb-0">Patient Allergies</h5>
            <div class="d-flex align-items-center gap-2">
                <label for="allergyStatusFilter" class="form-label mb-0">Show</label>
                <select id="allergyStatusFilter" class="form-select form-select-sm" aria-label="Filter allergies by status">
                    <option value="Active" selected>Active</option>
                    <option value="Resolved">Resolved</option>
                    <option value="All">All</option>
                </select>
                <button type="button" id="addAllergyButton" class="btn btn-primary text-nowrap"
                        data-bs-toggle="modal" data-bs-target="#summaryAllergyModal" data-return-tab="allergies"
                        disabled="@(!canManageClinicalData)" aria-disabled="@(!canManageClinicalData)" title="@(canManageClinicalData ? null : "Read-only access")">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Allergy
                </button>
            </div>
        </div>

        @if (Model.AllergyDocumentationState?.State == "ExplicitlyNone" && Model.AllergyDocumentationState.NoKnownAllergies is { } nka)
        {
            <div class="alert alert-success d-flex justify-content-between align-items-center gap-3">
                <div><strong>No Known Allergies</strong><br /><span class="small">Verified by @nka.VerifiedByDisplayName on @nka.VerifiedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span></div>
                <form asp-controller="PatientAllergies" asp-action="RevokeNoKnownAllergies" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="patientUid" value="@Model.Patient.PatientUid" />
                    <input type="hidden" name="rowVersion" value="@nka.RowVersion" />
                    <input type="hidden" name="reason" value="Revoked from Patient Chart" />
                    <button class="btn btn-sm btn-outline-danger" disabled="@(!Model.CanManageClinicalData)">Revoke NKA</button>
                </form>
            </div>
        }
        else if (Model.AllergyDocumentationState?.State == "NotDocumented")
        {
            <div class="alert alert-secondary d-flex justify-content-between align-items-center">
                <span>Allergy status not documented</span>
                <form asp-controller="PatientAllergies" asp-action="AssertNoKnownAllergies" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="patientUid" value="@Model.Patient.PatientUid" />
                    <button class="btn btn-sm btn-outline-primary" disabled="@(!Model.CanManageClinicalData)">Document No Known Allergies</button>
                </form>
            </div>
        }

        <div id="allergyEmptyState" class="microemr-empty-state d-none">
            <div class="microemr-empty-state__icon"><i class="bi bi-exclamation-triangle"></i></div>
            <span class="microemr-empty-state__title">No active allergies recorded</span>
            <div class="microemr-empty-state__text">Allergies added to this chart will appear here.</div>
        </div>

        @if (Model.Allergies.Count > 0)
        {
            <div id="allergyTableContainer" class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Allergen</th>
                            <th>Type</th>
                            <th>Reaction</th>
                            <th>Severity</th>
                            <th>Onset</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var allergy in Model.Allergies)
                        {
                            <tr data-allergy-status="@allergy.Status">
                                <td>
                                    <strong>@allergy.AllergenName</strong>
                                </td>

                                <td>
                                    @(allergy.AllergenType ?? "—")
                                </td>

                                <td>
                                    @(allergy.Reaction ?? "—")
                                </td>

                                <td>
                                    @if (string.Equals(
                                        allergy.Severity,
                                        "Severe",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-danger">
                                            Severe
                                        </span>
                                    }
                                    else if (string.Equals(
                                        allergy.Severity,
                                        "Moderate",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-warning">
                                            Moderate
                                        </span>
                                    }
                                    else if (string.Equals(
                                        allergy.Severity,
                                        "Mild",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-info">
                                            Mild
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @(allergy.Severity ?? "Unknown")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(allergy.OnsetDate.HasValue
                                        ? allergy.OnsetDate.Value.ToString("MMM d, yyyy")
                                        : "—")
                                </td>

                                <td>
                                    @if (string.Equals(
                                        allergy.Status,
                                        "Active",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (string.Equals(
                                        allergy.Status,
                                        "Inactive",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                    else if (string.Equals(
                                        allergy.Status,
                                        "EnteredInError",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-danger">
                                            Entered In Error
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @allergy.Status
                                        </span>
                                    }
                                    @if (!string.Equals(allergy.Status, "Active", StringComparison.OrdinalIgnoreCase)
                                        && allergy.UpdatedAt.HasValue)
                                    {
                                        <div class="small text-muted mt-1">
                                            Resolved @allergy.UpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")
                                        </div>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (string.Equals(allergy.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger resolve-allergy-button"
                                                data-patient-uid="@allergy.PatientUid" data-allergy-uid="@allergy.AllergyUid">
                                            Resolve Allergy
                                        </button>
                                        <a asp-controller="PatientAllergies"
                                           asp-action="Edit"
                                           asp-route-allergyUid="@allergy.AllergyUid"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                    }
                                    <a asp-controller="PatientAllergies"
                                       asp-action="Details"
                                       asp-route-allergyUid="@allergy.AllergyUid"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="tab-pane fade @(medicationsActive ? "show active" : null)"
         id="medications"
         role="tabpanel">

        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h5 class="mb-0">Current Medications</h5>
            <div class="d-flex align-items-center gap-2">
                <label for="medicationStatusFilter" class="form-label mb-0">Show</label>
                <select id="medicationStatusFilter" class="form-select form-select-sm" aria-label="Filter medications by status">
                    <option value="Active" selected>Active</option>
                    <option value="Discontinued">Discontinued</option>
                    <option value="All">All</option>
                </select>
                <button type="button" id="addMedicationButton" class="btn btn-primary text-nowrap"
                        data-bs-toggle="modal" data-bs-target="#summaryMedicationModal" data-return-tab="medications">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Medication
                </button>
            </div>
        </div>

        <div id="medicationEmptyState" class="microemr-empty-state d-none">
            <div class="microemr-empty-state__icon"><i class="bi bi-capsule"></i></div>
            <span class="microemr-empty-state__title">No active medications recorded</span>
            <div class="microemr-empty-state__text">Active medications will appear here.</div>
        </div>

        @if (Model.Medications.Count > 0)
        {
            <div id="medicationTableContainer" class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Medication</th>
                            <th>Strength</th>
                            <th>Directions</th>
                            <th>Frequency</th>
                            <th>Start</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var medication in Model.Medications)
                        {
                            <tr data-medication-status="@medication.Status">
                                <td>
                                    <strong>@medication.MedicationName</strong>
                                </td>

                                <td>
                                    @(medication.Strength ?? "—")
                                </td>

                                <td>
                                    @(medication.Directions ?? "—")
                                </td>

                                <td>
                                    @(medication.Frequency ?? "—")
                                </td>

                                <td>
                                    @(medication.StartDate.HasValue
                                        ? medication.StartDate.Value.ToString("MMM d, yyyy")
                                        : "—")
                                </td>

                                <td>
                                    @if (string.Equals(
                                        medication.Status,
                                        "Active",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (string.Equals(
                                        medication.Status,
                                        "Inactive",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                    else if (string.Equals(
                                        medication.Status,
                                        "Discontinued",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-warning">
                                            Discontinued
                                        </span>
                                    }
                                    else if (string.Equals(
                                        medication.Status,
                                        "EnteredInError",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge text-bg-danger">
                                            Entered In Error
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            @medication.Status
                                        </span>
                                    }
                                    @if (!string.Equals(medication.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        if (medication.EndDate.HasValue)
                                        {
                                            <div class="small text-muted mt-1">
                                                Discontinued @medication.EndDate.Value.ToString("MMM d, yyyy")
                                            </div>
                                        }
                                        else if (medication.UpdatedAt.HasValue)
                                        {
                                            <div class="small text-muted mt-1">
                                                Discontinued @medication.UpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")
                                            </div>
                                        }
                                    }
                                </td>

                                <td class="text-end">
                                    @if (string.Equals(medication.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger discontinue-medication-button"
                                                data-patient-uid="@medication.PatientUid"
                                                data-medication-uid="@medication.MedicationUid">
                                            Discontinue
                                        </button>
                                        <a asp-controller="PatientMedications"
                                           asp-action="Edit"
                                           asp-route-medicationUid="@medication.MedicationUid"
                                           class="btn btn-sm btn-outline-secondary">Edit</a>
                                    }
                                    <a asp-controller="PatientMedications"
                                       asp-action="Details"
                                       asp-route-medicationUid="@medication.MedicationUid"
                                       class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <hr class="my-4" />
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><h5 class="mb-1">Prescriptions</h5><div class="text-muted small">Local structured prescriptions are maintained separately from the medication list.</div></div>
            @if (Model.CanPrescribe) { <a asp-controller="PatientPrescriptions" asp-action="Create" asp-route-patientUid="@patient.PatientUid" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Prescription</a> }
            else { <button class="btn btn-primary" disabled title="Prescriptions.Prescribe permission is required.">New Prescription</button> }
        </div>
        @if (Model.Prescriptions.Count == 0) { <div class="microemr-empty-state"><div class="microemr-empty-state__icon"><i class="bi bi-prescription2"></i></div><div class="microemr-empty-state__title">No prescriptions recorded</div></div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Date</th><th>Medication</th><th>Directions</th><th>Quantity</th><th>Repeats</th><th>Prescriber</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach(var rx in Model.Prescriptions) { <tr><td>@rx.PrescribedDate.ToString("MMM d, yyyy")</td><td><strong>@(rx.ProductDisplaySnapshot ?? rx.ProductDisplayText)</strong></td><td>@rx.Directions</td><td>@rx.Quantity.ToString("0.###") @rx.QuantityUnit</td><td>@rx.AuthorizedRepeats</td><td>@(rx.PrescriberDisplayNameSnapshot ?? "Draft")</td><td><span class="badge text-bg-@(rx.Status=="Finalized"?"success":rx.Status=="Draft"?"secondary":"warning")">@rx.Status</span></td><td class="text-end text-nowrap">
          @if(rx.Status=="Draft" && Model.CanPrescribe){<a asp-controller="PatientPrescriptions" asp-action="Edit" asp-route-patientUid="@patient.PatientUid" asp-route-prescriptionUid="@rx.PrescriptionUid" class="btn btn-sm btn-outline-secondary">Edit</a><form class="d-inline" asp-controller="PatientPrescriptions" asp-action="Finalize" method="post"><input type="hidden" name="patientUid" value="@patient.PatientUid"/><input type="hidden" name="prescriptionUid" value="@rx.PrescriptionUid"/><input type="hidden" name="rowVersion" value="@rx.RowVersion"/><button class="btn btn-sm btn-primary" onclick="return confirm('Finalize this prescription? It cannot be edited afterward.');">Finalize Prescription</button></form>}
          @if(rx.ArtifactUid.HasValue){<a asp-controller="PatientPrescriptions" asp-action="Artifact" asp-route-patientUid="@patient.PatientUid" asp-route-prescriptionUid="@rx.PrescriptionUid" class="btn btn-sm btn-outline-primary">View/Print</a>}
          @if(rx.Status=="Finalized" && Model.CanPrescribe){<form class="d-inline" asp-controller="PatientPrescriptions" asp-action="Correction" method="post"><input type="hidden" name="patientUid" value="@patient.PatientUid"/><input type="hidden" name="prescriptionUid" value="@rx.PrescriptionUid"/><input type="hidden" name="rowVersion" value="@rx.RowVersion"/><button class="btn btn-sm btn-outline-secondary">Create Correction</button></form><form class="d-inline" asp-controller="PatientPrescriptions" asp-action="Cancel" method="post"><input type="hidden" name="patientUid" value="@patient.PatientUid"/><input type="hidden" name="prescriptionUid" value="@rx.PrescriptionUid"/><input type="hidden" name="rowVersion" value="@rx.RowVersion"/><input type="hidden" name="reason" value="Cancelled by prescriber"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this prescription? The record and artifact will be retained.');">Cancel Prescription</button></form>}
        </td></tr> }
        </tbody></table></div> }
    </div>
    <div class="tab-pane fade @(vitalsActive ? "show active" : null)" id="vitals" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Vitals</h5><button type="button" id="addVitalButton" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Vitals</button></div>
        <div id="vitalPageMessage" class="alert d-none" role="alert"></div>
        @if (Model.Vitals.Count == 0) { <div class="microemr-empty-state"><div class="microemr-empty-state__icon"><i class="bi bi-heart-pulse"></i></div><div class="microemr-empty-state__title">No vitals recorded</div><div class="microemr-empty-state__text">Vitals added to this chart will appear here.</div></div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Recorded</th><th>Blood Pressure</th><th>Heart Rate</th><th>Resp. Rate</th><th>Temperature</th><th>SpO2</th><th>Height</th><th>Weight</th><th>BMI</th><th>Notes</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach (var vital in Model.Vitals) {
            <tr class="vital-row" data-vital-uid="@vital.PatientVitalUid" data-row-version="@vital.RowVersion" data-recorded-at="@vital.RecordedAt.ToString("yyyy-MM-ddTHH:mm")" data-systolic="@vital.BloodPressureSystolic" data-diastolic="@vital.BloodPressureDiastolic" data-heart-rate="@vital.HeartRate" data-respiratory-rate="@vital.RespiratoryRate" data-temperature="@vital.TemperatureCelsius" data-oxygen="@vital.OxygenSaturation" data-height="@vital.HeightCm" data-weight="@vital.WeightKg" data-notes="@vital.Notes">
             <td>@vital.RecordedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td><td>@(vital.BloodPressureSystolic.HasValue && vital.BloodPressureDiastolic.HasValue ? $"{vital.BloodPressureSystolic}/{vital.BloodPressureDiastolic}" : "—")</td><td>@(vital.HeartRate?.ToString() ?? "—")</td><td>@(vital.RespiratoryRate?.ToString() ?? "—")</td><td>@(vital.TemperatureCelsius.HasValue ? $"{vital.TemperatureCelsius:0.##} °C" : "—")</td><td>@(vital.OxygenSaturation.HasValue ? $"{vital.OxygenSaturation}%" : "—")</td><td>@(vital.HeightCm.HasValue ? $"{vital.HeightCm:0.##} cm" : "—")</td><td>@(vital.WeightKg.HasValue ? $"{vital.WeightKg:0.##} kg" : "—")</td><td>@(vital.Bmi?.ToString("0.00") ?? "—")</td><td class="text-break">@(vital.Notes ?? "—")</td><td class="text-end"><button type="button" class="btn btn-sm btn-outline-secondary edit-vital-button">Edit</button></td>
            </tr> }
        </tbody></table></div> }
    </div>
    <div class="tab-pane fade @(resultsActive ? "show active" : null)" id="results" role="tabpanel"><div class="d-flex justify-content-between mb-3"><h5>Results</h5><button id="addPatientResult" class="btn btn-primary" disabled="@(canManageClinicalData ? null : "disabled")">Add Result</button></div><div class="d-flex justify-content-end mb-3"><select id="patientResultFilter" class="form-select w-auto"><option>New</option><option>Reviewed</option><option>All</option></select></div><div id="patientResultList" data-can-manage="@canManageClinicalData.ToString().ToLowerInvariant()" aria-live="polite"><div class="microemr-loading-state" role="status"><span class="microemr-loading-spinner" aria-hidden="true"></span><span>Loading results...</span></div></div></div>
</div>

<div class="modal fade" id="chartAlertModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Chart Alert</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="chartAlertForm"><input type="hidden" name="PatientUid" value="@patient.PatientUid"/><input type="hidden" name="PatientChartAlertUid"/><div class="mb-3"><label class="form-label">Alert Title</label><input name="AlertTitle" maxlength="200" required class="form-control"/></div><div class="mb-3"><label class="form-label">Alert Message</label><textarea name="AlertMessage" maxlength="1000" rows="3" class="form-control"></textarea></div><div class="row"><div class="col"><label class="form-label">Type</label><select name="AlertType" class="form-select">@foreach(var x in new[]{"General","Clinical","Administrative","Safety","Scheduling"}){<option>@x</option>}</select></div><div class="col"><label class="form-label">Priority</label><select name="AlertPriority" class="form-select">@foreach(var x in new[]{"Low","Normal","High","Critical"}){<option selected="@(x=="Normal")">@x</option>}</select></div></div></form><div id="chartAlertModalMessage" class="alert alert-danger d-none mt-3"></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button id="saveChartAlert" class="btn btn-primary">Save Alert</button></div></div></div></div>

<div class="modal fade" id="patientTaskModal" tabindex="-1" aria-labelledby="patientTaskModalTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="patientTaskModalTitle">Add Task</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="patientTaskForm"><input type="hidden" name="PatientUid" value="@patient.PatientUid"/><input type="hidden" name="PatientTaskUid"/><div class="mb-3"><label class="form-label" for="patientTaskTitle">Task Title</label><input id="patientTaskTitle" name="TaskTitle" maxlength="200" required class="form-control"/><div class="invalid-feedback">Task title is required.</div></div><div class="mb-3"><label class="form-label" for="patientTaskDescription">Description</label><textarea id="patientTaskDescription" name="TaskDescription" maxlength="1000" rows="3" class="form-control"></textarea></div><div class="row g-3"><div class="col-12 col-sm-6"><label class="form-label" for="patientTaskType">Type</label><select id="patientTaskType" name="TaskType" class="form-select">@foreach(var x in new[]{"General","Follow-up","Call Patient","Review Result","Form","Referral","Booking"}){<option>@x</option>}</select></div><div class="col-12 col-sm-6"><label class="form-label" for="patientTaskPriority">Priority</label><select id="patientTaskPriority" name="TaskPriority" class="form-select">@foreach(var x in new[]{"Low","Normal","High","Urgent"}){<option selected="@(x=="Normal")">@x</option>}</select></div><div class="col-12"><label class="form-label" for="patientTaskDueAt">Due Date/Time</label><input id="patientTaskDueAt" name="DueAt" type="datetime-local" class="form-control"/></div></div></form><div id="patientTaskModalMessage" class="alert alert-danger d-none mt-3"></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="savePatientTask" class="btn btn-primary">Save Task</button></div></div></div></div>
<div class="modal fade" id="completePatientTaskModal" tabindex="-1" aria-labelledby="completePatientTaskTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="completePatientTaskTitle">Complete Task</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="completePatientTaskForm"><input type="hidden" name="PatientUid" value="@patient.PatientUid"/><input type="hidden" name="PatientTaskUid"/><label class="form-label" for="taskCompletionNote">Completion Note</label><textarea id="taskCompletionNote" name="CompletionNote" maxlength="1000" rows="4" class="form-control"></textarea></form><div id="completePatientTaskMessage" class="alert alert-danger d-none mt-3"></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="confirmCompletePatientTask" class="btn btn-success">Complete Task</button></div></div></div></div>
<div class="modal fade" id="resolveChartAlertModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Resolve Alert</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="resolveChartAlertForm"><input type="hidden" name="PatientUid" value="@patient.PatientUid"/><input type="hidden" name="PatientChartAlertUid"/><label class="form-label">Resolution Reason</label><textarea name="ResolutionReason" maxlength="500" class="form-control" rows="3"></textarea></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button id="confirmResolveChartAlert" class="btn btn-primary">Resolve</button></div></div></div></div>
<form id="chartAlertAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
<form id="patientTaskAntiforgery" class="d-none">@Html.AntiForgeryToken()</form>
