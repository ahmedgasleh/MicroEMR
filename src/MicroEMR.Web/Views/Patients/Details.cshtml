<script type="module" src="~/dist/patients/patient-chart-header.js" asp-append-version="true"></script>
<div class="modal fade" id="clinicalHistoryModal" tabindex="-1" aria-labelledby="clinicalHistoryModalTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="clinicalHistoryModalTitle">Add History</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="clinicalHistoryForm">@Html.AntiForgeryToken()<input type="hidden" name="HistoryUid"/><input type="hidden" name="RowVersion"/><div class="mb-3"><label class="form-label" for="clinicalHistoryType">History type</label><select class="form-select" id="clinicalHistoryType" name="HistoryType" required><option value="Medical">Medical</option><option value="Surgical">Surgical</option></select></div><div class="mb-3"><label class="form-label" for="clinicalHistoryDescription">Description</label><textarea class="form-control" id="clinicalHistoryDescription" name="Description" maxlength="1000" required rows="3"></textarea></div><div><label class="form-label" for="clinicalHistoryDate">Relevant date</label><input class="form-control" id="clinicalHistoryDate" name="RelevantDate" type="date"/></div><div id="clinicalHistoryEditorMessage" class="alert alert-danger d-none mt-3"></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveClinicalHistoryButton" type="button">Save</button></div></div></div></div>
<div class="modal fade" id="immunizationModal" tabindex="-1" aria-labelledby="immunizationModalTitle" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="immunizationModalTitle">Add Immunization</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="immunizationForm">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion"/><div id="immunizationEditorMessage" class="alert alert-danger d-none"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Vaccine name</label><input class="form-control" name="VaccineName" maxlength="200" required/></div><div class="col-md-4"><label class="form-label">Administration date</label><input class="form-control" name="AdministrationDate" type="date" required/></div><div class="col-md-6"><label class="form-label">Source</label><select class="form-select" name="SourceType" required><option value="ClinicAdministered">Clinic administered</option><option value="HistoricalExternal">Historical / external</option></select></div><div class="col-md-6"><label class="form-label">Administered by</label><input class="form-control" name="AdministeredByName" maxlength="200"/></div><div class="col-md-3"><label class="form-label">Dose number</label><input class="form-control" name="DoseNumber" type="number" min="1"/></div><div class="col-md-3"><label class="form-label">Route</label><input class="form-control" name="Route" maxlength="100"/></div><div class="col-md-3"><label class="form-label">Site</label><input class="form-control" name="Site" maxlength="100"/></div><div class="col-md-3"><label class="form-label">Lot number</label><input class="form-control" name="LotNumber" maxlength="100"/></div><div class="col-md-6"><label class="form-label">Source description</label><input class="form-control" name="SourceDescription" maxlength="500"/></div><div class="col-md-6"><label class="form-label">Encounter UID</label><input class="form-control" name="EncounterUid" placeholder="Optional"/></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="Notes" maxlength="1000" rows="3"></textarea></div></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveImmunizationButton" type="button">Save</button></div></div></div></div>
<div class="modal fade" id="immunizationErrorModal" tabindex="-1" aria-labelledby="immunizationErrorTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="immunizationErrorTitle">Mark entered in error</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="immunizationErrorForm">@Html.AntiForgeryToken()<input type="hidden" name="ImmunizationUid"/><input type="hidden" name="RowVersion"/><label class="form-label">Reason</label><textarea class="form-control" name="Reason" maxlength="500" required rows="3"></textarea><div id="immunizationErrorMessage" class="alert alert-danger d-none mt-3"></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" id="confirmImmunizationErrorButton" type="button">Mark entered in error</button></div></div></div></div>
