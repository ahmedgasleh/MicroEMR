                        <div class="col-12 col-md-6"><label for="referralRecipientName" class="form-label">Recipient Name <span class="text-danger">*</span></label><input id="referralRecipientName" name="RecipientName" class="form-control" maxlength="200" required autocomplete="off" /><div class="invalid-feedback">Recipient name is required.</div></div>
                        <div class="col-12 col-md-6"><label for="referralOrganization" class="form-label">Organization</label><input id="referralOrganization" name="RecipientOrganization" class="form-control" maxlength="200" autocomplete="organization" /></div>
