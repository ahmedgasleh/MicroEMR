            const token = document.querySelector('#medicationAntiforgeryForm input[name="__RequestVerificationToken"]').value;
            const response = await fetch('@Url.Action("DiscontinueMedication", "PatientMedications")', { method: "POST", headers: { "RequestVerificationToken": token }, body: data });
            const result = await response.json().catch(() => ({}));
