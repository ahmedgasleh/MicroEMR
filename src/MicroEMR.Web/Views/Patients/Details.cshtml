<script>
document.addEventListener("DOMContentLoaded", () => {
 const canEditEncounters = @Json.Serialize(canEditEncounters);
 const modal = document.getElementById("createEncounterModal");
 const form = document.getElementById("summaryCreateEncounterForm");
 const dateInput = document.getElementById("summaryEncounterDateLocal");
 const saveButton = document.getElementById("summarySaveEncounterButton");
 modal?.addEventListener("show.bs.modal", event => {
  form?.reset();
  const trigger = event.relatedTarget;
  const returnTab = form?.querySelector('input[name="ReturnTab"]');
  if (returnTab) returnTab.value = trigger?.dataset.returnTab === "summary" ? "summary" : "encounters";
  const now = new Date(Date.now() - new Date().getTimezoneOffset() * 60000);
  if (dateInput) dateInput.value = now.toISOString().slice(0, 16);
   if (saveButton) { saveButton.disabled = !canEditEncounters; saveButton.innerHTML = '<i class="bi bi-save me-1" aria-hidden="true"></i>Save'; }
 });
 form?.addEventListener("submit", event => {
  if (!form.checkValidity()) { event.preventDefault(); form.reportValidity(); return; }
  if (saveButton) { saveButton.disabled = true; saveButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...'; }
 });
});

document.addEventListener("DOMContentLoaded", () => {
    const canEditEncounters = @Json.Serialize(canEditEncounters);
    const canSignEncounters = @Json.Serialize(canSignEncounters);
    const modalElement = document.getElementById("encounterDetailsModal");
    const modal = new bootstrap.Modal(modalElement);
    const loading = document.getElementById("encounterDetailsLoading");
    const content = document.getElementById("encounterDetailsContent");
    const message = document.getElementById("encounterDetailsMessage");
    const soapFields = {
        SubjectiveNote: document.getElementById("encounterSubjectiveNote"),
        ObjectiveNote: document.getElementById("encounterObjectiveNote"),
        AssessmentNote: document.getElementById("encounterAssessmentNote"),
        PlanNote: document.getElementById("encounterPlanNote")
    };
    const legacyNoteSection = document.getElementById("encounterLegacyNoteSection");
    const legacyNote = document.getElementById("encounterLegacyNote");
    const noteMessage = document.getElementById("encounterNoteMessage");
    const saveNoteButton = document.getElementById("saveEncounterNoteButton");
    const signEncounterButton = document.getElementById("signEncounterButton");
    const signModalElement = document.getElementById("signEncounterModal");
    const signModal = new bootstrap.Modal(signModalElement);
    const signMessage = document.getElementById("signEncounterMessage");
    const confirmSignButton = document.getElementById("confirmSignEncounterButton");
    const viewHistoryButton = document.getElementById("viewEncounterHistoryButton");
    const historyContent = document.getElementById("encounterHistoryContent");
    const addendumHelper = document.getElementById("encounterAddendumHelper");
    const addendumForm = document.getElementById("encounterAddendumForm");
    const addendumText = document.getElementById("encounterAddendumText");
    const addendumMessage = document.getElementById("encounterAddendumMessage");
    const saveAddendumButton = document.getElementById("saveEncounterAddendumButton");
    const cancelAddendumButton = document.getElementById("cancelEncounterAddendumButton");
    const addendumsContent = document.getElementById("encounterAddendumsContent");
    const detailsUrl = '@Url.Action("EncounterDetails", "PatientEncounters")';
    const encounterHistoryUrl = '@Url.Action("EncounterHistory", "PatientEncounters")';
    const updateSoapNoteUrl = '@Url.Action("UpdateEncounterSoapNote", "PatientEncounters")';
    const updateStructuredDataUrl = '@Url.Action("UpdateEncounterStructuredData", "PatientEncounters")';
    const previewPdfUrl = '@Url.Action("PreviewPdf", "PatientEncounters")';
    const finalPdfUrl = '@Url.Action("FinalPdf", "PatientEncounters")';
    const signEncounterUrl = '@Url.Action("SignEncounter", "PatientEncounters")';
    const encounterAddendumsUrl = '@Url.Action("EncounterAddendums", "PatientEncounters")';
    const createEncounterAddendumUrl = '@Url.Action("CreateEncounterAddendum", "PatientEncounters")';
    const emptyValue = "—";
    let currentPatientUid = null;
    let currentEncounterUid = null;
    let currentEncounterIsEditable = false;
    let currentStructuredEncounter = null;
    let historyLoaded = false;
    const previewButton = document.getElementById("previewEncounterButton");
    const viewPdfButton = document.getElementById("viewEncounterPdfButton");
    const hidePreviewButton = document.getElementById("hideEncounterPreviewButton");
    const previewPane = document.getElementById("encounterPdfPreviewPane");
    const previewFrame = document.getElementById("encounterPdfPreviewFrame");
    const previewMessage = document.getElementById("encounterPdfPreviewMessage");
    const editorPane = document.getElementById("encounterEditorPane");
    const editorActions = document.getElementById("encounterEditorActions");
    const previewActions = document.getElementById("encounterPdfPreviewActions");
    const dialog = document.getElementById("encounterDetailsDialog");
    let previewObjectUrl = null;

    const collectStructuredData = () => {
        const values = {};
        document.querySelectorAll("#encounterStructuredFields [data-field-key]").forEach(input => {
            const type=input.dataset.fieldType;
            if(type==="Checkbox") values[input.dataset.fieldKey]=input.checked;
            else if(type==="Boolean"&&input.value!=="") values[input.dataset.fieldKey]=input.value==="true";
            else if(input.value!=="") values[input.dataset.fieldKey]=type==="Number"?Number(input.value):input.value;
        });
        return JSON.stringify({schemaVersion: currentStructuredEncounter.templateDefinition.schemaVersion, values});
    };

    const closePdfPreview = () => {
        previewPane.classList.add("d-none");
        previewPane.style.height = "";
        editorPane.classList.remove("col-lg-6"); editorPane.classList.add("col-12");
        editorActions.prepend(viewPdfButton);
        editorActions.append(hidePreviewButton);
        hidePreviewButton.classList.add("d-none");
    };

    const showPdfPreviewControls = () => {
        previewPane.style.paddingTop = "0";
        previewPane.style.height = `${editorPane.getBoundingClientRect().height}px`;
        previewActions.append(viewPdfButton, hidePreviewButton);
        hidePreviewButton.classList.remove("d-none");
    };

    const formatDate = value => value
        ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value))
        : emptyValue;

    const setText = (id, value) => {
        document.getElementById(id).textContent = value || emptyValue;
    };

    const setOptionalDetail = (labelId, valueId, value) => {
        document.getElementById(labelId).classList.toggle("d-none", !value);
        document.getElementById(valueId).classList.toggle("d-none", !value);
        document.getElementById(valueId).textContent = value || "";
    };

    const applyEncounterDetails = encounter => {
        setText("encounterDetailsDate", formatDate(encounter.encounterDateUtc));
        setText("encounterDetailsType", encounter.encounterType);
        setText("encounterDetailsStatus", encounter.status);
        setText("encounterDetailsProvider", encounter.providerName);
        setText("encounterDetailsLocation", encounter.locationName);
        setText("encounterDetailsCreatedBy", encounter.createdByDisplayName || "Unknown");
        setText("encounterDetailsCreatedAt", formatDate(encounter.createdAt));
        setText("encounterDetailsUpdatedAt", formatDate(encounter.updatedAt));
        setText("encounterDetailsReason", encounter.reasonForVisit);
        setOptionalDetail(
            "encounterDetailsSignedAtLabel",
            "encounterDetailsSignedAt",
            encounter.signedAt ? formatDate(encounter.signedAt) : null);
        setOptionalDetail(
            "encounterDetailsSignedByLabel",
            "encounterDetailsSignedBy",
            encounter.signedByDisplayName);
        soapFields.SubjectiveNote.value = encounter.subjectiveNote || "";
        soapFields.ObjectiveNote.value = encounter.objectiveNote || "";
        soapFields.AssessmentNote.value = encounter.assessmentNote || "";
        soapFields.PlanNote.value = encounter.planNote || "";
        currentStructuredEncounter = encounter.templateVersionUid ? encounter : null;
        renderStructuredEncounter(encounter);
        saveNoteButton.textContent = currentStructuredEncounter ? "Save Draft" : "Save Note";
        legacyNote.value = encounter.notes || "";
        legacyNoteSection.classList.toggle("d-none", !encounter.notes);
        currentPatientUid = encounter.patientUid;
        currentEncounterUid = encounter.encounterUid;
        const encounterIsOpen = String(encounter.status).toLowerCase() === "open";
        currentEncounterIsEditable = encounterIsOpen && canEditEncounters;
        previewButton.classList.toggle("d-none", !currentStructuredEncounter || !currentEncounterIsEditable);
        viewPdfButton.classList.toggle("d-none", !currentStructuredEncounter || String(encounter.status).toLowerCase() !== "signed");
        Object.values(soapFields).forEach(field => {
            field.readOnly = !currentEncounterIsEditable;
        });
        saveNoteButton.classList.toggle("d-none", !encounterIsOpen);
        saveNoteButton.disabled = !currentEncounterIsEditable;
        signEncounterButton.classList.toggle("d-none", !encounterIsOpen);
        signEncounterButton.disabled = !canSignEncounters || !encounterIsOpen;
        const isSigned = String(encounter.status).toLowerCase() === "signed";
        addendumHelper.classList.toggle("d-none", isSigned);
        addendumForm.classList.toggle("d-none", !isSigned);
        addendumText.disabled = !isSigned;
        saveAddendumButton.disabled = !isSigned;
    };

    const renderStructuredEncounter = encounter => {
        const host = document.getElementById("encounterStructuredTemplate");
        const legacy = document.getElementById("encounterLegacySoapEditor");
        const fieldsHost = document.getElementById("encounterStructuredFields");
        const definition = encounter.templateDefinition;
        host.classList.toggle("d-none", !definition);
        legacy.classList.toggle("d-none", !!definition);
        fieldsHost.replaceChildren();
        if (!definition) return;
        document.getElementById("encounterTemplateName").textContent = encounter.templateName || "Encounter template";
        document.getElementById("encounterTemplateVersion").textContent = `Version ${encounter.templateVersionNumber}`;
        const values = JSON.parse(encounter.structuredDataJson || '{"values":{}}').values || {};
        [...definition.sections].sort((a,b)=>a.order-b.order).forEach(section => {
            const wrapper=document.createElement("section"); wrapper.className="border rounded-3 p-3 p-lg-4 mb-3 bg-body";
            const heading=document.createElement("h4"); heading.className="h6 border-bottom pb-2 mb-3"; heading.textContent=section.title; wrapper.appendChild(heading);
            [...section.fields].sort((a,b)=>a.order-b.order).forEach(field => {
                if(field.type==="StaticText"){const p=document.createElement("p");p.className="text-body-secondary lh-lg mb-3";p.style.whiteSpace="pre-line";p.textContent=field.content||"";wrapper.appendChild(p);return;}
                const group=document.createElement("div");group.className="mb-3";
                const label=document.createElement("label");label.className="form-label";label.textContent=field.label+(field.required?" *":"");group.appendChild(label);
                let input;
                if(field.type==="TextArea") input=document.createElement("textarea");
                else if(field.type==="Boolean"){input=document.createElement("select");[{value:"",label:"Not answered"},{value:"true",label:"Yes"},{value:"false",label:"No"}].forEach(option=>{const item=document.createElement("option");item.value=option.value;item.textContent=option.label;input.appendChild(item);});}
                else if(field.type==="Select"||field.type==="Radio"){input=document.createElement("select");const blank=document.createElement("option");blank.value="";blank.textContent="Select...";input.appendChild(blank);(field.options||[]).sort((a,b)=>a.order-b.order).forEach(option=>{const item=document.createElement("option");item.value=option.value;item.textContent=option.label;input.appendChild(item);});}
                else {input=document.createElement("input");input.type=field.type==="Number"?"number":field.type==="Date"?"date":field.type==="Checkbox"?"checkbox":"text";}
                input.className=field.type==="Checkbox"?"form-check-input":"form-control"; input.dataset.fieldKey=field.key; input.dataset.fieldType=field.type;
                if(field.type==="Checkbox") input.checked=values[field.key]===true; else input.value=field.type==="Boolean"&&values[field.key]!==undefined?String(values[field.key]):values[field.key]??"";
                input.disabled=String(encounter.status).toLowerCase()!=="open"; if(field.required) input.required=true; group.appendChild(input); wrapper.appendChild(group);
            }); fieldsHost.appendChild(wrapper);
        });
    };

    const renderAddendums = addendums => {
        addendumsContent.className = "";
        addendumsContent.replaceChildren();
        if (!addendums.length) {
            const empty = document.createElement("p");
            empty.className = "text-muted mb-0";
            empty.textContent = "No addendums have been added.";
            addendumsContent.appendChild(empty);
            return;
        }

        addendums.forEach(addendum => {
            const card = document.createElement("div");
            card.className = "card mb-2";
            const body = document.createElement("div");
            body.className = "card-body";
            const metadata = document.createElement("div");
            metadata.className = "small text-muted mb-2";
            metadata.textContent = `${formatDate(addendum.createdAt)} · ${addendum.createdByDisplayName || "Unknown"}`;
            const text = document.createElement("p");
            text.className = "mb-0 text-break";
            text.style.whiteSpace = "pre-wrap";
            text.textContent = addendum.addendumText || "";
            body.append(metadata, text);
            card.appendChild(body);
            addendumsContent.appendChild(card);
        });
    };

    const loadAddendums = async () => {
        if (!currentPatientUid || !currentEncounterUid) return;
        addendumsContent.className = "";
        addendumsContent.innerHTML =
            '<div class="text-muted"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading addendums...</div>';
        try {
            const query = new URLSearchParams({
                patientUid: currentPatientUid,
                encounterUid: currentEncounterUid
            });
            const response = await fetch(`${encounterAddendumsUrl}?${query}`, {
                headers: { "Accept": "application/json" }
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success)
                throw new Error(result.message || "Encounter addendums could not be loaded.");
            renderAddendums(result.addendums || []);
        } catch (error) {
            addendumsContent.className = "alert alert-danger mb-0";
            addendumsContent.textContent = error instanceof Error
                ? error.message
                : "Encounter addendums could not be loaded.";
        }
    };

    const historyActionLabel = actionType => String(actionType || "")
        .replace(/([a-z])([A-Z])/g, "$1 $2")
        .replace(/^./, value => value.toUpperCase());

    const renderEncounterHistory = history => {
        historyContent.replaceChildren();
        if (!history.length) {
            const empty = document.createElement("p");
            empty.className = "text-muted mb-0";
            empty.textContent = "No encounter history is available.";
            historyContent.appendChild(empty);
            return;
        }

        const list = document.createElement("div");
        list.className = "list-group list-group-flush border rounded";
        history.forEach(item => {
            const row = document.createElement("div");
            row.className = "list-group-item";
            const title = document.createElement("div");
            title.className = "fw-semibold";
            title.textContent = historyActionLabel(item.actionType);
            const status = document.createElement("div");
            status.className = "small";
            status.textContent = item.oldStatus && item.newStatus
                ? `${item.oldStatus} \u2192 ${item.newStatus}`
                : (item.actionDescription || "");
            const description = document.createElement("div");
            description.className = "small text-muted";
            description.textContent =
                item.oldStatus && item.newStatus && item.actionDescription
                    ? item.actionDescription
                    : "";
            const date = document.createElement("div");
            date.className = "small text-muted mt-1";
            date.textContent = formatDate(item.createdAt);
            row.append(title, status);
            if (description.textContent) row.appendChild(description);
            row.appendChild(date);
            list.appendChild(row);
        });
        historyContent.appendChild(list);
    };

    const resetEncounterHistory = () => {
        historyLoaded = false;
        historyContent.replaceChildren();
        historyContent.className = "mt-3 d-none";
        viewHistoryButton.textContent = "View History";
        viewHistoryButton.disabled = false;
    };

    const openEncounter = async (patientUid, encounterUid) => {
        loading.classList.remove("d-none");
        content.classList.add("d-none");
        message.classList.add("d-none");
        message.textContent = "";
        noteMessage.className = "alert d-none mt-3 mb-0";
        noteMessage.textContent = "";
        Object.values(soapFields).forEach(field => { field.value = ""; });
        legacyNote.value = "";
        legacyNoteSection.classList.add("d-none");
        saveNoteButton.disabled = true;
        signEncounterButton.disabled = true;
        currentPatientUid = null;
        currentEncounterUid = null;
        currentEncounterIsEditable = false;
        addendumText.value = "";
        addendumMessage.className = "alert d-none mt-3 mb-0";
        addendumMessage.textContent = "";
        addendumsContent.replaceChildren();
        resetEncounterHistory();
        modal.show();

        try {
            const query = new URLSearchParams({ patientUid, encounterUid });
            const response = await fetch(`${detailsUrl}?${query}`, { headers: { "Accept": "application/json" } });
            const result = await response.json().catch(() => ({}));

            if (!response.ok || !result.success || !result.encounter) {
                throw new Error(result.message || "Encounter details could not be loaded.");
            }

            const encounter = result.encounter;
            applyEncounterDetails(encounter);
            await loadAddendums();
            content.classList.remove("d-none");
        } catch (error) {
            message.textContent = error instanceof Error
                ? error.message
                : "Encounter details could not be loaded.";
            message.classList.remove("d-none");
        } finally {
            loading.classList.add("d-none");
        }
    };

    viewHistoryButton.addEventListener("click", async () => {
        if (!currentPatientUid || !currentEncounterUid) return;
        if (historyLoaded) {
            historyContent.classList.toggle("d-none");
            viewHistoryButton.textContent = historyContent.classList.contains("d-none")
                ? "View History"
                : "Hide History";
            return;
        }

        viewHistoryButton.disabled = true;
        historyContent.className = "mt-3";
        historyContent.innerHTML =
            '<div class="text-muted"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading encounter history...</div>';
        try {
            const query = new URLSearchParams({
                patientUid: currentPatientUid,
                encounterUid: currentEncounterUid
            });
            const response = await fetch(`${encounterHistoryUrl}?${query}`, {
                headers: { "Accept": "application/json" }
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success) {
                throw new Error(result.message || "Encounter history could not be loaded.");
            }
            renderEncounterHistory(result.history || []);
            historyLoaded = true;
            viewHistoryButton.textContent = "Hide History";
        } catch (error) {
            historyContent.textContent = error instanceof Error
                ? error.message
                : "Encounter history could not be loaded.";
            historyContent.className = "alert alert-danger mt-3";
        } finally {
            viewHistoryButton.disabled = false;
        }
    });

    saveNoteButton.addEventListener("click", async () => {
        if (!currentPatientUid || !currentEncounterUid || !currentEncounterIsEditable) {
            return;
        }

        saveNoteButton.disabled = true;
        noteMessage.className = "alert d-none mt-3 mb-0";
        noteMessage.textContent = "";

        try {
            const formData = new FormData();
            formData.append("PatientUid", currentPatientUid);
            formData.append("EncounterUid", currentEncounterUid);
            if (currentStructuredEncounter) {
                formData.append("StructuredDataJson", collectStructuredData());
                formData.append("RowVersion", currentStructuredEncounter.rowVersion);
            } else {
                formData.append("SubjectiveNote", soapFields.SubjectiveNote.value);
                formData.append("ObjectiveNote", soapFields.ObjectiveNote.value);
                formData.append("AssessmentNote", soapFields.AssessmentNote.value);
                formData.append("PlanNote", soapFields.PlanNote.value);
            }

            const token = document.querySelector(
                '#encounterNoteAntiforgeryForm input[name="__RequestVerificationToken"]').value;
            const response = await fetch(currentStructuredEncounter ? updateStructuredDataUrl : updateSoapNoteUrl, {
                method: "POST",
                headers: {
                    "Accept": "application/json",
                    "RequestVerificationToken": token
                },
                body: formData
            });
            const result = await response.json().catch(() => ({}));

            if (!response.ok || !result.success) {
                throw new Error(result.message || "Encounter note could not be saved.");
            }

            applyEncounterDetails(result.encounter);
            resetEncounterHistory();
            noteMessage.className = "alert alert-success mt-3 mb-0";
            noteMessage.textContent = result.message || "Encounter note saved.";
        } catch (error) {
            noteMessage.className = "alert alert-danger mt-3 mb-0";
            noteMessage.textContent = error instanceof Error
                ? error.message
                : "Encounter note could not be saved.";
        } finally {
            saveNoteButton.disabled = !currentEncounterIsEditable;
        }
    });

    cancelAddendumButton.addEventListener("click", () => {
        addendumText.value = "";
        addendumMessage.className = "alert d-none mt-3 mb-0";
        addendumMessage.textContent = "";
    });

    saveAddendumButton.addEventListener("click", async () => {
        if (!currentPatientUid || !currentEncounterUid || !addendumText.value.trim()) {
            addendumMessage.className = "alert alert-danger mt-3 mb-0";
            addendumMessage.textContent = "Addendum text is required.";
            return;
        }

        saveAddendumButton.disabled = true;
        addendumMessage.className = "alert d-none mt-3 mb-0";
        try {
            const formData = new FormData();
            formData.append("PatientUid", currentPatientUid);
            formData.append("EncounterUid", currentEncounterUid);
            formData.append("AddendumText", addendumText.value);
            const token = document.querySelector(
                '#encounterNoteAntiforgeryForm input[name="__RequestVerificationToken"]').value;
            const response = await fetch(createEncounterAddendumUrl, {
                method: "POST",
                headers: { "Accept": "application/json", "RequestVerificationToken": token },
                body: formData
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.success)
                throw new Error(result.message || "Addendum could not be saved.");

            addendumText.value = "";
            await loadAddendums();
            resetEncounterHistory();
            addendumMessage.className = "alert alert-success mt-3 mb-0";
            addendumMessage.textContent = result.message || "Addendum saved.";
        } catch (error) {
            addendumMessage.className = "alert alert-danger mt-3 mb-0";
            addendumMessage.textContent = error instanceof Error
                ? error.message
                : "Addendum could not be saved.";
        } finally {
            saveAddendumButton.disabled = false;
        }
    });

    signEncounterButton.addEventListener("click", () => {
        if (!currentPatientUid || !currentEncounterUid || !currentEncounterIsEditable) {
            return;
        }

        signMessage.classList.add("d-none");
        signMessage.textContent = "";
        modalElement.addEventListener(
            "hidden.bs.modal",
            () => signModal.show(),
