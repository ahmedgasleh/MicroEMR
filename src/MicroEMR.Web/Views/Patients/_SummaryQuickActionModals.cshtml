@model MicroEMR.Web.Models.Patients.PatientChartViewModel
@{ var patientUid = Model.Patient.PatientUid; }

<div class="modal fade" id="summaryAllergyModal" tabindex="-1" aria-labelledby="summaryAllergyModalLabel" aria-hidden="true">
 <div class="modal-dialog modal-lg"><div class="modal-content"><form asp-controller="PatientAllergies" asp-action="Create" method="post" id="summaryAllergyForm">
  @Html.AntiForgeryToken()<input type="hidden" name="PatientUid" value="@patientUid" /><input type="hidden" name="ReturnTab" value="summary" />
  <div class="modal-header"><h2 class="modal-title fs-5" id="summaryAllergyModalLabel">Add Allergy</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
  @if (Model.AllergyDocumentationState?.State == "ExplicitlyNone")
  {
   <div class="alert alert-warning"><strong>No Known Allergies is currently documented.</strong> Adding this allergy will replace that assertion.
    <div class="form-check mt-2"><input id="summaryConfirmReplaceNka" name="ConfirmReplaceNoKnownAllergies" value="true" type="checkbox" class="form-check-input" required /><label for="summaryConfirmReplaceNka" class="form-check-label">I confirm this replacement.</label></div>
   </div>
  }
  <div class="row g-3">
   <div class="col-12 col-md-6"><label for="summaryAllergenName" class="form-label">Allergen name</label><input id="summaryAllergenName" name="AllergenName" class="form-control" maxlength="200" required /></div>
   <div class="col-12 col-md-3"><label for="summaryAllergenType" class="form-label">Allergen type</label><select id="summaryAllergenType" name="AllergenType" class="form-select"><option value="">Select</option><option>Medication</option><option>Food</option><option>Environmental</option><option>Latex</option><option>Contrast</option><option>Other</option></select></div>
   <div class="col-12 col-md-3"><label for="summaryAllergySeverity" class="form-label">Severity</label><select id="summaryAllergySeverity" name="Severity" class="form-select"><option value="">Select</option><option>Unknown</option><option>Mild</option><option>Moderate</option><option>Severe</option></select></div>
   <div class="col-12 col-md-8"><label for="summaryAllergyReaction" class="form-label">Reaction</label><input id="summaryAllergyReaction" name="Reaction" class="form-control" maxlength="500" /></div>
   <div class="col-12 col-md-4"><label for="summaryAllergyOnsetDate" class="form-label">Onset date</label><input id="summaryAllergyOnsetDate" name="OnsetDate" type="date" class="form-control" /></div>
   <div class="col-12"><label for="summaryAllergyNotes" class="form-label">Notes</label><textarea id="summaryAllergyNotes" name="Notes" class="form-control" maxlength="1000" rows="3"></textarea></div>
  </div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary summary-modal-save">Save</button></div>
 </form></div></div>
</div>

<div class="modal fade" id="summaryMedicationModal" tabindex="-1" aria-labelledby="summaryMedicationModalLabel" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form asp-controller="PatientMedications" asp-action="Create" method="post" id="summaryMedicationForm">
  @Html.AntiForgeryToken()<input type="hidden" name="PatientUid" value="@patientUid" /><input type="hidden" name="ReturnTab" value="summary" />
  <div class="modal-header"><h2 class="modal-title fs-5" id="summaryMedicationModalLabel">Add Medication</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body"><div class="row g-3">
   <div class="col-12 col-md-6"><label for="summaryMedicationName" class="form-label">Medication name</label><input id="summaryMedicationName" name="MedicationName" class="form-control" maxlength="200" required /></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationStrength" class="form-label">Strength</label><input id="summaryMedicationStrength" name="Strength" class="form-control" maxlength="100" /></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationFrequency" class="form-label">Frequency</label><input id="summaryMedicationFrequency" name="Frequency" class="form-control" maxlength="100" /></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationDosageForm" class="form-label">Dosage form</label><select id="summaryMedicationDosageForm" name="DosageForm" class="form-select"><option value="">Select</option><option>Tablet</option><option>Capsule</option><option>Liquid</option><option>Injection</option><option>Inhaler</option><option>Cream</option><option>Ointment</option><option>Patch</option><option>Drops</option><option>Other</option></select></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationRoute" class="form-label">Route</label><select id="summaryMedicationRoute" name="Route" class="form-select"><option value="">Select</option><option>Oral</option><option>Sublingual</option><option>Topical</option><option>Inhaled</option><option>Subcutaneous</option><option>Intramuscular</option><option>Intravenous</option><option>Ophthalmic</option><option>Otic</option><option>Nasal</option><option>Other</option></select></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationStartDate" class="form-label">Start date</label><input id="summaryMedicationStartDate" name="StartDate" type="date" class="form-control" /></div>
   <div class="col-6 col-md-3"><label for="summaryMedicationEndDate" class="form-label">End date</label><input id="summaryMedicationEndDate" name="EndDate" type="date" class="form-control" /></div>
   <div class="col-12"><label for="summaryMedicationDirections" class="form-label">Directions</label><textarea id="summaryMedicationDirections" name="Directions" class="form-control" maxlength="500" rows="2"></textarea></div>
   <div class="col-12 col-md-6"><label for="summaryMedicationIndication" class="form-label">Indication</label><input id="summaryMedicationIndication" name="Indication" class="form-control" maxlength="300" /></div>
   <div class="col-12 col-md-6"><label for="summaryMedicationPrescriber" class="form-label">Prescriber</label><input id="summaryMedicationPrescriber" name="PrescriberName" class="form-control" maxlength="200" /></div>
   <div class="col-12"><label for="summaryMedicationNotes" class="form-label">Notes</label><textarea id="summaryMedicationNotes" name="Notes" class="form-control" maxlength="1000" rows="3"></textarea></div>
  </div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary summary-modal-save">Save</button></div>
 </form></div></div>
</div>

<div class="modal fade" id="summaryDocumentModal" tabindex="-1" aria-labelledby="summaryDocumentModalLabel" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form asp-controller="PatientDocuments" asp-action="Create" method="post" id="summaryDocumentForm">
  @Html.AntiForgeryToken()<input type="hidden" name="PatientUid" value="@patientUid" /><input type="hidden" name="ReturnTab" value="summary" />
  <div class="modal-header"><h2 class="modal-title fs-5" id="summaryDocumentModalLabel">New Document</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body"><div id="summaryDocumentTemplateError" class="alert alert-danger d-none">Unable to load the selected template. Please try again.</div><div id="summaryDocumentStructuredMessage" class="alert alert-info d-none">This template uses a structured clinical form. Click <strong>Save Draft</strong> to create the document and open its sections and fields.</div><div class="row g-3">
   <div class="col-12"><label for="summaryDocumentTemplate" class="form-label">Template</label><select id="summaryDocumentTemplate" name="TemplateUid" class="form-select"><option value="">-- Select a template --</option>@foreach (var template in Model.DocumentTemplates) { <option value="@template.TemplateUid">@template.TemplateName</option> }</select></div>
   <div class="col-12 col-md-4"><label for="summaryDocumentType" class="form-label">Document type</label><input id="summaryDocumentType" name="DocumentType" class="form-control" maxlength="100" required /></div>
   <div class="col-12 col-md-8"><label for="summaryDocumentTitle" class="form-label">Title</label><input id="summaryDocumentTitle" name="Title" class="form-control" maxlength="250" required /></div>
   <div class="col-12" id="summaryDocumentContentGroup"><label for="summaryDocumentContent" class="form-label">Content</label><textarea id="summaryDocumentContent" name="Content" class="form-control font-monospace" rows="12"></textarea></div>
  </div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary summary-modal-save">Save Draft</button></div>
 </form></div></div>
</div>
