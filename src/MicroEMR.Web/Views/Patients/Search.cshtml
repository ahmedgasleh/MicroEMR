@model MicroEMR.Web.Models.Patients.PatientSearchResponse

@{
    ViewData["Title"] = "Patients";
    ViewData["Subtitle"] = "Search and manage patient records";
    Layout = "_AppLayout";

    var searchText = ViewBag.SearchText as string;
    DateOnly? dateOfBirth = ViewBag.DateOfBirth;
}

<div class="content-panel">

    <div class="content-panel-header">
        <div>
            <h3>Patient Directory</h3>
            <p>Search by name, chart number, health card or phone</p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Register patient
        </a>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger mt-3">
    </div>

    <form method="get"
          asp-action="Search"
          class="row g-3 mt-1">

        <div class="col-12 col-lg-6">
            <label class="form-label">
                Search
            </label>

            <input type="text"
                   name="searchText"
                   value="@searchText"
                   class="form-control"
                   placeholder="Search by name, chart number, health card, or phone" />
            <div class="form-text">You can search by name, chart number, health card, or phone.</div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label">
                Date of birth
            </label>

            <input type="date"
                   name="dateOfBirth"
                   value="@dateOfBirth?.ToString("yyyy-MM-dd")"
                   class="form-control" />
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <span class="form-label d-none d-sm-block invisible"
                  aria-hidden="true">
                Actions
            </span>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>
                    Search
                </button>

                <a asp-action="Search"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>
        </div>
    </form>

    <div class="table-responsive mt-4">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Chart</th>
                    <th>Patient</th>
                    <th>Date of birth</th>
                    <th>Health card</th>
                    <th>Phone</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr class="microemr-empty-state-row">
                        <td colspan="6">
                            <div class="microemr-empty-state">
                                <div class="microemr-empty-state__icon"><i class="bi bi-search"></i></div>
                                @if (string.IsNullOrWhiteSpace(searchText) && !dateOfBirth.HasValue)
                                {
                                    <div class="microemr-empty-state__title">Search for a patient</div>
                                    <div class="microemr-empty-state__text">Enter a name, chart number, health card, or phone number to find a chart.</div>
                                }
                                else
                                {
                                    <div class="microemr-empty-state__title">No matching patients found</div>
                                    <div class="microemr-empty-state__text">Try searching by name, chart number, health card, or phone.</div>
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var patient in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @patient.ChartNumber
                            </td>

                            <td>
                                <div class="fw-semibold">
                                    @patient.FullName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(patient.PreferredName))
                                {
                                    <small class="text-muted">
                                        Preferred: @patient.PreferredName
                                    </small>
                                }
                            </td>

                            <td>
                                @patient.DateOfBirth.ToString("yyyy-MM-dd")
                            </td>

                            <td>
                                @patient.HealthCardNumber

                                @if (!string.IsNullOrWhiteSpace(
                                        patient.HealthCardVersion))
                                {
                                    <span>
                                        - @patient.HealthCardVersion
                                    </span>
                                }
                            </td>

                            <td>
                                @patient.PhoneNumber
                            </td>

                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-patientUid="@patient.PatientUid"
                                   class="btn btn-sm btn-outline-primary">
                                    Open chart
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
