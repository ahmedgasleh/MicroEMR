<div class="modal fade" id="immunizationModal" tabindex="-1" aria-labelledby="immunizationModalTitle" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="immunizationModalTitle">Add Immunization</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="immunizationForm">@Html.AntiForgeryToken()<input type="hidden" name="RowVersion"/><input type="hidden" name="ClinicalFieldsIncluded" value="true"/><input type="hidden" name="ClinicalFields.Refused"/><div id="immunizationEditorMessage" class="alert alert-danger d-none"></div><div class="row g-3">
<div class="col-md-8"><label class="form-label">Vaccine name</label><input class="form-control" name="VaccineName" maxlength="200" required/></div>
<div class="col-md-4"><label class="form-label">Recorded outcome</label><select class="form-select" name="ImmunizationOutcome" required><option value="">Select outcome</option><option value="false">Administered</option><option value="true">Refused</option></select><div class="form-text">Outcome cannot be converted on edit.</div></div>
<div class="col-12"><label class="form-label">Immunization type (CT-020)</label><select class="form-select" name="ClinicalFields.ImmunizationTypeCode"><option value="">Not recorded</option>@foreach(var type in MicroEMR.Core.Domain.ImmunizationTypes.All){<option value="@type.Code">@type.Code ? @type.Display</option>}</select></div>
<div class="col-12" data-immunization-admin><label class="form-label">Administration date (leave unknown parts blank)</label><div class="row g-2"><div class="col-4"><label class="form-label small">Year</label><input class="form-control" name="ClinicalFields.AdministrationDate.Year" type="number" min="1" max="9999"/></div><div class="col-4"><label class="form-label small">Month</label><input class="form-control" name="ClinicalFields.AdministrationDate.Month" type="number" min="1" max="12"/></div><div class="col-4"><label class="form-label small">Day</label><input class="form-control" name="ClinicalFields.AdministrationDate.Day" type="number" min="1" max="31"/></div></div></div>
<div class="col-12" data-immunization-refusal><label class="form-label">Refusal date (leave unknown parts blank)</label><div class="row g-2"><div class="col-4"><label class="form-label small">Year</label><input class="form-control" name="ClinicalFields.RefusalDate.Year" type="number" min="1" max="9999"/></div><div class="col-4"><label class="form-label small">Month</label><input class="form-control" name="ClinicalFields.RefusalDate.Month" type="number" min="1" max="12"/></div><div class="col-4"><label class="form-label small">Day</label><input class="form-control" name="ClinicalFields.RefusalDate.Day" type="number" min="1" max="31"/></div></div></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">DIN</label><input class="form-control" name="ClinicalFields.DIN" maxlength="100"/></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Manufacturer</label><input class="form-control" name="ClinicalFields.Manufacturer" maxlength="200"/></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Source</label><select class="form-select" name="SourceType"><option value="ClinicAdministered">Clinic administered</option><option value="HistoricalExternal">Historical / external</option></select></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Administered by</label><input class="form-control" name="AdministeredByName" maxlength="200"/></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Route</label><input class="form-control" name="Route" maxlength="100"/></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Site</label><input class="form-control" name="Site" maxlength="100"/></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Lot number</label><input class="form-control" name="LotNumber" maxlength="100"/></div>
<input type="hidden" name="DoseIncluded" value="true"/>
<div class="col-md-6" data-immunization-admin><label class="form-label" for="immunizationDoseAmount">Administered dose amount</label><input id="immunizationDoseAmount" class="form-control" name="Dose.Amount" type="number" min="0.001" max="9999.999" step="0.001" inputmode="decimal" aria-describedby="immunizationDoseHelp"/><div id="immunizationDoseHelp" class="form-text">Leave amount and unit blank if unknown. Up to 3 decimal places; no dose is inferred.</div></div>
<div class="col-md-6" data-immunization-admin><label class="form-label" for="immunizationDoseUnit">Administered dose unit</label><select id="immunizationDoseUnit" class="form-select" name="Dose.UnitCode"><option value="">Not recorded</option>@foreach(var unit in MicroEMR.Core.Domain.ImmunizationDoseUnits.All){<option value="@unit">@unit</option>}</select></div>
<div class="col-md-6" data-immunization-admin><label class="form-label">Dose number (ordinal)</label><input class="form-control" name="DoseNumber" type="number" min="1"/></div>
<div class="col-md-6"><label class="form-label">Source description</label><input class="form-control" name="SourceDescription" maxlength="500"/></div>
<div class="col-md-6"><label class="form-label">Encounter UID</label><input class="form-control" name="EncounterUid" placeholder="Optional"/></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="Notes" maxlength="1000" rows="3"></textarea></div></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveImmunizationButton" type="button">Save</button></div></div></div></div>
<div class="modal fade" id="immunizationErrorModal" tabindex="-1" aria-labelledby="immunizationErrorTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="immunizationErrorTitle">Mark entered in error</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="immunizationErrorForm">@Html.AntiForgeryToken()<input type="hidden" name="ImmunizationUid"/><input type="hidden" name="RowVersion"/><label class="form-label">Reason</label><textarea class="form-control" name="Reason" maxlength="500" required rows="3"></textarea><div id="immunizationErrorMessage" class="alert alert-danger d-none mt-3"></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" id="confirmImmunizationErrorButton" type="button">Mark entered in error</button></div></div></div></div>
