@model MicroEMR.Web.Models.Patients.PatientChartViewModel
@using MicroEMR.Application.AccessProfiles
@inject MicroEMR.Web.Authorization.IWebPermissionService Permissions
@{ var canManage = (await Permissions.GetAsync(Context.RequestAborted)).Contains(PermissionKeys.ClinicalDataManage); }
<div class="tab-pane fade @(Model.ActiveTab == "risk-factors" ? "show active" : null)" id="risk-factors" role="tabpanel">
    <section id="patientRiskFactorRoot" data-list-url="@Url.Action("List", "PatientRiskFactors", new { patientUid = Model.Patient.PatientUid })" data-can-manage="@canManage.ToString().ToLowerInvariant()">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div><h5>Risk Factors</h5><p class="text-body-secondary">Recorded factors and exposure details that may affect this patient's health.</p></div>
            @if (canManage) { <button type="button" class="btn btn-primary" id="addRiskFactorButton">Add risk factor</button> }
        </div>
        <div id="riskFactorMessage" class="alert alert-danger d-none" role="alert"></div>
        <div class="d-flex justify-content-end mb-3"><label class="visually-hidden" for="riskFactorStatus">Risk factor status</label><select id="riskFactorStatus" class="form-select form-select-sm w-auto"><option>Active</option><option>Archived</option><option>All</option></select></div>
        <div id="riskFactorList" aria-live="polite">Loading risk factors...</div>
    </section>
</div>
<div class="modal fade" id="riskFactorModal" tabindex="-1" aria-labelledby="riskFactorModalTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="riskFactorModalTitle">Add risk factor</h2></div>
        <div class="modal-body">
            <form id="riskFactorForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RiskFactorUid" /><input type="hidden" name="RowVersion" />
                <div class="mb-3"><label class="form-label" for="riskFactorName">Risk factor</label><input class="form-control" id="riskFactorName" name="RiskFactor" maxlength="200" required /></div>
                <div class="mb-3"><label class="form-label" for="riskExposure">Exposure details</label><textarea class="form-control" id="riskExposure" name="ExposureDetails" maxlength="1000" rows="2"></textarea></div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6"><label class="form-label" for="riskLifeStage">Life stage at first exposure</label><select class="form-select" id="riskLifeStage" name="LifeStageCode"><option value="">Not recorded</option>@foreach (var stage in MicroEMR.Core.Domain.FamilyHistoryLifeStages.Labels) { <option value="@stage.Key">@stage.Value</option> }</select></div>
                </div>
                <div class="mb-3"><label class="form-label" for="riskNotes">Clinical notes</label><textarea class="form-control" id="riskNotes" name="Notes" maxlength="1000" rows="3"></textarea></div>
                <p class="small text-body-secondary">Leave unknown values blank. An empty list does not establish that the patient has no risk factors.</p>
            </form>
            <div id="riskFactorEditorMessage" class="alert alert-danger d-none" role="alert"></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary d-none" id="reloadRiskFactorButton">Reload saved entry</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>@if (canManage) { <button type="submit" form="riskFactorForm" class="btn btn-primary" id="saveRiskFactorButton">Save</button> }</div>
    </div></div>
</div>
