@using System.Text.Json
@model MicroEMR.Web.Models.TemplateAdministration.TemplateBuilderViewModel
@{ViewData["Title"]=$"{Model.Template.TemplateName} Builder";Layout="_AppLayout";var json=new JsonSerializerOptions(JsonSerializerDefaults.Web);}

<div id="templateBuilderPage" data-read-only="@Model.IsReadOnly.ToString().ToLowerInvariant()">
    @Html.AntiForgeryToken()
    <div class="content-panel mb-3">
        <div class="content-panel-header align-items-start">
            <div><div class="d-flex gap-2 align-items-center"><h3 class="mb-0">@Model.Template.TemplateName</h3><span class="badge @(Model.Version.Status=="Draft"?"text-bg-warning":"text-bg-success")">@Model.Version.Status Version @Model.Version.VersionNumber</span></div><p class="mt-2 mb-0">@Model.Template.TemplateKind / @(Model.Template.Category??"Uncategorized") / @Model.Template.TemplateScope · Schema v@Model.Version.SchemaVersion</p></div>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Templates</a>
        </div>
        @if(Model.IsEncounterTemplate){<div class="alert alert-info py-2"><i class="bi bi-info-circle me-1"></i>This Encounter template is not yet connected to the encounter runtime. The existing SOAP template workflow is unchanged.</div>}
        @if(Model.Template.TemplateScope=="System"){<div class="alert alert-secondary py-2">System templates are read-only. Clone this template to customize it.</div>}
        <div id="builderMessage" class="alert d-none" role="alert"></div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            @if(Model.CanEdit&&Model.Template.TemplateScope!="System"){<button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#metadataModal"><i class="bi bi-pencil me-1"></i>Edit Details</button>}
            @if(!Model.IsReadOnly){<button type="button" class="btn btn-primary" id="saveDraftButton"><i class="bi bi-save me-1"></i>Save Draft</button>}
            <button type="button" class="btn btn-outline-primary" id="validateButton"><i class="bi bi-check2-circle me-1"></i>Validate</button>
            <button type="button" class="btn btn-outline-secondary" id="previewButton"><i class="bi bi-eye me-1"></i>Preview</button>
            @if(!Model.IsReadOnly){<button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#publishModal"><i class="bi bi-cloud-arrow-up me-1"></i>Publish</button>}
            @if(Model.Version.Status=="Published"&&Model.CanEdit){<form asp-action="Open" method="post">@Html.AntiForgeryToken()<input type="hidden" name="templateUid" value="@Model.Template.TemplateUid"/><button class="btn btn-primary">Edit in New Draft</button></form>}
        </div>
    </div>
    <div id="builderSections"></div>
    @if(!Model.IsReadOnly){<button type="button" class="btn btn-outline-primary w-100 py-3" id="addSectionButton"><i class="bi bi-plus-lg me-1"></i>Add Section</button>}
</div>

<div class="modal fade" id="metadataModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Template Details</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="metadataForm"><input type="hidden" name="TemplateUid" value="@Model.Template.TemplateUid"/><input type="hidden" name="TemplateKind" value="@Model.Template.TemplateKind"/><input type="hidden" name="OwnerUserId" value="@Model.Template.OwnerUserId"/><input type="hidden" name="RowVersion" value="@Model.Template.RowVersion"/><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="Name" value="@Model.Template.TemplateName" maxlength="200" required/></div><div class="mb-3"><label class="form-label">Category</label><input class="form-control" name="Category" value="@Model.Template.Category" maxlength="100" required/></div><label class="form-label">Scope</label><select class="form-select" name="TemplateScope"><option selected="@(Model.Template.TemplateScope=="Clinic")">Clinic</option><option selected="@(Model.Template.TemplateScope=="Personal")">Personal</option></select><div class="form-text">Kind is fixed as @Model.Template.TemplateKind in this builder.</div></form><div class="alert alert-danger d-none mt-3" id="metadataError"></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveMetadataButton">Save Details</button></div></div></div></div>

<div class="modal fade" id="sectionModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Section</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="sectionForm"><input type="hidden" name="Index"/><div class="mb-3"><label class="form-label">Title</label><input class="form-control" name="Title" maxlength="200" required/></div><div><label class="form-label">Key</label><input class="form-control font-monospace" name="Key" maxlength="100" required/><div class="form-text">Stable machine key. It will not change when the title changes.</div></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveSectionButton">Apply</button></div></div></div></div>

<div class="modal fade" id="fieldModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Field</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="fieldForm"><input type="hidden" name="SectionIndex"/><input type="hidden" name="FieldIndex"/>
    <div class="row g-3"><div class="col-md-6"><label class="form-label">Type</label><select class="form-select" name="Type">@foreach(var x in new[]{"StaticText","Text","TextArea","Number","Date","Boolean","Checkbox","Select","Radio"}){<option>@x</option>}</select></div><div class="col-md-6 field-label-group"><label class="form-label">Label</label><input class="form-control" name="Label" maxlength="200"/></div></div>
    <div class="mt-3 static-content-group d-none"><label class="form-label">Instruction Text</label><textarea class="form-control" name="Content" rows="3" maxlength="4000"></textarea></div>
    <div class="row g-3 mt-0 non-static-group"><div class="col-md-6"><label class="form-label">Key</label><input class="form-control font-monospace" name="Key" maxlength="100"/></div><div class="col-md-6 pt-4"><div class="form-check"><input class="form-check-input" type="checkbox" name="Required" id="fieldRequired"/><label class="form-check-label" for="fieldRequired">Required</label></div></div></div>
    <div class="row g-3 mt-0 non-static-group"><div class="col-md-6"><label class="form-label">Placeholder</label><input class="form-control" name="Placeholder" maxlength="4000"/></div><div class="col-md-6"><label class="form-label">Default Value</label><input class="form-control" name="DefaultValue" maxlength="4000"/></div></div>
    <div class="mt-3 non-static-group"><label class="form-label">Help Text</label><input class="form-control" name="HelpText" maxlength="4000"/></div>
    <div class="mt-4 choice-options-group d-none"><div class="d-flex justify-content-between align-items-center"><h3 class="fs-6 mb-0">Options</h3><button type="button" class="btn btn-sm btn-outline-primary" id="addOptionButton">Add Option</button></div><div id="fieldOptions" class="mt-2"></div></div>
</form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="saveFieldButton">Apply</button></div></div></div></div>

<div class="modal fade" id="previewModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Schema Preview</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="schemaPreview"></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>
<div class="modal fade" id="publishModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Publish version @Model.Version.VersionNumber?</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>Published template versions cannot be edited. Future changes will create a new draft version.</p></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success" id="confirmPublishButton">Publish Version</button></div></div></div></div>
<div class="modal fade" id="deleteModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Confirm deletion</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="deleteMessage"></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" id="confirmDeleteButton">Delete</button></div></div></div></div>

<script type="application/json" id="templateBuilderData">@Html.Raw(JsonSerializer.Serialize(new{template=Model.Template,version=Model.Version,definition=Model.Definition,isReadOnly=Model.IsReadOnly},json))</script>
@section Scripts{<script type="module" src="~/dist/template-administration/builder.js" asp-append-version="true"></script>}
