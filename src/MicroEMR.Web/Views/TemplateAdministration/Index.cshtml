@model MicroEMR.Web.Models.TemplateAdministration.TemplateAdministrationIndexViewModel
@{ViewData["Title"]="Templates";Layout="_AppLayout";}

<div class="content-panel" id="templateAdministrationPage">
    <div class="content-panel-header">
        <div><h3>Templates</h3><p>Build and publish structured Document and Encounter templates.</p></div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTemplateModal"><i class="bi bi-plus-lg me-1"></i>New Template</button>
    </div>
    @Html.AntiForgeryToken()
    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-3"><label class="form-label" for="kindFilter">Kind</label><select class="form-select" id="kindFilter" name="kind">@foreach(var x in new[]{"All","Document","Encounter"}){<option selected="@(Model.Kind==x)">@x</option>}</select></div>
        <div class="col-sm-3"><label class="form-label" for="scopeFilter">Scope</label><select class="form-select" id="scopeFilter" name="scope">@foreach(var x in new[]{"All","Clinic","Personal","System"}){<option selected="@(Model.Scope==x)">@x</option>}</select></div>
        <div class="col-sm-3"><label class="form-label" for="statusFilter">Status</label><select class="form-select" id="statusFilter" name="status">@foreach(var x in new[]{"All","Draft","Published","Inactive"}){<option selected="@(Model.Status==x)">@x</option>}</select></div>
        <div class="col-sm-3"><button class="btn btn-outline-primary">Apply Filters</button></div>
    </form>
    <div id="templateListMessage" class="alert d-none" role="alert"></div>
    @if(Model.Templates.Count==0){<div class="microemr-empty-state"><div class="microemr-empty-state__icon"><i class="bi bi-ui-checks-grid"></i></div><div class="microemr-empty-state__title">No templates found</div><div class="microemr-empty-state__text">Create a template or adjust the filters.</div></div>}
    else{
        <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Kind</th><th>Category</th><th>Scope</th><th>Version</th><th>Status</th><th>Updated</th><th class="text-end">Actions</th></tr></thead><tbody>
        @foreach(var item in Model.Templates){<tr>
            <td class="fw-semibold">@item.Name</td><td>@item.TemplateKind</td><td>@item.Category</td><td><span class="badge text-bg-light border">@item.TemplateScope</span></td>
            <td>@(item.CurrentVersion.HasValue?$"v{item.CurrentVersion}":"—")</td><td><span class="badge @(item.VersionStatus=="Published"?"text-bg-success":item.VersionStatus=="Draft"?"text-bg-warning":"text-bg-secondary")">@item.VersionStatus</span></td><td>@item.LastUpdated.ToLocalTime().ToString("MMM d, yyyy")</td>
            <td class="text-end text-nowrap">
                @if(item.CanEdit){<form asp-action="Open" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="templateUid" value="@item.TemplateUid"/><button class="btn btn-sm btn-outline-primary">Open / Edit</button></form>}
                else{<a asp-action="Builder" asp-route-templateUid="@item.TemplateUid" class="btn btn-sm btn-outline-secondary">View</a>}
                <button class="btn btn-sm btn-outline-secondary clone-template" data-template-uid="@item.TemplateUid" data-template-name="@item.Name">Clone</button>
                @if(item.CanEdit){<button class="btn btn-sm @(item.IsActive?"btn-outline-danger":"btn-outline-success") toggle-template" data-template-uid="@item.TemplateUid" data-row-version="@item.RowVersion" data-is-active="@(!item.IsActive).ToString().ToLowerInvariant()">@(item.IsActive?"Deactivate":"Reactivate")</button>}
            </td>
        </tr>}</tbody></table></div>
    }
</div>

<div class="modal fade" id="createTemplateModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">New Template</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="createTemplateForm">
    <div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="Name" maxlength="200" required/></div>
    <div class="row g-3"><div class="col-6"><label class="form-label">Kind</label><select class="form-select" name="TemplateKind"><option>Document</option><option>Encounter</option></select></div><div class="col-6"><label class="form-label">Scope</label><select class="form-select" name="TemplateScope">@if(Model.CanManageClinic){<option>Clinic</option>}<option>Personal</option></select></div></div>
    <div class="mt-3"><label class="form-label">Category</label><input class="form-control" name="Category" maxlength="100" placeholder="Letter, SOAP, Form…" required/></div>
</form><div class="alert alert-danger d-none mt-3" id="createTemplateError"></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="createTemplateButton">Create and Open Draft</button></div></div></div></div>

<div class="modal fade" id="cloneTemplateModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Clone Template</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="cloneTemplateForm"><input type="hidden" name="TemplateUid"/><div class="mb-3"><label class="form-label">New Template Name</label><input class="form-control" name="Name" maxlength="200" required/></div><label class="form-label">Scope</label><select class="form-select" name="TemplateScope">@if(Model.CanManageClinic){<option>Clinic</option>}<option>Personal</option></select></form><div class="alert alert-danger d-none mt-3" id="cloneTemplateError"></div></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="cloneTemplateButton">Clone and Open Draft</button></div></div></div></div>

@section Scripts{<script type="module" src="~/dist/template-administration/index.js" asp-append-version="true"></script>}
