@model MicroEMR.Web.Models.PatientDocuments.PatientDocumentDetailsResponse

@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = Model.DocumentType;
    Layout = "_AppLayout";
    var isDraft = string.Equals(Model.Status, "Draft", StringComparison.OrdinalIgnoreCase);
    var showEditor = !ViewData.ModelState.IsValid || (isDraft && Model.IsStructured);
}

<div class="content-panel">
    <div class="content-panel-header">
        <div>
            <h3 id="documentHeading">@Model.Title</h3>
            <p id="documentSubtitle">@Model.DocumentType</p>
        </div>

        <div class="d-flex gap-2">
            @if (isDraft)
            {
                <button type="button" class="btn btn-primary @(showEditor ? "d-none" : "")" id="editDocumentButton">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </button>
            }
            <a asp-controller="Patients"
               asp-action="Details"
               asp-route-patientUid="@Model.PatientUid"
               asp-route-tab="documents"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Patient Chart
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success mt-3" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-warning mt-3" role="alert">@errorMessage</div>
    }

    <div id="documentReadView" class="row g-4 mt-1 @(showEditor ? "d-none" : "")">
        <div class="col-12 col-lg-4">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-3">Document</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@Model.DocumentType</dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        @if (isDraft)
                        {
                            <span class="badge text-bg-warning">Draft</span>
                        }
                        else if (string.Equals(Model.Status, "Signed", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge text-bg-success">Signed</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@Model.Status</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>

                    <dt class="col-sm-5">Created by</dt>
                    <dd class="col-sm-7">@(Model.CreatedByDisplayName ?? "Unknown")</dd>

                    @if (Model.IsStructured)
                    {
                        <dt class="col-sm-5">Template</dt>
                        <dd class="col-sm-7">@(Model.TemplateName ?? "Document template") <span class="text-body-secondary">v@Model.TemplateVersionNumber</span></dd>
                    }
                </dl>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="border rounded-3 p-3 h-100">
                <h5 class="mb-3">Content</h5>
                @* Keep document content encoded until sanitized rich HTML rendering exists. *@
                <pre class="mb-0 p-3 bg-light border rounded-3 text-wrap">@Model.Content</pre>
            </div>
        </div>
    </div>

    @if (isDraft)
    {
        <form asp-action="UpdateDraft"
              asp-route-documentUid="@Model.DocumentUid"
              method="post"
              id="documentEditForm"
              data-structured="@Model.IsStructured.ToString().ToLowerInvariant()"
              class="@(showEditor ? "" : "d-none") mt-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
            <input type="hidden" name="ContentRowVersion" value="@Model.ContentRowVersion" />
            @if (Model.IsStructured)
            {
                <input type="hidden" name="StructuredDataJson" id="StructuredDataJson" value="@Model.StructuredDataJson" />
            }

            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <label for="editDocumentTitle" class="form-label">Title</label>
                    <input id="editDocumentTitle"
                           name="Title"
                           value="@Model.Title"
                           class="form-control"
                           maxlength="250"
                           required />
                </div>
                <div class="col-12 col-lg-4">
                    <label for="editDocumentType" class="form-label">Document Type</label>
                    <input id="editDocumentType"
                           name="DocumentType"
                           value="@Model.DocumentType"
                           class="form-control"
                           maxlength="100"
                           required />
                </div>
                @if (Model.IsStructured && Model.TemplateDefinition is not null)
                {
                    <div class="col-12"><partial name="_TemplateRuntimeForm" model="Model" /></div>
                }
                else
                {
                    <div class="col-12">
                        <label for="editDocumentContent" class="form-label">Content</label>
                        <textarea id="editDocumentContent" name="Content" class="form-control font-monospace" rows="18">@Model.Content</textarea>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
                <button type="button" class="btn btn-outline-secondary" id="cancelDocumentEditButton">Cancel</button>
                <button type="submit" class="btn btn-primary" id="saveDocumentButton">
                    <i class="bi bi-save me-1"></i>
                    Save
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    @if (Model.IsStructured)
    {
        <script type="module" src="~/dist/patient-documents/runtime.js" asp-append-version="true"></script>
    }
    @if (isDraft)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const readView = document.getElementById("documentReadView");
                const editForm = document.getElementById("documentEditForm");
                const editButton = document.getElementById("editDocumentButton");
                const cancelButton = document.getElementById("cancelDocumentEditButton");
                const saveButton = document.getElementById("saveDocumentButton");

                editButton?.addEventListener("click", function () {
                    readView?.classList.add("d-none");
                    editForm?.classList.remove("d-none");
                    editButton.classList.add("d-none");
                    document.getElementById("editDocumentTitle")?.focus();
                });

                cancelButton?.addEventListener("click", function () {
                    editForm?.reset();
                    editForm?.classList.add("d-none");
                    readView?.classList.remove("d-none");
                    editButton?.classList.remove("d-none");
                });

                editForm?.addEventListener("submit", function () {
                    if (!editForm.checkValidity() || !saveButton) return;
                    saveButton.disabled = true;
                    saveButton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...';
                });
            });
        </script>
    }
}
