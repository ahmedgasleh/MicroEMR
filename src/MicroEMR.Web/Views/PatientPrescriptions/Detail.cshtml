@model MicroEMR.Web.Models.PrescriptionDetailViewModel
@{ViewData["Title"]="Prescription detail";ViewData["Subtitle"]="Prescription";Layout="_AppLayout";var rx=Model.Prescription;}
<div class="content-panel">
 <div class="content-panel-header">
  <div><h3>Prescription detail</h3><p>Recorded prescription</p></div>
  <a class="btn btn-outline-secondary" asp-controller="Patients" asp-action="Details" asp-route-patientUid="@rx.PatientUid" asp-route-tab="medications"><i class="bi bi-arrow-left me-1"></i>Back to prescriptions</a>
 </div>
 <div class="mt-4">
 <section class="mb-3 text-break" data-dispensing-location-reference-detail><h4 class="h6">Dispensing location reference</h4>
 @if(rx.DispensingLocationReference is {} dispensingLocation){
  <dl><dt>Dispensing location system / namespace</dt><dd>@dispensingLocation.System</dd><dt>Dispensing location identifier</dt><dd>@dispensingLocation.Identifier</dd></dl>
 }else{<p>Not recorded</p>}
 @if(rx.DispensingLocationDirectoryUid.HasValue){<p class="small text-muted">Tenant-local directory selection was checked when saved. Current directory details may differ.</p>}
 else if(rx.DispensingLocationReference is not null){<p class="small text-muted">Manual or inherited reference: unresolved / unverified.</p>}
 <p class="small text-muted">Facility name and address are independently recorded values. No external identity verification or current directory match is implied.</p></section>
 <section class="mb-3 text-break" data-protocol-reference-detail><h4 class="h6">Protocol reference</h4>
 @if(rx.ProtocolReference is {} protocol){
  <dl><dt>Protocol system / namespace</dt><dd>@protocol.System</dd><dt>Protocol identifier</dt><dd>@protocol.Identifier</dd></dl>
 }else{<p>Not recorded</p>}
 <p class="small text-muted">User-supplied reference; approval, clinical validity and currency are not externally validated.</p></section>
 <section class="mb-3 text-break" data-reason-coding-detail><h4 class="h6">Coded reason</h4>
 @if(rx.ReasonCoding is {} reason){
  <dl><dt>Coding System</dt><dd>@reason.System</dd><dt>Code</dt><dd>@reason.Code</dd>
  @if(reason.Version is not null){<dt>Version</dt><dd>@reason.Version</dd>}
  @if(reason.Display is not null){<dt>Display</dt><dd>@reason.Display</dd>}</dl>
 }else{<p>Not recorded</p>}
 <p class="small text-muted">Manually supplied; terminology membership and clinical suitability are not verified.</p></section>
 <p><strong>Target Dispensing Facility Address:</strong><span class="d-block text-break" style="white-space: pre-wrap; overflow-wrap: anywhere;">@(rx.TargetDispensingFacilityAddress ?? "Not recorded")</span></p><p class="small text-muted">Address as supplied; facility identity and address completeness are not verified.</p>
 <p class="text-break"><strong>Target Dispensing Facility Name:</strong> @(rx.TargetDispensingFacilityName ?? "Not recorded")</p><p class="small text-muted">Name as supplied; facility identity is not verified.</p><p><strong>Earliest expected pickup:</strong> @(rx.EarliestPickup?.Display ?? "Not recorded")</p><p class="small text-muted">Expected pickup only; this does not confirm pharmacy readiness.</p><p><strong>Paper copy required before dispensing:</strong> @(rx.PaperCopyRequiredBeforeDispense is true ? "Yes" : "Not recorded")</p>
 <p><strong>Minimum dispense interval:</strong> @(rx.MinimumDispenseIntervalDays is {} days ? $"{days} whole days" : "Not recorded")</p>
 <p><strong>@rx.ProductDisplayText</strong> <span class="badge text-bg-secondary">@rx.Status</span></p>
 <p><strong>Product/Brand Name:</strong> @rx.ProductName</p>
 <p><strong>Drug Description:</strong> @rx.ProductDisplayText</p>
 <p><strong>Substitution prohibited:</strong> @(rx.SubstitutionProhibited is null ? "Not recorded" : rx.SubstitutionProhibited.Value ? "Yes" : "No")</p>
 <p><strong>Treatment type:</strong> @(rx.TreatmentType??"Not recorded")</p>
 <p><strong>Prescriber first name:</strong> @(rx.PrescriberFirstNameSnapshot??"Not recorded") <strong>Last name:</strong> @(rx.PrescriberLastNameSnapshot??"Not recorded") <strong>OHIP Billing Number:</strong> @(rx.PrescriberOhipSnapshot??"Not recorded")</p>
 <p>@rx.Directions</p>
 @if(Model.PrivateNote is {} note)
 {
  <section class="card my-3 d-print-none" aria-label="Private prescription note">
   <div class="card-body"><h2 class="h5">Private prescription note</h2>
    <p class="text-muted small">Internal clinical detail. Excluded from prescription and CPP printing.</p>
    <div class="text-break" style="white-space:pre-wrap">@(note.NoteText??"Not recorded")</div>
    @if(note.CanEdit){<a class="btn btn-outline-secondary mt-3" asp-action="Edit" asp-route-patientUid="@rx.PatientUid" asp-route-prescriptionUid="@rx.PrescriptionUid">Edit draft</a>}
    else{<p class="small text-muted mt-3">Read only</p>}
    @if(Model.History.Count>0)
    {
     <details class="mt-3"><summary>Private note history</summary>
      @foreach(var revision in Model.History)
      {
       <div class="border-top py-2"><span class="small text-muted">Revision @revision.RevisionNumber · @revision.Operation · clinical user @revision.ActorUserId · @revision.CreatedAtUtc.ToString("u")</span><div class="text-break" style="white-space:pre-wrap">@(revision.NoteText??"Cleared / not recorded")</div></div>
      }
     </details>
    }
   </div>
  </section>
 }
 </div>
</div>
