<div class="col-12">
 <fieldset class="border rounded p-3" data-drug-catalog data-search-url="@Url.Action("Lookup","DrugCatalog")" data-detail-url="@Url.Action("Detail","DrugCatalog")">
  <legend class="float-none w-auto fs-6 px-1">Find a drug (development catalogue)</legend>
  <p class="form-text">Imported Health Canada DPD-format data. Commercially licensed COTS eligibility remains unresolved. Review every selection; no dosing or substitution recommendation is provided.</p>
  <label class="form-label w-100">Drug/brand name, ingredient or DIN<input type="search" maxlength="200" data-drug-query class="form-control" /></label>
  <button type="button" data-drug-search class="btn btn-outline-primary btn-sm">Search drugs</button>
  <p data-drug-status role="status" aria-live="polite" class="form-text">Manual entry remains available. No product selected.</p>
  <div data-drug-results></div>
  <div data-drug-preview hidden class="border rounded p-2 mt-2">
   <p data-drug-details class="text-break" style="white-space:pre-wrap"></p>
   <p data-drug-mismatch hidden class="alert alert-warning">This selection differs from entered drug values. Confirm replacement only if intended.</p>
   <p class="form-text">Combination, denominator and unsupported strengths remain in source details; numeric strength fields may be blank. Prescribed route, dose and instructions remain independent entered values.</p>
   <label class="form-check-label"><input type="checkbox" data-drug-confirm class="form-check-input" /> I confirm replacing the drug name, description, identifier, strength/unit and form with this selection.</label>
   <div class="mt-2"><button type="button" data-drug-apply class="btn btn-primary btn-sm" disabled>Use this drug</button> <button type="button" data-drug-cancel class="btn btn-outline-secondary btn-sm">Cancel selection</button></div>
  </div>
  <input type="hidden" name="DrugCatalogSelectionUid" /><input type="hidden" name="DrugCatalogSelectionVersion" />
 </fieldset>
 <script type="module" src="~/dist/patients/prescription-drug-catalog.js" asp-append-version="true"></script>
</div>
