@using MicroEMR.Application.PatientPrescriptions
@model PrescriptionDraftRequest
@inject MicroEMR.Web.Authorization.IWebPermissionService PrivatePermissions
@if (!ViewData.ModelState.IsValid)
{
 <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}
<fieldset class="border rounded p-3 my-3" data-pickup-editor data-pickup-operation="@ViewData["PickupOperation"]" data-options-url="@Url.Action("PickupOptions", "PatientPrescriptions")" data-pickup="@System.Text.Json.JsonSerializer.Serialize(Model.EarliestPickup)">
 <legend class="float-none w-auto fs-6 px-1">Earliest expected pickup (optional)</legend>
 <p class="form-text">Expected pickup only. Uses the clinical timezone shown below; does not confirm pharmacy readiness.</p>
 <input type="hidden" name="pickupOperation" value="preserve" />
 <input type="hidden" name="pickupZone" />
 <div class="row g-2">
  <div class="col-md-3"><label class="form-label">Precision<select name="pickupPrecision" class="form-select"><option value="">Not recorded</option><option value="Day">Date only</option><option value="Minute">Date and time</option></select></label></div>
  <div class="col-md-3"><label class="form-label">Pickup date<input type="date" name="pickupDate" class="form-control" /></label></div>
  <div class="col-md-2"><label class="form-label">Local time<input type="time" name="pickupTime" step="60" class="form-control" /></label></div>
  <div class="col-md-4"><label class="form-label">UTC offset<select name="pickupOffset" class="form-select"><option value="">Select offset</option></select></label></div>
 </div>
 <p class="small mt-2 mb-1" data-pickup-zone aria-live="polite"></p>
 <p class="text-danger" data-pickup-error role="alert"></p>
 <button type="button" class="btn btn-sm btn-outline-secondary" data-pickup-clear>Clear pickup</button>
 <span asp-validation-for="EarliestPickup" class="text-danger"></span>
</fieldset>
<script type="module" src="~/dist/patients/prescription-pickup.js" asp-append-version="true"></script>
<div class="row g-3">
 <div class="col-md-6"><label asp-for="OrderFields.PaperCopyRequiredBeforeDispense" class="form-label">Paper copy required before dispensing</label><select asp-for="OrderFields.PaperCopyRequiredBeforeDispense" class="form-select" aria-describedby="paper-requirement-help"><option value="">Not recorded</option><option value="true">Yes</option></select><div id="paper-requirement-help" class="form-text">Explicit paper-view requirement only. Not recorded makes no statement of electronic authority.</div><span asp-validation-for="OrderFields.PaperCopyRequiredBeforeDispense" class="text-danger" role="alert"></span></div>
 <div class="col-md-6"><label asp-for="OrderFields.MinimumDispenseIntervalDays" class="form-label">Minimum dispense interval (whole days)</label><input asp-for="OrderFields.MinimumDispenseIntervalDays" class="form-control" type="number" min="1" max="2147483647" step="1" aria-describedby="dispense-interval-help"/><div id="dispense-interval-help" class="form-text">Optional minimum time between dispenses, independent of days' supply and repeats. Whole days; technical storage limit 2,147,483,647.</div><span asp-validation-for="OrderFields.MinimumDispenseIntervalDays" class="text-danger" role="alert"></span></div>
 @if (ViewData["CanEditPrivateNote"] is not false && await PrivatePermissions.HasAsync(MicroEMR.Application.AccessProfiles.PermissionKeys.PrescriptionsViewPrivateNotes, Context.RequestAborted))
 {
  <div class="col-12 d-print-none" data-private-note-editor><label asp-for="PrivateNote" class="form-label">Private Note (optional)</label><textarea asp-for="PrivateNote" class="form-control" maxlength="1000" rows="3"></textarea><div class="form-text">Internal prescription detail only. Clear this field and save to remove the current text; history is retained.</div><span asp-validation-for="PrivateNote" class="text-danger"></span></div>
 }
 <div class="col-md-6"><label asp-for="GenericName" class="form-label">Generic Name (optional)</label><input asp-for="GenericName" class="form-control" maxlength="300" aria-describedby="generic-name-help"/><div id="generic-name-help" class="form-text">Record the generic name separately from the product/brand name. Leave blank if unknown.</div><span asp-validation-for="GenericName" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="MedicationForm" class="form-label">Medication form (optional)</label><input asp-for="MedicationForm" class="form-control" maxlength="100"/><span asp-validation-for="MedicationForm" class="text-danger"></span></div>
 <div class="col-12"><label asp-for="NotesToPharmacist" class="form-label">Notes to pharmacist (optional)</label><textarea asp-for="NotesToPharmacist" class="form-control" maxlength="1000" rows="3"></textarea><span asp-validation-for="NotesToPharmacist" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="OrderFields.SubstitutionProhibited" class="form-label">Substitution prohibited (optional)</label><select asp-for="OrderFields.SubstitutionProhibited" class="form-select"><option value="">Not recorded</option><option value="true">Yes</option><option value="false">No</option></select></div><div class="col-md-6"><label asp-for="OrderFields.TreatmentType" class="form-label">Treatment type (optional)</label><input asp-for="OrderFields.TreatmentType" class="form-control" maxlength="300"/><span asp-validation-for="OrderFields.TreatmentType" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ProductName" class="form-label">Product/Brand Name</label><input asp-for="ProductName" class="form-control"/><span asp-validation-for="ProductName" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="ProductDisplayText" class="form-label">Drug Description / Product display</label><input asp-for="ProductDisplayText" class="form-control" maxlength="300" aria-describedby="drug-description-help"/><div id="drug-description-help" class="form-text">Complete product or custom/compound description. Single line, up to 300 UTF-16 code units. Keep essential ingredients and preparation text; do not abbreviate to fit.</div><span asp-validation-for="ProductDisplayText" class="text-danger"></span></div>
 <div class="col-md-6"><label asp-for="ProductIdentifierNamespace" class="form-label">Identifier namespace (optional)</label><input asp-for="ProductIdentifierNamespace" class="form-control"/></div><div class="col-md-6"><label asp-for="ProductIdentifierValue" class="form-label">Identifier value (optional)</label><input asp-for="ProductIdentifierValue" class="form-control"/></div>
 <div class="col-md-3"><label asp-for="StrengthValue" class="form-label">Strength</label><input asp-for="StrengthValue" class="form-control"/></div><div class="col-md-3"><label asp-for="StrengthUnit" class="form-label">Strength unit</label><input asp-for="StrengthUnit" class="form-control"/></div>
 <div class="col-md-3"><label asp-for="DoseAmount" class="form-label">Dose</label><input asp-for="DoseAmount" class="form-control"/></div><div class="col-md-3"><label asp-for="DoseUnit" class="form-label">Dose unit</label><input asp-for="DoseUnit" class="form-control"/></div>
 <div class="col-md-4"><label asp-for="Route" class="form-label"></label><input asp-for="Route" class="form-control" maxlength="100"/></div><div class="col-md-4"><label asp-for="FrequencyCode" class="form-label">Frequency</label><select asp-for="FrequencyCode" class="form-select"><option value="">Select frequency</option>@foreach(var x in PrescriptionFrequencies.Values){<option value="@x.Key">@x.Value</option>}</select></div><div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Prn" class="form-check-input"/><label asp-for="Prn" class="form-check-label">As needed (PRN)</label></div></div>
 <div class="col-12"><label asp-for="Directions" class="form-label">Directions (required; include the actual schedule when frequency is Other)</label><textarea asp-for="Directions" rows="3" class="form-control"></textarea><span asp-validation-for="Directions" class="text-danger"></span></div>
 <div class="col-12"><h2 class="h6 mb-0">Initial dispense</h2></div>
 <div class="col-md-4"><label asp-for="Quantity" class="form-label">Initial quantity</label><input asp-for="Quantity" type="number" min="0.001" step="0.001" class="form-control"/><span asp-validation-for="Quantity" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="QuantityUnit" class="form-label">Initial quantity unit</label><input asp-for="QuantityUnit" class="form-control"/><span asp-validation-for="QuantityUnit" class="text-danger"></span></div>
 <div class="col-md-4"><label asp-for="InitialDaysSupply" class="form-label">Initial days' supply (optional)</label><input asp-for="InitialDaysSupply" type="number" min="1" step="1" class="form-control"/><span asp-validation-for="InitialDaysSupply" class="text-danger"></span></div>
 <div class="col-12"><h2 class="h6 mb-1">Refill instructions</h2><p class="text-muted small mb-0">Refills follow the initial dispense. Leave unspecified values blank. Refill quantity and days' supply may differ from the initial dispense.</p></div>
 <div class="col-md-3"><label asp-for="AuthorizedRepeats" class="form-label">Number of authorized refills</label><input asp-for="AuthorizedRepeats" type="number" min="0" step="1" class="form-control"/><span asp-validation-for="AuthorizedRepeats" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="RefillQuantity" class="form-label">Refill quantity (optional)</label><input asp-for="RefillQuantity" type="number" min="0.001" step="0.001" class="form-control"/><span asp-validation-for="RefillQuantity" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="RefillQuantityUnit" class="form-label">Refill quantity unit</label><input asp-for="RefillQuantityUnit" class="form-control"/><span asp-validation-for="RefillQuantityUnit" class="text-danger"></span></div>
 <div class="col-md-3"><label asp-for="RefillDaysSupply" class="form-label">Refill days' supply (optional)</label><input asp-for="RefillDaysSupply" type="number" min="1" step="1" class="form-control"/><span asp-validation-for="RefillDaysSupply" class="text-danger"></span></div>
 @{
  var writtenDate = Model.DateFields?.WrittenDate ?? PrescriptionDateValue.From(Model.PrescribedDate);
  var startDate = Model.DateFields?.StartDate ?? PrescriptionDateValue.From(Model.StartDate);
 }
 @foreach (var date in new[] { ("WrittenDate", "Written date", writtenDate, false), ("StartDate", "Start date (optional)", startDate, true) })
 {
  var dateId = "rxdate-" + Guid.NewGuid().ToString("N");
  <fieldset class="col-md-6" data-prescription-date="@date.Item1">
   <legend class="form-label fs-6">@date.Item2</legend>
   <label class="form-label small" for="@(dateId)-precision">Precision</label>
   <select class="form-select mb-2" name="DateFields.@(date.Item1).Precision" id="@(dateId)-precision">
    @foreach(var precision in date.Item4 ? new[]{"Unknown","Year","Month","Day"} : new[]{"Year","Month","Day"})
    { <option value="@precision" selected="@(date.Item3.Precision==precision)">@(precision=="Unknown"?"Not recorded":precision=="Year"?"Year only":precision=="Month"?"Year and month":"Full date")</option> }
   </select>
   <div class="row g-2">
    @foreach(var part in new[]{("Year",date.Item3.Year,1,9999),("Month",date.Item3.Month,1,12),("Day",date.Item3.Day,1,31)})
    {
     <div class="col" data-date-control><label class="form-label small" for="@(dateId)-@(part.Item1)">@part.Item1</label><input class="form-control" type="number" step="1" min="@part.Item3" max="@part.Item4" value="@part.Item2" id="@(dateId)-@(part.Item1)" name="DateFields.@(date.Item1).@(part.Item1)" data-date-part="@part.Item1"/></div>
    }
   </div>
  </fieldset>
 }
 <div class="col-md-6"><label asp-for="Indication" class="form-label">Indication (optional)</label><input asp-for="Indication" class="form-control"/></div>
</div><input asp-for="RowVersion" type="hidden"/>

<script type="module" src="~/dist/patients/prescription-dates.js" asp-append-version="true"></script>
