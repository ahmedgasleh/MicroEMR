@model MicroEMR.Web.Controllers.ProviderIndexViewModel
@{ViewData["Title"]="Providers";ViewData["Subtitle"]="Manage tenant clinical provider identities and user associations.";Layout="_AppLayout";}
<div class="content-panel">
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Providers</h1><p class="text-body-secondary mb-0">Manage tenant clinical provider identities and optional user associations.</p></div>@if(Model.CanManage){<a asp-action="Add" class="btn btn-primary">Add Provider</a>}</div>
@if(TempData["SuccessMessage"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["ErrorMessage"] is string err){<div class="alert alert-danger">@err</div>}
<div class="btn-group mb-3" role="group" aria-label="Provider status">@foreach(var s in new[]{"Active","Inactive","All"}){<a asp-action="Index" asp-route-status="@s" class="btn @(Model.Status==s?"btn-primary":"btn-outline-primary")">@s</a>}</div>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Name</th><th>Provider Type</th><th>Specialty</th><th>Billing Number</th><th>Linked User</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var p in Model.Providers){<tr><td>@p.DisplayName</td><td>@p.ProviderType</td><td>@(p.Specialty??"—")</td><td>@(p.BillingNumber??"—")</td><td>@(p.LinkedApplicationUserDisplayName??"Unlinked")</td><td><span class="badge @(p.IsActive?"text-bg-success":"text-bg-secondary")">@(p.IsActive?"Active":"Inactive")</span></td><td>@if(Model.CanManage){<div class="d-flex gap-1 flex-wrap"><a asp-action="Edit" asp-route-uid="@p.ProviderUid" class="btn btn-sm btn-outline-primary">Edit</a>@if(p.LinkedApplicationUserUid.HasValue){<form asp-action="Unlink" method="post"><input type="hidden" name="uid" value="@p.ProviderUid"/><input type="hidden" name="applicationUserUid" value="@p.LinkedApplicationUserUid"/><input type="hidden" name="rowVersion" value="@p.RowVersion"/><button class="btn btn-sm btn-outline-warning">Unlink</button></form>}else if(p.IsActive){<a asp-action="Link" asp-route-uid="@p.ProviderUid" class="btn btn-sm btn-outline-secondary">Link User</a>}<form asp-action="@(p.IsActive?"Deactivate":"Reactivate")" method="post"><input type="hidden" name="uid" value="@p.ProviderUid"/><input type="hidden" name="rowVersion" value="@p.RowVersion"/><button class="btn btn-sm @(p.IsActive?"btn-outline-danger":"btn-outline-success")">@(p.IsActive?"Deactivate":"Reactivate")</button></form></div>}else{<span class="text-body-secondary">View only</span>}</td></tr>}
@if(Model.Providers.Count==0){<tr><td colspan="7" class="text-center text-body-secondary py-4">No @Model.Status.ToLowerInvariant() providers.</td></tr>}
</tbody></table></div>
</div>
