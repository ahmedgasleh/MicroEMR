@model MicroEMR.Web.Controllers.ProviderLinkViewModel
@{ViewData["Title"]="Link Provider User";}<h1 class="h3">Link User</h1><p>Provider: <strong>@Model.Provider.DisplayName</strong></p><form asp-action="Link" method="post" class="row g-3"><input type="hidden" name="uid" value="@Model.Provider.ProviderUid"/><input type="hidden" name="rowVersion" value="@Model.Provider.RowVersion"/><div class="col-md-7"><label for="applicationUserUid" class="form-label">Eligible Application User</label><select id="applicationUserUid" name="applicationUserUid" class="form-select" required><option value="">Select a user</option>@foreach(var u in Model.Users){<option value="@u.ApplicationUserUid">@u.DisplayName @(string.IsNullOrWhiteSpace(u.Email)?"":$"({u.Email})")</option>}</select></div><div class="col-12"><button class="btn btn-primary">Link User</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
