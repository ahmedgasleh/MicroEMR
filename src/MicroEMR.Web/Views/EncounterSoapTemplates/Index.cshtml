@using System.Text.Json
@model MicroEMR.Web.Models.EncounterSoapTemplates.EncounterSoapTemplateIndexViewModel
@{ViewData["Title"]="Encounter SOAP Templates";Layout="_AppLayout";}
<div class="content-panel"><div class="content-panel-header"><div><h3>Encounter SOAP Templates</h3><p>Manage reusable SOAP note content.</p></div><button id="addSoapTemplate" class="btn btn-primary">Add Template</button></div>@Html.AntiForgeryToken()
<div class="d-flex justify-content-end mb-3"><select id="soapTemplateStatus" class="form-select w-auto">@foreach(var x in new[]{"Active","Inactive","All"}){<option selected="@(x==Model.Status)">@x</option>}</select></div>
@if(Model.Templates.Count==0){<div class="text-center py-5 text-body-secondary">No @(Model.Status.ToLowerInvariant()) encounter SOAP templates.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Encounter Type</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>@foreach(var x in Model.Templates){<tr><td>@x.TemplateName</td><td>@(x.EncounterType??"Any")</td><td><span class="badge @(x.IsActive?"text-bg-success":"text-bg-secondary")">@(x.IsActive?"Active":"Inactive")</span></td><td>@((x.UpdatedAt??x.CreatedAt).ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</td><td class="text-end"><button class="btn btn-sm btn-outline-primary edit-soap-template" data-uid="@x.EncounterSoapTemplateUid">Edit</button> <button class="btn btn-sm btn-outline-secondary toggle-soap-template" data-uid="@x.EncounterSoapTemplateUid" data-active="@(!x.IsActive).ToString().ToLowerInvariant()">@(x.IsActive?"Deactivate":"Reactivate")</button></td></tr>}</tbody></table></div>}</div>
<div class="modal fade" id="soapTemplateModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">SOAP Template</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="soapTemplateForm"><input type="hidden" name="EncounterSoapTemplateUid"/><div class="mb-2"><label class="form-label">Template Name</label><input name="TemplateName" maxlength="200" required class="form-control"/></div><div class="mb-2"><label class="form-label">Encounter Type</label><input name="EncounterType" maxlength="100" class="form-control"/></div>@foreach(var s in new[]{"Subjective","Objective","Assessment","Plan"}){<div class="mb-2"><label class="form-label">@s Template</label><textarea name="@(s)Template" rows="3" class="form-control"></textarea></div>}</form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button id="saveSoapTemplate" class="btn btn-primary">Save</button></div></div></div></div>
<script id="soapTemplateData" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Templates,new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase}))</script>
@section Scripts{<script type="module" src="~/dist/encounter-soap-templates/management.js" asp-append-version="true"></script>}
