@model TenantSelectionViewModel

@{
    ViewData["Title"] = "Select a clinic";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <main class="container d-flex align-items-center justify-content-center py-5">
        <section class="auth-card w-100" style="max-width: 640px" aria-labelledby="selectTenantTitle">
            <header class="auth-card-header">
                <h1 class="auth-title" id="selectTenantTitle">Select a clinic</h1>
                <p class="auth-subtitle">Your account has access to more than one clinic. Choose the clinic you want to open.</p>
            </header>

            <form asp-controller="Account" asp-action="SelectTenant" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input asp-for="SelectionId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <fieldset class="d-grid gap-3 mb-4">
                    <legend class="visually-hidden">Available clinics</legend>
                    @foreach (var tenant in Model.Tenants)
                    {
                        var optionId = $"tenant-{tenant.TenantUid:D}";
                        <label for="@optionId" class="border rounded-3 p-3 d-flex gap-3 align-items-start">
                            <input asp-for="SelectedTenantUid" id="@optionId" type="radio" value="@tenant.TenantUid" class="form-check-input mt-1" />
                            <span>
                                <strong class="d-block">@tenant.DisplayName</strong>
                                <small class="text-muted">@tenant.TenantKey</small>
                            </span>
                        </label>
                    }
                </fieldset>
                <span asp-validation-for="SelectedTenantUid" class="text-danger validation-message d-block mb-3"></span>
                <button type="submit" class="btn btn-primary auth-submit">Continue</button>
            </form>
        </section>
    </main>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
