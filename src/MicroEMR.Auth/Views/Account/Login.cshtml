@model LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-brand-panel" aria-labelledby="microemrBrandTitle">
            <div class="auth-brand-content">
                <div class="auth-brand-lockup">
                    <span class="auth-logo-mark" aria-hidden="true">+</span>
                    <span class="auth-brand-name" id="microemrBrandTitle">MicroEMR</span>
                </div>

                <div class="auth-brand-message">
                    <p class="auth-brand-eyebrow">Clinical workflow, simplified.</p>
                    <h1>Care starts with a clear workspace.</h1>
                    <p>
                        Secure access to the patient information and clinical tools
                        your team needs throughout the day.
                    </p>
                </div>

                <div class="auth-brand-assurance">
                    <span class="auth-shield" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 3 5 6v5c0 4.5 2.9 8.5 7 10 4.1-1.5 7-5.5 7-10V6l-7-3Z" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </span>
                    <span>Secure clinical workspace</span>
                </div>
            </div>
        </section>

        <main class="auth-form-panel">
            <div class="auth-card">
                <div class="auth-card-brand" aria-hidden="true">
                    <span class="auth-logo-mark auth-logo-mark--small">+</span>
                    <span>MicroEMR</span>
                </div>

                <header class="auth-card-header">
                    <h2 class="auth-title">Sign in to MicroEMR</h2>
                    <p class="auth-subtitle">Continue to your clinical workspace.</p>
                </header>

                <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger auth-validation"
                         role="alert">
                    </div>

                    <div class="auth-field">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username"
                               class="form-control auth-input"
                               autocomplete="username"
                               placeholder="Enter your username or email"
                               autofocus />
                        <span asp-validation-for="Username" class="text-danger validation-message"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="password-container">
                            <input asp-for="Password"
                                   class="form-control auth-input"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" />
                            <button type="button"
                                    class="password-toggle"
                                    id="btnTogglePassword"
                                    aria-label="Show password"
                                    aria-pressed="false">
                                <svg class="password-toggle__show" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="password-toggle__hide" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="m3 3 18 18" />
                                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.1 3.1M6.6 6.6C3.6 8.5 2 12 2 12s3.5 7 10 7a9.8 9.8 0 0 0 4.1-.9M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger validation-message"></span>
                    </div>

                    <button type="submit" class="btn btn-primary auth-submit" id="btnSignIn">
                        <span class="auth-submit__label">Sign In</span>
                        <span class="auth-submit__progress" aria-hidden="true">
                            <span class="spinner-border spinner-border-sm"></span>
                            Signing in...
                        </span>
                    </button>
                </form>

                <footer class="auth-footer-note">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="5" y="10" width="14" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <span>Protected clinical access</span>
                </footer>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/dist/login-page.js" asp-append-version="true"></script>
}
